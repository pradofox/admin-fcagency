---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/district', label: 'Overview' },
  { href: '/district/miembros', label: 'Miembros' },
  { href: '/district/planes', label: 'Planes' },
  { href: '/district/estudio', label: 'Estudio foto/video' },
  { href: '/district/cowork', label: 'Cowork' },
  { href: '/district/inventario', label: 'Inventario' }
];
function isActive(href: string) {
  if (href === '/district') return currentPath === href || currentPath === '/district/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<nav class="filters" style="margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:14px">
  {links.map((l) => (
    <a href={l.href} class={`filter-chip ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
  ))}
</nav>
