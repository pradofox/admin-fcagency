---
interface Modelo {
  id?: string;
  nombre?: string;
  email?: string | null;
  whatsapp?: string | null;
  instagram?: string | null;
  cumpleanos?: string | null;
  genero?: string | null;
  estatura_cm?: number | null;
  busto_cm?: number | null;
  cintura_cm?: number | null;
  cadera_cm?: number | null;
  calzado_mx?: number | null;
  cabello?: string | null;
  ojos?: string | null;
  ciudad?: string | null;
  talentos?: string | null;
  notas?: string | null;
  estado?: string;
  polas?: number | null;
  book?: number | null;
  videocasting?: number | null;
  drive_folder?: string | null;
  material_actualizado_en?: string | null;
  material_notas?: string | null;
}

interface Props {
  modelo?: Modelo;
  action: string;
  method?: 'POST' | 'PATCH';
  submitLabel: string;
}

import { calcularEdad } from '../../lib/fechas';

const { modelo = {}, action, method = 'POST', submitLabel } = Astro.props;
const isEdit = method === 'PATCH';
const edadInicial = calcularEdad(modelo.cumpleanos);
---

<form method={isEdit ? 'POST' : 'POST'} action={action} id="modelo-form">
  {isEdit && <input type="hidden" name="_method" value="PATCH" />}

  <label class="label">Nombre completo *</label>
  <input class="input" name="nombre" value={modelo.nombre ?? ''} required />

  <div class="row">
    <div class="col">
      <label class="label">Email</label>
      <input class="input" name="email" type="email" value={modelo.email ?? ''} />
    </div>
    <div class="col">
      <label class="label">WhatsApp</label>
      <input class="input" name="whatsapp" value={modelo.whatsapp ?? ''} />
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Instagram</label>
      <input class="input" name="instagram" value={modelo.instagram ?? ''} placeholder="usuario" />
    </div>
    <div class="col">
      <label class="label">
        Cumpleaños
        <span id="edad-badge" class="text-muted" style={`font-weight:400;margin-left:8px${edadInicial == null ? ';display:none' : ''}`}>
          {edadInicial != null ? `· ${edadInicial} años` : ''}
        </span>
      </label>
      <input class="input" name="cumpleanos" id="inp-cumpleanos" value={modelo.cumpleanos ?? ''} placeholder="DD/MM/AAAA · ej 19/01/1992" autocomplete="off" />
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Género</label>
      <input class="input" name="genero" value={modelo.genero ?? ''} />
    </div>
    <div class="col">
      <label class="label">Ciudad</label>
      <input class="input" name="ciudad" value={modelo.ciudad ?? ''} />
    </div>
  </div>

  <label class="label" style="margin-top:28px">Medidas</label>
  <div class="row">
    <div class="col">
      <label class="label">Estatura (cm)</label>
      <input class="input" name="estatura_cm" type="number" value={modelo.estatura_cm ?? ''} />
    </div>
    <div class="col">
      <label class="label">Busto (cm)</label>
      <input class="input" name="busto_cm" type="number" value={modelo.busto_cm ?? ''} />
    </div>
    <div class="col">
      <label class="label">Cintura (cm)</label>
      <input class="input" name="cintura_cm" type="number" value={modelo.cintura_cm ?? ''} />
    </div>
    <div class="col">
      <label class="label">Cadera (cm)</label>
      <input class="input" name="cadera_cm" type="number" value={modelo.cadera_cm ?? ''} />
    </div>
    <div class="col">
      <label class="label">Calzado MX</label>
      <input class="input" name="calzado_mx" type="number" step="0.5" value={modelo.calzado_mx ?? ''} />
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Cabello</label>
      <input class="input" name="cabello" value={modelo.cabello ?? ''} />
    </div>
    <div class="col">
      <label class="label">Ojos</label>
      <input class="input" name="ojos" value={modelo.ojos ?? ''} />
    </div>
  </div>

  <label class="label">Talentos</label>
  <textarea class="textarea" name="talentos" placeholder="Actuación, baile, deportes, idiomas, habilidades especiales...">{modelo.talentos ?? ''}</textarea>

  <label class="label" style="margin-top:28px">Material / book</label>
  <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:12px">
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
      <input type="checkbox" name="polas" value="1" checked={!!modelo.polas} /> Polas
    </label>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
      <input type="checkbox" name="book" value="1" checked={!!modelo.book} /> Book
    </label>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
      <input type="checkbox" name="videocasting" value="1" checked={!!modelo.videocasting} /> Videocasting
    </label>
  </div>
  <div class="row">
    <div class="col" style="flex:2">
      <label class="label">Carpeta de material (Drive)</label>
      <input class="input" name="drive_folder" value={modelo.drive_folder ?? ''} placeholder="https://drive.google.com/..." />
    </div>
    <div class="col">
      <label class="label">Última actualización de material</label>
      <input class="input" type="date" name="material_actualizado_en" value={modelo.material_actualizado_en ?? ''} />
    </div>
  </div>
  <label class="label">Material pendiente / notas</label>
  <textarea class="textarea" name="material_notas" placeholder="Qué falta subir o actualizar en el book">{modelo.material_notas ?? ''}</textarea>

  <label class="label">Estado</label>
  <select class="select" name="estado">
    {['activo', 'pausa', 'archivado', 'aspirante'].map((e) => (
      <option value={e} selected={(modelo.estado ?? 'activo') === e}>{e}</option>
    ))}
  </select>

  <label class="label">Notas</label>
  <textarea class="textarea" name="notas">{modelo.notas ?? ''}</textarea>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">{submitLabel}</button>
    <a href="/modelos" class="btn">Cancelar</a>
  </div>
</form>

<script is:inline>
  (function () {
    const MESES = {
      enero: 1, febrero: 2, marzo: 3, abril: 4, mayo: 5, junio: 6,
      julio: 7, agosto: 8, septiembre: 9, setiembre: 9, octubre: 10,
      noviembre: 11, diciembre: 12,
    };
    function parse(raw) {
      if (!raw) return null;
      const s = String(raw).trim().toLowerCase();
      if (!s) return null;
      let m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s);
      if (m) return { anio: +m[1], mes: +m[2], dia: +m[3] };
      m = /^(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?$/.exec(s);
      if (m) return { dia: +m[1], mes: +m[2], anio: m[3] ? +m[3] : null };
      m = /^(\d{1,2})\s+(?:de\s+)?([a-záéíóúñ]+)(?:\s+(?:de\s+)?(\d{4}))?/.exec(s);
      if (m && MESES[m[2]]) return { dia: +m[1], mes: MESES[m[2]], anio: m[3] ? +m[3] : null };
      m = /^([a-záéíóúñ]+)\s+(\d{1,2})/.exec(s);
      if (m && MESES[m[1]]) return { dia: +m[2], mes: MESES[m[1]], anio: null };
      return null;
    }
    function edad(raw) {
      const c = parse(raw);
      if (!c || !c.anio) return null;
      const ref = new Date();
      let e = ref.getFullYear() - c.anio;
      const mm = ref.getMonth() + 1, dd = ref.getDate();
      if (mm < c.mes || (mm === c.mes && dd < c.dia)) e--;
      return e >= 0 && e < 120 ? e : null;
    }
    const inp = document.getElementById('inp-cumpleanos');
    const badge = document.getElementById('edad-badge');
    if (inp && badge) {
      inp.addEventListener('input', function () {
        const e = edad(inp.value);
        if (e == null) { badge.style.display = 'none'; badge.textContent = ''; }
        else { badge.style.display = ''; badge.textContent = '· ' + e + ' años'; }
      });
    }
  })();
</script>
