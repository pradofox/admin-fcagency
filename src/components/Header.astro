---
import { getUser, labelPerfil } from '../lib/session';

const { title } = Astro.props as { title?: string };
const user = getUser(Astro);
---

<header class="header">
  <button class="sidebar-toggle" id="btn_sidebar_toggle" aria-label="Abrir menú" type="button">
    <span></span><span></span><span></span>
  </button>
  <div class="header-title">{title ?? ''}</div>
  <div class="header-user">
    {user && <a href="/perfil">{user.nombre} · {labelPerfil(user)}</a>}
    <a href="/logout">Cerrar sesión</a>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('btn_sidebar_toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      document.body.classList.toggle('sidebar-open');
    });
    // Cerrar al hacer click en un link del sidebar
    document.querySelectorAll('.sidebar-link').forEach(function (link) {
      link.addEventListener('click', function () {
        document.body.classList.remove('sidebar-open');
      });
    });
    // Cerrar al click en el overlay
    document.addEventListener('click', function (e) {
      const t = e.target;
      if (t && t.classList && t.classList.contains('sidebar-overlay')) {
        document.body.classList.remove('sidebar-open');
      }
    });
  })();
</script>
