---
interface Marca { id: string; nombre: string }
interface Cliente { id: string; nombre: string }
interface Produccion {
  id?: string;
  titulo?: string;
  cliente_id?: string | null;
  marca_id?: string | null;
  fecha_inicio?: string | null;
  fecha_fin?: string | null;
  hora_inicio?: string | null;
  hora_fin?: string | null;
  ubicacion_mua?: string | null;
  ubicacion_shoot?: string | null;
  estado?: string;
  presupuesto?: number | null;
  notas?: string | null;
  proximo_paso?: string | null;
  fecha_proxima_accion?: string | null;
  material_pendiente?: string | null;
  equipo_involucrado?: string | null;
  links_referencias?: string | null;
  tipo_produccion?: string | null;
}

interface Props {
  produccion?: Produccion;
  marcas: Marca[];
  clientes: Cliente[];
  action: string;
  submitLabel: string;
  isEdit?: boolean;
}

const { produccion = {}, marcas, clientes, action, submitLabel, isEdit = false } = Astro.props;

const TIPOS_PRODUCCION = [
  'Fotografía', 'Video', 'Campaña', 'Editorial', 'E-commerce',
  'Lookbook', 'Evento', 'Booking', 'Fitting', 'Casting', 'Otro'
];
---

<form method="POST" action={action}>
  {isEdit && <input type="hidden" name="_method" value="PATCH" />}

  <label class="label">Título *</label>
  <input class="input" name="titulo" value={produccion.titulo ?? ''} required />

  <div class="row">
    <div class="col">
      <label class="label">Tipo de producción</label>
      <select class="select" name="tipo_produccion">
        <option value="">— sin asignar —</option>
        {TIPOS_PRODUCCION.map((t) => (
          <option value={t} selected={produccion.tipo_produccion === t}>{t}</option>
        ))}
      </select>
    </div>
    <div class="col">
      <label class="label">Estado</label>
      <select class="select" name="estado">
        {['planeacion', 'confirmada', 'en_curso', 'completada', 'cancelada'].map((e) => (
          <option value={e} selected={(produccion.estado ?? 'planeacion') === e}>{e.replace('_', ' ')}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Marca</label>
      <select class="select" name="marca_id">
        <option value="">— sin asignar —</option>
        {marcas.map((m) => (
          <option value={m.id} selected={produccion.marca_id === m.id}>{m.nombre}</option>
        ))}
      </select>
    </div>
    <div class="col">
      <label class="label">Cliente</label>
      <select class="select" name="cliente_id">
        <option value="">— sin asignar —</option>
        {clientes.map((c) => (
          <option value={c.id} selected={produccion.cliente_id === c.id}>{c.nombre}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Fecha inicio</label>
      <input class="input" name="fecha_inicio" type="date" value={produccion.fecha_inicio ?? ''} />
    </div>
    <div class="col">
      <label class="label">Fecha fin</label>
      <input class="input" name="fecha_fin" type="date" value={produccion.fecha_fin ?? ''} />
    </div>
    <div class="col">
      <label class="label">Hora inicio</label>
      <input class="input" name="hora_inicio" type="time" value={produccion.hora_inicio ?? ''} />
    </div>
    <div class="col">
      <label class="label">Hora fin</label>
      <input class="input" name="hora_fin" type="time" value={produccion.hora_fin ?? ''} />
    </div>
  </div>

  <div class="row">
    <div class="col">
      <label class="label">Ubicación maquillaje</label>
      <input class="input" name="ubicacion_mua" value={produccion.ubicacion_mua ?? ''} />
    </div>
    <div class="col">
      <label class="label">Ubicación shoot</label>
      <input class="input" name="ubicacion_shoot" value={produccion.ubicacion_shoot ?? ''} />
    </div>
  </div>

  <label class="label">Presupuesto MXN (opcional)</label>
  <input class="input" name="presupuesto" type="number" step="0.01" value={produccion.presupuesto ?? ''} />

  <div class="row">
    <div class="col">
      <label class="label">Próxima acción — fecha</label>
      <input class="input" type="date" name="fecha_proxima_accion" value={produccion.fecha_proxima_accion ?? ''} />
    </div>
    <div class="col">
      <label class="label">Próxima acción — descripción</label>
      <input class="input" name="proximo_paso" value={produccion.proximo_paso ?? ''} placeholder="Ej. Dar seguimiento al cliente" />
    </div>
  </div>

  <label class="label">Equipo involucrado</label>
  <input class="input" name="equipo_involucrado" value={produccion.equipo_involucrado ?? ''} placeholder="Foto: ___, Video: ___, MUA: ___" />

  <label class="label">Material pendiente</label>
  <textarea class="textarea" name="material_pendiente" placeholder="Qué falta entregar o producir">{produccion.material_pendiente ?? ''}</textarea>

  <label class="label">Links / referencias</label>
  <textarea class="textarea" name="links_referencias" placeholder="Drive, Pinterest, briefs, etc. Uno por línea.">{produccion.links_referencias ?? ''}</textarea>

  <label class="label">Notas</label>
  <textarea class="textarea" name="notas">{produccion.notas ?? ''}</textarea>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">{submitLabel}</button>
    <a href="/producciones" class="btn">Cancelar</a>
  </div>
</form>
