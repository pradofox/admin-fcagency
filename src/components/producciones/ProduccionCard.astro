---
interface Props {
  produccion: {
    id: string;
    titulo: string;
    marca_id?: string | null;
    fecha_inicio?: string | null;
    estado: string;
    ubicacion_shoot?: string | null;
    total_cobro?: number | null;
  };
}
const { produccion } = Astro.props;

const chipClass: Record<string, string> = {
  planeacion: 'chip',
  confirmada: 'chip-gold',
  en_curso: 'chip-warning',
  completada: 'chip-ok',
  cancelada: 'chip-danger'
};

const fmt = (n?: number | null) =>
  n ? `$${Math.round(n).toLocaleString('es-MX')} MXN` : '';
---

<a href={`/producciones/${produccion.id}`} style="display:block;color:inherit;text-decoration:none">
  <article class="card">
    <div class="card-title">{produccion.titulo}</div>
    <div class="card-meta">
      <span class={`chip ${chipClass[produccion.estado] ?? ''}`}>{produccion.estado.replace('_', ' ')}</span>
      {produccion.marca_id && <span>{produccion.marca_id}</span>}
      {produccion.fecha_inicio && <span>{produccion.fecha_inicio}</span>}
      {produccion.ubicacion_shoot && <span>{produccion.ubicacion_shoot}</span>}
      {produccion.total_cobro && <span class="text-muted">{fmt(produccion.total_cobro)}</span>}
    </div>
  </article>
</a>
