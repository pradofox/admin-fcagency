---
import { getUser, isAdmin, canViewSection } from '../lib/session';

const currentPath = Astro.url.pathname;
const user = getUser(Astro);

// section = key del helper VISIBILIDAD en lib/session.ts
const links = [
  { href: '/dashboard',     section: 'dashboard',    label: 'Dashboard' },
  { href: '/modelos',       section: 'modelos',      label: 'Modelos' },
  { href: '/producciones',  section: 'producciones', label: 'Producciones' },
  { href: '/contenido',     section: 'contenido',    label: 'Redes Sociales' },
  { href: '/clientes',      section: 'clientes',     label: 'Clientes' },
  { href: '/cotizaciones',  section: 'cotizaciones', label: 'Cotizaciones' },
  { href: '/proveedores',   section: 'proveedores',  label: 'Catálogo de Servicios' },
  { href: '/pagos',         section: 'pagos',        label: 'Pagos' },
  { href: '/tareas',        section: 'tareas',       label: 'Tareas' },
  { href: '/calendario',    section: 'calendario',   label: 'Calendario' },
  { href: '/district',      section: 'district',     label: 'District Studio' },
];

const visibles = links.filter((l) => canViewSection(user, l.section));

function isActive(href: string) {
  if (href === '/dashboard') return currentPath === href;
  // Contactos vive dentro de Clientes: mantener el link activo en ambos.
  if (href === '/clientes' && (currentPath === '/contactos' || currentPath.startsWith('/contactos/'))) return true;
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<aside class="sidebar">
  <div class="sidebar-brand">FC Admin</div>
  <nav class="sidebar-nav">
    {visibles.map((l) => (
      <a href={l.href} class={`sidebar-link ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
    ))}
    {isAdmin(user) && (
      <a href="/admin" class={`sidebar-link ${isActive('/admin') ? 'active' : ''}`} style="margin-top:24px;color:var(--gold)">Admin</a>
    )}
  </nav>
  <div class="sidebar-foot">admin.fcagency.mx</div>
</aside>
