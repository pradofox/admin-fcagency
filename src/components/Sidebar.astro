---
import { getUser, isAdmin } from '../lib/session';

const currentPath = Astro.url.pathname;
const user = getUser(Astro);

const links = [
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/modelos', label: 'Modelos' },
  { href: '/producciones', label: 'Producciones' },
  { href: '/castings', label: 'Castings' },
  { href: '/briefs', label: 'Briefs' },
  { href: '/contenido', label: 'Contenido' },
  { href: '/contactos', label: 'Contactos' },
  { href: '/clientes', label: 'Clientes' },
  { href: '/pagos', label: 'Pagos' },
  { href: '/tareas', label: 'Tareas' },
  { href: '/calendario', label: 'Calendario' },
  { href: '/district', label: 'District Studio' }
];

function isActive(href: string) {
  if (href === '/dashboard') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<aside class="sidebar">
  <div class="sidebar-brand">FC Admin</div>
  <nav class="sidebar-nav">
    {links.map((l) => (
      <a href={l.href} class={`sidebar-link ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
    ))}
    {isAdmin(user) && (
      <a href="/admin" class={`sidebar-link ${isActive('/admin') ? 'active' : ''}`} style="margin-top:24px;color:var(--gold)">Admin</a>
    )}
  </nav>
  <div class="sidebar-foot">admin.fcagency.mx</div>
</aside>
