---
import Layout from '../../components/Layout.astro';
import { requireSection, canEdit, isAdmin } from '../../lib/session';
import { logAudit } from '../../lib/audit';
import { getDB, now } from '../../lib/db';
import { newId } from '../../lib/ids';
import { formatFecha } from '../../lib/fechas';

const user = requireSection(Astro, 'cotizaciones');
const editable = canEdit(user);
const verMargen = isAdmin(user);
const db = getDB(Astro);
const { id } = Astro.params;

let error: string | null = null;
let msgOk: string | null = null;

const ROLES = [
  'Fotografía', 'Video', 'Modelo', 'Maquillaje', 'Peinado', 'Styling',
  'Producción', 'Arte / Set', 'Locación', 'Catering', 'Transporte',
  'Pantallas', 'Audio', 'Iluminación', 'Operación', 'Montaje', 'Desmontaje',
  'Estudio', 'Day pass', 'Espacio', 'Otro'
];

if (Astro.request.method === 'POST' && editable) {
  const form   = await Astro.request.formData();
  const action = form.get('_action') as string;

  // ── Cambiar estado ─────────────────────────────────────────────────────────
  if (action === 'set_estado') {
    const estado = form.get('estado') as string;
    const prev = await db.prepare('SELECT numero, titulo, estado FROM cotizaciones WHERE id = ?').bind(id).first<{ numero: string; titulo: string; estado: string }>();
    await db.prepare('UPDATE cotizaciones SET estado = ?, updated_at = ? WHERE id = ?').bind(estado, now(), id).run();
    await logAudit(db, { user, accion: 'state_change', entidad: 'cotizacion', entidad_id: id, entidad_label: prev ? `${prev.numero} ${prev.titulo}` : null, payload: { de: prev?.estado, a: estado } });
    return Astro.redirect(`/cotizaciones/${id}`);
  }

  // ── Cambiar descuento / IVA ──────────────────────────────────────────────
  if (action === 'set_descuento') {
    const d   = Math.max(0, Math.min(100, Number(form.get('descuento_pct') ?? 0) || 0));
    const iva = Math.max(0, Math.min(100, Number(form.get('iva_pct') ?? 16) || 0));
    await db.prepare('UPDATE cotizaciones SET descuento_pct = ?, iva_pct = ?, updated_at = ? WHERE id = ?').bind(d, iva, now(), id).run();
    return Astro.redirect(`/cotizaciones/${id}`);
  }

  // ── Agregar concepto del catálogo ──────────────────────────────────────────
  // Estilo hoja: Cantidad × Precio unitario × Horas = Subtotal.
  // El reparto a proveedores (margen interno) escala con el subtotal.
  if (action === 'add_concepto') {
    const conceptoId = form.get('concepto_id') as string;
    const concepto = conceptoId
      ? await db.prepare('SELECT * FROM conceptos_servicio WHERE id = ?').bind(conceptoId).first<any>()
      : null;
    if (!concepto) {
      error = 'Concepto no encontrado.';
    } else {
      const precioBase = concepto.precio_mxn ?? 0;
      const horaAd = concepto.precio_hora_adicional ?? null;
      const porHora = horaAd != null && horaAd > 0;
      // Las horas cuentan SOLO cuando el concepto es de modelo (regla de
      // negocio de FC: solo modelos se cobran por horas en el cotizador).
      // Esto coincide con el frontend que solo muestra el input Horas para
      // conceptos cuyo rol o nombre contiene "modelo".
      const esModelo = /modelo/i.test(String(concepto.rol ?? '')) || /modelo/i.test(String(concepto.nombre ?? ''));
      const esPorHora = esModelo;

      const cantRaw  = form.get('cantidad');
      const cantidad = cantRaw === null || cantRaw === '' ? 1 : Math.max(1, Number(cantRaw) || 1);
      const horasRaw = form.get('horas');
      const horas    = !esPorHora ? 1 : (horasRaw === null || horasRaw === '' ? 1 : Math.max(1, Number(horasRaw) || 1));

      // Subtotal de la línea (lo que ve el cliente).
      // Tiered (modelo con hora adicional): (1ª hora + extras) × cantidad.
      // Normal: precio × cantidad × horas.
      const subtotal = porHora
        ? cantidad * (horas > 1 ? precioBase + (horas - 1) * horaAd! : precioBase)
        : precioBase * cantidad * horas;

      // Reparto a proveedores: escala con el subtotal respecto al precio base.
      const { results: reps } = await db
        .prepare('SELECT proveedor_nombre, rol, monto_mxn FROM repartos_concepto WHERE concepto_id = ?')
        .bind(conceptoId).all<any>();
      const repartos = (reps ?? []).filter((r: any) => r.proveedor_nombre);
      const sumRep = repartos.reduce((s: number, r: any) => s + (r.monto_mxn ?? 0), 0);
      const factor = precioBase > 0 ? subtotal / precioBase : cantidad * horas;
      const pagoProv = repartos.length > 0 ? Math.round(sumRep * factor) : null;
      const provNombre = repartos.map((r: any) => r.proveedor_nombre).join(', ') || null;

      const maxOrden = await db
        .prepare('SELECT MAX(orden) as m FROM lineas_cotizacion WHERE cotizacion_id = ?')
        .bind(id).first<any>();
      const orden = (maxOrden?.m ?? 0) + 1;
      await db
        .prepare(`INSERT INTO lineas_cotizacion
                    (id, cotizacion_id, descripcion, cantidad, precio_unitario, precio_base, rol, proveedor_nombre, concepto_id, pago_proveedor, reparto_json, orden, horas)
                  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`)
        .bind(
          newId(), id, concepto.nombre, cantidad, subtotal, precioBase,
          concepto.categoria ?? concepto.rol ?? null, provNombre, conceptoId,
          pagoProv as any, JSON.stringify(repartos), orden, horas
        )
        .run();
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
      return Astro.redirect(`/cotizaciones/${id}`);
    }
  }

  // ── Agregar línea manual (servicio fuera del catálogo) ─────────────────────
  if (action === 'add_linea') {
    const desc     = (form.get('descripcion') as string)?.trim();
    const base     = Number(form.get('precio_base') ?? 0) || 0;
    const cantidad = Math.max(1, Number(form.get('cantidad') ?? 1) || 1);
    const horas    = Math.max(1, Number(form.get('horas') ?? 1) || 1);
    const subtotal = base * cantidad * horas;
    const rol      = (form.get('rol') as string)?.trim() || null;
    const prov     = (form.get('proveedor_nombre') as string)?.trim() || null;
    const pagoRaw  = form.get('pago_proveedor');
    const pagoProv = pagoRaw === null || pagoRaw === '' ? null : Number(pagoRaw) || 0;
    if (!desc) {
      error = 'La descripción es obligatoria.';
    } else {
      const maxOrden = await db
        .prepare('SELECT MAX(orden) as m FROM lineas_cotizacion WHERE cotizacion_id = ?')
        .bind(id).first<any>();
      const orden = (maxOrden?.m ?? 0) + 1;
      await db
        .prepare('INSERT INTO lineas_cotizacion (id, cotizacion_id, descripcion, cantidad, precio_unitario, precio_base, horas, rol, proveedor_nombre, pago_proveedor, orden) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)')
        .bind(newId(), id, desc, cantidad, subtotal, base, horas, rol, prov, pagoProv, orden)
        .run();
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
      return Astro.redirect(`/cotizaciones/${id}`);
    }
  }

  // ── Editar línea ───────────────────────────────────────────────────────────
  if (action === 'edit_linea') {
    const lineaId  = form.get('linea_id') as string;
    const desc     = (form.get('descripcion') as string)?.trim();
    const base     = Number(form.get('precio_base') ?? 0) || 0;
    const cantidad = Math.max(1, Number(form.get('cantidad') ?? 1) || 1);
    const horas    = Math.max(1, Number(form.get('horas') ?? 1) || 1);
    const subtotal = base * cantidad * horas;
    const rol      = (form.get('rol') as string)?.trim() || null;
    const prov     = (form.get('proveedor_nombre') as string)?.trim() || null;
    const pagoRaw  = form.get('pago_proveedor');
    const pagoProv = pagoRaw === null || pagoRaw === '' ? null : Number(pagoRaw) || 0;
    if (desc) {
      await db
        .prepare('UPDATE lineas_cotizacion SET descripcion = ?, cantidad = ?, horas = ?, precio_base = ?, precio_unitario = ?, rol = ?, proveedor_nombre = ?, pago_proveedor = ? WHERE id = ? AND cotizacion_id = ?')
        .bind(desc, cantidad, horas, base, subtotal, rol, prov, pagoProv, lineaId, id).run();
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    }
    return Astro.redirect(`/cotizaciones/${id}`);
  }

  // ── Borrar línea ───────────────────────────────────────────────────────────
  if (action === 'delete_linea') {
    const lineaId = form.get('linea_id') as string;
    await db.prepare('DELETE FROM lineas_cotizacion WHERE id = ? AND cotizacion_id = ?').bind(lineaId, id).run();
    await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    return Astro.redirect(`/cotizaciones/${id}`);
  }

  // ── Editar cabecera ────────────────────────────────────────────────────────
  if (action === 'edit_header') {
    const titulo = (form.get('titulo') as string)?.trim();
    if (!titulo) { error = 'El título es obligatorio.'; }
    else {
      const get = (k: string) => { const v = form.get(k); return v === null || v === '' ? null : String(v).trim(); };
      await db
        .prepare('UPDATE cotizaciones SET titulo = ?, cliente_id = ?, cliente_libre = ?, fecha_vencimiento = ?, tipo = ?, fecha_evento = ?, hora_evento = ?, ubicacion = ?, notas = ?, notas_internas = ?, updated_at = ? WHERE id = ?')
        .bind(titulo, get('cliente_id'), get('cliente_libre'), get('fecha_vencimiento'), get('tipo'), get('fecha_evento'), get('hora_evento'), get('ubicacion'), get('notas'), get('notas_internas'), now(), id)
        .run();
      msgOk = 'Guardado.';
    }
  }

  // ── Agregar modelo propuesto a la cotizacion ───────────────────────────────
  if (action === 'add_modelo_cot') {
    const modeloId = form.get('modelo_id') as string;
    const rol      = (form.get('rol') as string)?.trim() || null;
    if (modeloId) {
      try {
        await db
          .prepare('INSERT INTO cotizacion_modelos (id, cotizacion_id, modelo_id, rol, created_at) VALUES (?, ?, ?, ?, ?)')
          .bind(newId(), id, modeloId, rol, now())
          .run();
      } catch { /* UNIQUE violation: ya estaba propuesto */ }
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    }
    return Astro.redirect(`/cotizaciones/${id}#modelos`);
  }

  // ── Quitar modelo propuesto ────────────────────────────────────────────────
  if (action === 'remove_modelo_cot') {
    const cmId = form.get('cm_id') as string;
    if (cmId) {
      await db.prepare('DELETE FROM cotizacion_modelos WHERE id = ? AND cotizacion_id = ?').bind(cmId, id).run();
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    }
    return Astro.redirect(`/cotizaciones/${id}#modelos`);
  }

  // ── Agregar proveedor del directorio (equipo de produccion) ───────────────
  if (action === 'add_prov_cot') {
    const provId = form.get('proveedor_dir_id') as string;
    const rol    = (form.get('rol') as string)?.trim() || null;
    if (provId) {
      try {
        await db
          .prepare('INSERT INTO cotizacion_proveedores (id, cotizacion_id, proveedor_dir_id, rol, created_at) VALUES (?, ?, ?, ?, ?)')
          .bind(newId(), id, provId, rol, now())
          .run();
      } catch { /* UNIQUE: ya estaba */ }
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    }
    return Astro.redirect(`/cotizaciones/${id}#equipo`);
  }

  // ── Quitar proveedor propuesto ────────────────────────────────────────────
  if (action === 'remove_prov_cot') {
    const cpId = form.get('cp_id') as string;
    if (cpId) {
      await db.prepare('DELETE FROM cotizacion_proveedores WHERE id = ? AND cotizacion_id = ?').bind(cpId, id).run();
      await db.prepare('UPDATE cotizaciones SET updated_at = ? WHERE id = ?').bind(now(), id).run();
    }
    return Astro.redirect(`/cotizaciones/${id}#equipo`);
  }

  // ── Convertir a proyecto ───────────────────────────────────────────────────
  if (action === 'convertir') {
    const cot = await db.prepare('SELECT * FROM cotizaciones WHERE id = ?').bind(id).first<any>();
    if (!cot || cot.estado !== 'autorizada') {
      error = 'Solo se puede convertir una cotización autorizada.';
    } else {
      // Fecha y ubicacion del form modal (o las de la cotizacion si ya las tiene)
      const fechaInicio = (form.get('fecha_inicio') as string) || cot.fecha_evento || null;
      const fechaFin    = (form.get('fecha_fin') as string) || null;
      const ubicacion   = (form.get('ubicacion') as string) || cot.ubicacion || null;
      const tipoProd    = cot.tipo || null;

      // Para editorial/pasarela la fecha es obligatoria.
      const requiereFecha = tipoProd === 'editorial' || tipoProd === 'pasarela';
      if (requiereFecha && !fechaInicio) {
        error = 'Para producciones editoriales o pasarelas la fecha es obligatoria.';
        // Caemos al render normal mostrando el error.
      } else {

      // Guardar los datos en la cotizacion para historico
      if (fechaInicio || ubicacion) {
        await db.prepare('UPDATE cotizaciones SET fecha_evento = COALESCE(?, fecha_evento), ubicacion = COALESCE(?, ubicacion), updated_at = ? WHERE id = ?')
          .bind(fechaInicio, ubicacion, now(), id).run();
      }

      const { results: lineas } = await db
        .prepare('SELECT * FROM lineas_cotizacion WHERE cotizacion_id = ? ORDER BY orden')
        .bind(id).all<any>();

      const prodId = newId();
      const ts = now();
      const totalCobro = (lineas ?? []).reduce((s: number, l: any) => s + (l.precio_unitario ?? 0), 0);

      await db
        .prepare(`INSERT INTO producciones (id, titulo, cliente_id, fecha_inicio, fecha_fin, ubicacion, estado, presupuesto, notas, created_at, updated_at)
                  VALUES (?, ?, ?, ?, ?, ?, 'planeacion', ?, ?, ?, ?)`)
        .bind(prodId, cot.titulo, cot.cliente_id, fechaInicio ?? new Date().toISOString().slice(0,10), fechaFin, ubicacion, totalCobro, cot.notas, ts, ts)
        .run();

      // Bookings tentativos desde modelos propuestos en la cotizacion
      const { results: modelosProp } = await db
        .prepare('SELECT modelo_id, rol, notas FROM cotizacion_modelos WHERE cotizacion_id = ?')
        .bind(id).all<{ modelo_id: string; rol: string | null; notas: string | null }>();
      for (const m of (modelosProp ?? [])) {
        await db
          .prepare(`INSERT INTO bookings (id, produccion_id, modelo_id, rol, estado, notas, created_at)
                    VALUES (?, ?, ?, ?, 'tentativo', ?, ?)`)
          .bind(newId(), prodId, m.modelo_id, m.rol, m.notas, ts)
          .run();
        // Tambien como linea_produccion para que aparezca en "Equipo asignado"
        const modeloNombre = await db.prepare('SELECT nombre FROM modelos WHERE id = ?').bind(m.modelo_id).first<any>();
        await db
          .prepare(`INSERT INTO lineas_produccion (id, produccion_id, rol, nombre_libre, modelo_id, cobro_cliente, comision_pct, estado, created_at)
                    VALUES (?, ?, ?, ?, ?, 0, 20, 'pendiente', ?)`)
          .bind(newId(), prodId, m.rol ?? 'Modelo', modeloNombre?.nombre ?? null, m.modelo_id, ts)
          .run();
      }

      // Equipo de produccion (proveedores del directorio) propuesto: lineas
      const { results: provsProp } = await db
        .prepare(`SELECT cp.rol, cp.notas, pd.nombre
                  FROM cotizacion_proveedores cp
                  JOIN proveedores_directorio pd ON pd.id = cp.proveedor_dir_id
                  WHERE cp.cotizacion_id = ?`)
        .bind(id).all<{ rol: string | null; notas: string | null; nombre: string }>();
      for (const p of (provsProp ?? [])) {
        await db
          .prepare(`INSERT INTO lineas_produccion (id, produccion_id, rol, nombre_libre, cobro_cliente, comision_pct, estado, created_at)
                    VALUES (?, ?, ?, ?, 0, 20, 'pendiente', ?)`)
          .bind(newId(), prodId, p.rol ?? 'Otro', p.nombre, ts)
          .run();
      }

      for (const l of (lineas ?? [])) {
        const cobroLinea = l.precio_unitario ?? 0;
        // Reparto real (concepto del catálogo): una línea de producción por proveedor,
        // repartiendo el cobro proporcionalmente para que cada quien reciba su monto.
        let repartos: any[] = [];
        try { repartos = JSON.parse(l.reparto_json ?? '[]').filter((r: any) => r.proveedor_nombre); } catch {}
        const sumRep = repartos.reduce((s: number, r: any) => s + (r.monto_mxn ?? 0), 0);

        if (repartos.length > 0 && sumRep > 0 && cobroLinea > 0) {
          const marginPct = Math.max(0, Math.min(100, (1 - sumRep / cobroLinea) * 100));
          for (const r of repartos) {
            const cobroProv = cobroLinea * ((r.monto_mxn ?? 0) / sumRep);
            await db
              .prepare(`INSERT INTO lineas_produccion (id, produccion_id, nombre_libre, rol, cobro_cliente, comision_pct, estado, created_at)
                        VALUES (?, ?, ?, ?, ?, ?, 'pendiente', ?)`)
              .bind(newId(), prodId, r.proveedor_nombre, r.rol ?? l.rol ?? 'Servicio', cobroProv, marginPct, ts)
              .run();
          }
        } else {
          // Línea manual: pago_proveedor explícito o 80/20 por defecto
          const pagoProv = l.pago_proveedor;
          const comisionPct = (pagoProv != null && cobroLinea > 0)
            ? Math.max(0, Math.min(100, (1 - pagoProv / cobroLinea) * 100))
            : 20;
          await db
            .prepare(`INSERT INTO lineas_produccion (id, produccion_id, nombre_libre, rol, cobro_cliente, comision_pct, estado, created_at)
                      VALUES (?, ?, ?, ?, ?, ?, 'pendiente', ?)`)
            .bind(newId(), prodId, l.proveedor_nombre ?? l.descripcion, l.rol ?? 'Servicio', cobroLinea, comisionPct, ts)
            .run();
        }
      }

      await db
        .prepare("UPDATE cotizaciones SET estado = 'convertida', produccion_id = ?, updated_at = ? WHERE id = ?")
        .bind(prodId, ts, id).run();

      await logAudit(db, { user, accion: 'convertir', entidad: 'cotizacion', entidad_id: id, entidad_label: null, payload: { produccion_id: prodId, tipo: tipoProd, fecha: fechaInicio, modelos: modelosProp?.length ?? 0 } });
      return Astro.redirect(`/producciones/${prodId}`);
      } // cierra el else de requiereFecha
    }
  }
}

const cot = await db
  .prepare(`SELECT c.*, cl.nombre as cliente_nombre FROM cotizaciones c LEFT JOIN clientes cl ON cl.id = c.cliente_id WHERE c.id = ?`)
  .bind(id).first<any>();
if (!cot) return Astro.redirect('/cotizaciones');

const { results: lineasRaw } = await db
  .prepare(`SELECT l.*, cs.max_descuento AS _max_desc, cs.descripcion AS _concepto_desc
            FROM lineas_cotizacion l
            LEFT JOIN conceptos_servicio cs ON cs.id = l.concepto_id
            WHERE l.cotizacion_id = ? ORDER BY l.orden`)
  .bind(id).all<any>();

// Enriquecer cada línea: cantidad / precio unitario / horas / subtotal + margen interno.
const lineas = (lineasRaw ?? []).map((l: any) => {
  let repartos: any[] = [];
  try { repartos = JSON.parse(l.reparto_json ?? '[]').filter((r: any) => r.proveedor_nombre); } catch {}
  const cant  = l.cantidad ?? 1;
  const horas = l.horas ?? 1;
  const sub   = l.precio_unitario ?? 0;               // subtotal de la línea
  const base  = l.precio_base != null ? l.precio_base // precio unitario base
                : (cant * horas > 0 ? sub / (cant * horas) : sub);
  // Pago a proveedores: si la línea tiene pago_proveedor definido, úsalo; si no, 80/20.
  const pago = l.pago_proveedor != null ? l.pago_proveedor : Math.round(sub * 0.8);
  return { ...l, repartos, _cant: cant, _horas: horas, _base: base, _cobro: sub, _pago: pago, _util: sub - pago };
});

const { results: clientes } = await db.prepare('SELECT id, nombre FROM clientes ORDER BY nombre').all<any>();

// Modelos propuestos para la cotizacion
const { results: modelosPropuestos } = await db
  .prepare(`SELECT cm.id, cm.modelo_id, cm.rol, cm.notas, m.nombre, m.instagram, m.ciudad
            FROM cotizacion_modelos cm
            JOIN modelos m ON m.id = cm.modelo_id
            WHERE cm.cotizacion_id = ?
            ORDER BY m.nombre`)
  .bind(id).all<any>();

// Catalogo de modelos activos (para el selector)
const { results: modelosCat } = await db
  .prepare("SELECT id, nombre, instagram, ciudad FROM modelos WHERE estado = 'activo' ORDER BY nombre")
  .all<{ id: string; nombre: string; instagram: string | null; ciudad: string | null }>();
const propIds = new Set((modelosPropuestos ?? []).map((m: any) => m.modelo_id));

// Equipo de produccion propuesto: proveedores del directorio asignados
const { results: provsPropuestos } = await db
  .prepare(`SELECT cp.id, cp.proveedor_dir_id, cp.rol, cp.notas,
                   pd.nombre, pd.tipo, pd.instagram, pd.whatsapp, pd.email
            FROM cotizacion_proveedores cp
            JOIN proveedores_directorio pd ON pd.id = cp.proveedor_dir_id
            WHERE cp.cotizacion_id = ?
            ORDER BY pd.tipo, pd.nombre`)
  .bind(id).all<any>();

// Directorio activo para el selector (todos los proveedores)
const { results: provDirCat } = await db
  .prepare("SELECT id, nombre, tipo, instagram FROM proveedores_directorio WHERE activo = 1 ORDER BY tipo, nombre")
  .all<{ id: string; nombre: string; tipo: string | null; instagram: string | null }>();
const provPropIds = new Set((provsPropuestos ?? []).map((p: any) => p.proveedor_dir_id));

// Catálogo de conceptos con su reparto (para agregar al catálogo)
const { results: conceptosCat } = await db
  .prepare(
    `SELECT cs.id, cs.nombre, cs.rol, cs.precio_mxn, cs.precio_hora_adicional, cs.por_hora,
            json_group_array(json_object(
              'proveedor_nombre', r.proveedor_nombre,
              'rol', r.rol,
              'monto_mxn', r.monto_mxn
            )) as repartos_json
     FROM conceptos_servicio cs
     LEFT JOIN repartos_concepto r ON r.concepto_id = cs.id
     WHERE cs.activo = 1
     GROUP BY cs.id
     ORDER BY cs.rol, cs.nombre`
  )
  .all<any>();

const proveedoresData = (conceptosCat ?? []).map((c: any) => {
  let repartos: any[] = [];
  try { repartos = JSON.parse(c.repartos_json ?? '[]').filter((r: any) => r.proveedor_nombre); } catch {}
  const sumRep = repartos.reduce((s: number, r: any) => s + (r.monto_mxn ?? 0), 0);
  return { ...c, repartos, sumRep, margen: (c.precio_mxn ?? 0) - sumRep };
});

// Totales — suma de los valores reales de cada línea
const totalCobrado     = lineas.reduce((s: number, l: any) => s + l._cobro, 0);
const totalProveedores = lineas.reduce((s: number, l: any) => s + l._pago, 0);
const totalUtilidad    = totalCobrado - totalProveedores;
const margenPct        = totalCobrado > 0 ? Math.round((totalUtilidad / totalCobrado) * 100) : 0;

// Bloque de totales estilo hoja: Subtotal → Descuento (con tope) → IVA → Total.
const subtotalSinIva = totalCobrado;
const topesDesc      = lineas.map((l: any) => l._max_desc).filter((v: any) => v != null && v > 0);
const topeDescuento  = topesDesc.length ? Math.min(...topesDesc) : 100;
const descuentoPctReq = cot.descuento_pct ?? 0;
const descuentoPct    = Math.min(descuentoPctReq, topeDescuento);
const descuentoMonto  = subtotalSinIva * descuentoPct / 100;
const subtotalConDesc = subtotalSinIva - descuentoMonto;
const ivaPct          = cot.iva_pct ?? 16;
const ivaMonto        = subtotalConDesc * ivaPct / 100;
const totalConIva     = subtotalConDesc + ivaMonto;

const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-MX')}`;

const editLineaId = Astro.url.searchParams.get('editar_linea');

const colorEstado: Record<string, string> = {
  borrador: '', enviada: '#E5E5E5', autorizada: 'var(--text-ok,#4ade80)',
  rechazada: 'var(--danger,#e25555)', convertida: 'var(--text-ok,#4ade80)'
};

const ESTADOS_FLUJO = [
  { v: 'borrador',   label: 'Borrador' },
  { v: 'enviada',    label: 'Enviada al cliente' },
  { v: 'autorizada', label: 'Autorizada' },
  { v: 'rechazada',  label: 'Rechazada' },
];
---

<Layout title={`${cot.numero} — ${cot.titulo}`} pageTitle="Cotizaciones">
  <div class="page-head">
    <div>
      <div style="display:flex;gap:10px;align-items:baseline">
        <span class="mono" style="color:var(--gold);font-size:13px;letter-spacing:.1em">{cot.numero}</span>
        <h1 style="margin:0">{cot.titulo}</h1>
      </div>
      <div class="card-meta" style="margin-top:4px">
        <span class="text-muted">{cot.cliente_nombre ?? cot.cliente_libre ?? 'Sin cliente'}</span>
        <span class="chip" style={`color:${colorEstado[cot.estado] ?? ''}`}>{cot.estado}</span>
        {cot.fecha_vencimiento && <span class="mono text-muted">vence {formatFecha(cot.fecha_vencimiento)}</span>}
        {cot.produccion_id && <a href={`/producciones/${cot.produccion_id}`} class="chip chip-ok">ver proyecto →</a>}
      </div>
    </div>
    <div style="display:flex;gap:8px">
      <a href={`/cotizaciones/imprimir/${id}`} target="_blank" class="btn btn-sm" title="Exportar PDF">⬇ PDF</a>
      <a href="/cotizaciones" class="btn btn-sm">Volver</a>
    </div>
  </div>

  {error  && <p class="text-danger" style="margin-bottom:16px">{error}</p>}
  {msgOk  && <p class="text-ok"    style="margin-bottom:16px">{msgOk}</p>}

  {/* ── Resumen financiero (utilidad solo admin) ── */}
  {totalCobrado > 0 && (
    verMargen ? (
      <div class="row" style="margin-bottom:24px">
        <div class="col card" style="border-left:3px solid var(--gold)">
          <div class="card-meta">Total cobrado al cliente</div>
          <div class="card-title mono" style="color:var(--gold)">{fmt(totalCobrado)}</div>
        </div>
        <div class="col card" style="border-left:3px solid var(--danger,#e25555)">
          <div class="card-meta">Pago a proveedores</div>
          <div class="card-title mono" style="color:var(--danger,#e25555)">{fmt(totalProveedores)}</div>
        </div>
        <div class="col card" style="border-left:3px solid var(--text-ok,#4ade80)">
          <div class="card-meta">Ganancia FC ({margenPct}%)</div>
          <div class="card-title mono text-ok">{fmt(totalUtilidad)}</div>
        </div>
      </div>
    ) : (
      <div class="row" style="margin-bottom:24px">
        <div class="col card" style="border-left:3px solid var(--gold)">
          <div class="card-meta">Total cobrado al cliente</div>
          <div class="card-title mono" style="color:var(--gold)">{fmt(totalCobrado)}</div>
        </div>
      </div>
    )
  )}

  {/* ── Acciones de estado ── */}
  {editable && cot.estado !== 'convertida' && (
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px">
      {ESTADOS_FLUJO.filter((e) => e.v !== cot.estado).map((e) => (
        <form method="POST" action={`/cotizaciones/${id}`} style="display:inline">
          <input type="hidden" name="_action" value="set_estado" />
          <input type="hidden" name="estado" value={e.v} />
          <button type="submit" class={`btn btn-sm ${e.v === 'autorizada' ? 'btn-primary' : e.v === 'rechazada' ? 'btn-danger' : ''}`}>
            → {e.label}
          </button>
        </form>
      ))}
      {cot.estado === 'autorizada' && (
        <details style="display:inline-block;position:relative">
          <summary class="btn btn-primary" style="background:var(--gold);color:#000;font-weight:700;list-style:none;cursor:pointer">
            ✓ Convertir en proyecto
          </summary>
          <form method="POST" action={`/cotizaciones/${id}`}
                style="position:absolute;top:100%;left:0;margin-top:6px;background:var(--bg-2);border:1px solid var(--border);padding:16px;border-radius:4px;min-width:340px;z-index:10;box-shadow:0 4px 16px rgba(0,0,0,.4)">
            <input type="hidden" name="_action" value="convertir" />
            <p class="text-muted" style="font-size:12px;margin:0 0 12px">
              Se creará una producción con todas las líneas, proveedores y modelos propuestos.
              {(cot.tipo === 'editorial' || cot.tipo === 'pasarela') && <strong style="color:#E5E5E5"> Fecha obligatoria para {cot.tipo}.</strong>}
            </p>
            <label class="label">Fecha del evento {(cot.tipo === 'editorial' || cot.tipo === 'pasarela') ? '*' : ''}</label>
            <input class="input" type="date" name="fecha_inicio" value={cot.fecha_evento ?? ''} required={cot.tipo === 'editorial' || cot.tipo === 'pasarela'} />
            <label class="label" style="margin-top:8px">Fecha fin (opcional)</label>
            <input class="input" type="date" name="fecha_fin" />
            <label class="label" style="margin-top:8px">Ubicación</label>
            <input class="input" name="ubicacion" value={cot.ubicacion ?? ''} placeholder="Ej. District Studio" />
            <button type="submit" class="btn btn-primary" style="background:var(--gold);color:#000;font-weight:700;margin-top:12px;width:100%">
              ✓ Convertir
            </button>
          </form>
        </details>
      )}
    </div>
  )}

  {/* ── Líneas ── */}
  <div style="margin-bottom:32px">
    <h2 style="margin-bottom:12px">Servicios cotizados</h2>

    {lineas.length > 0 && (
      <div class="table-card" style="margin-bottom:12px">
        <table>
          <thead>
            <tr>
              <th>Concepto</th>
              <th class="right">Cant.</th>
              <th class="right">Precio unit.</th>
              <th class="right">Horas</th>
              <th class="right">Subtotal</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {(lineas as any[]).map((l) => (
              editLineaId === l.id ? (
                <tr>
                  <td colspan="6" style="padding:0">
                    <form method="POST" action={`/cotizaciones/${id}`}
                          style="display:grid;grid-template-columns:1fr 70px 110px 70px 110px auto auto;gap:6px;padding:8px;background:var(--bg-2);align-items:center">
                      <input type="hidden" name="_action" value="edit_linea" />
                      <input type="hidden" name="linea_id" value={l.id} />
                      <input type="hidden" name="rol" value={l.rol ?? ''} />
                      <input type="hidden" name="proveedor_nombre" value={l.proveedor_nombre ?? ''} />
                      <input class="input" name="descripcion" value={l.descripcion} required placeholder="Concepto" />
                      <input class="input" type="number" name="cantidad" value={l._cant} min="1" step="1" title="Cantidad" />
                      <input class="input" type="number" name="precio_base" value={Math.round(l._base)} min="0" step="1" title="Precio unitario" />
                      <input class="input" type="number" name="horas" value={l._horas} min="1" step="0.5" title="Horas" />
                      <input class="input" type="number" name="pago_proveedor" value={l.pago_proveedor ?? ''} min="0" step="1" placeholder="Pago prov." title="Pago a proveedores (vacío = 80%)" />
                      <button type="submit" class="btn btn-sm btn-primary">✓</button>
                      <a href={`/cotizaciones/${id}`} class="btn btn-sm">✕</a>
                    </form>
                  </td>
                </tr>
              ) : (
                <tr>
                  <td>
                    <div style="font-weight:500">
                      {l.descripcion}
                      {l.concepto_id && <span class="chip" style="font-size:9px;margin-left:6px;color:var(--gold)">catálogo</span>}
                    </div>
                    {l._concepto_desc && <div class="text-muted" style="font-size:11px;margin-top:2px;white-space:pre-wrap">{l._concepto_desc}</div>}
                    {editable && (
                      <div class="text-muted" style="font-size:10px;margin-top:3px">
                        interno: paga {fmt(l._pago)} · utilidad {fmt(l._util)}
                      </div>
                    )}
                  </td>
                  <td class="right mono">{l._cant}</td>
                  <td class="right mono">{fmt(l._base)}</td>
                  <td class="right mono">{l._horas}</td>
                  <td class="right mono" style="color:var(--gold);font-weight:600">{fmt(l._cobro)}</td>
                  <td style="white-space:nowrap">
                    {editable && cot.estado !== 'convertida' && (
                      <>
                        <a href={`/cotizaciones/${id}?editar_linea=${l.id}`} class="btn btn-sm" style="margin-right:4px">Editar</a>
                        <form method="POST" action={`/cotizaciones/${id}`} style="display:inline">
                          <input type="hidden" name="_action" value="delete_linea" />
                          <input type="hidden" name="linea_id" value={l.id} />
                          <button type="submit" class="btn btn-sm btn-danger">✕</button>
                        </form>
                      </>
                    )}
                  </td>
                </tr>
              )
            ))}
          </tbody>
          <tfoot style="border-top:2px solid var(--border)">
            <tr>
              <td colspan="4" style="text-align:right;color:var(--text-muted,#888)">Subtotal sin IVA</td>
              <td class="right mono" style="font-size:14px">{fmt(subtotalSinIva)}</td>
              <td></td>
            </tr>
            {descuentoPct > 0 && (
              <tr>
                <td colspan="4" style="text-align:right;color:var(--text-muted,#888)">Descuento ({descuentoPct}%)</td>
                <td class="right mono" style="color:var(--danger,#e25555)">−{fmt(descuentoMonto)}</td>
                <td></td>
              </tr>
            )}
            {descuentoPct > 0 && (
              <tr>
                <td colspan="4" style="text-align:right;color:var(--text-muted,#888)">Subtotal con descuento</td>
                <td class="right mono">{fmt(subtotalConDesc)}</td>
                <td></td>
              </tr>
            )}
            <tr>
              <td colspan="4" style="text-align:right;color:var(--text-muted,#888)">+ IVA {ivaPct}%</td>
              <td class="right mono">{fmt(ivaMonto)}</td>
              <td></td>
            </tr>
            <tr>
              <td colspan="4" style="text-align:right;font-weight:700;font-size:15px">TOTAL CON IVA</td>
              <td class="right mono" style="color:var(--gold);font-size:16px;font-weight:700">{fmt(totalConIva)}</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    )}

    {/* ── Descuento / IVA ── */}
    {editable && cot.estado !== 'convertida' && lineas.length > 0 && (
      <form method="POST" action={`/cotizaciones/${id}`}
            style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;background:var(--bg-2);border:1px solid var(--border);padding:12px;margin-bottom:12px">
        <input type="hidden" name="_action" value="set_descuento" />
        <div>
          <label class="label">Descuento %</label>
          <input class="input" type="number" name="descuento_pct" value={cot.descuento_pct ?? 0} min="0" max="100" step="1" style="width:90px" />
        </div>
        <div>
          <label class="label">IVA %</label>
          <input class="input" type="number" name="iva_pct" value={cot.iva_pct ?? 16} min="0" max="100" step="1" style="width:90px" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
        {topeDescuento < 100 && (
          <span class="text-muted" style="font-size:11px;padding-bottom:8px">
            Tope de descuento según conceptos: {topeDescuento}%{descuentoPctReq > topeDescuento ? ` (se aplicó ${descuentoPct}%)` : ''}
          </span>
        )}
      </form>
    )}

    {!lineas.length && <p class="text-muted">Sin líneas aún. Agrega conceptos del catálogo abajo.</p>}

    {/* ── Agregar desde el catálogo: dos forms separados (modelos y servicios) ── */}
    {editable && cot.estado !== 'convertida' && proveedoresData.length > 0 && (() => {
      const esModelo = (c: any) => /modelo/i.test(String(c.rol || '')) || /modelo/i.test(String(c.nombre || ''));
      const conceptosModelo  = proveedoresData.filter(esModelo);
      const conceptosServicio = proveedoresData.filter((c: any) => !esModelo(c));
      return (
        <div style="margin-bottom:12px">
          {/* ── FORM 1: AGREGAR MODELOS (con campo Horas) ── */}
          {conceptosModelo.length > 0 && (
            <details style="background:var(--bg-2);border:1px solid var(--border);padding:16px;margin-bottom:10px" open>
              <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Agregar modelos a la cotización</summary>
              <p class="text-muted" style="font-size:11px;margin:8px 0 12px">
                1ª hora por modelo = $1,000 · cada hora extra por modelo = $800. Captura cuántos modelos y cuántas horas.
              </p>
              <form method="POST" action={`/cotizaciones/${id}`} style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
                <input type="hidden" name="_action" value="add_concepto" />
                <div style="flex:1;min-width:240px">
                  <label class="label">Concepto de modelo</label>
                  <select class="select" name="concepto_id" required>
                    <option value="">— elegir —</option>
                    {conceptosModelo.map((c: any) => (
                      <option value={c.id}>
                        {c.rol ? `[${c.rol}] ` : ''}{c.nombre}
                      </option>
                    ))}
                  </select>
                </div>
                <div style="min-width:120px">
                  <label class="label">Cantidad de modelos</label>
                  <input class="input" type="number" name="cantidad" min="1" step="1" value="1" required style="width:130px" />
                </div>
                <div style="min-width:120px">
                  <label class="label">Horas de modelo</label>
                  <input class="input" type="number" name="horas" min="1" step="0.5" value="1" required style="width:130px" />
                </div>
                <button type="submit" class="btn btn-primary">Agregar a la cotización</button>
              </form>
            </details>
          )}

          {/* ── FORM 2: AGREGAR OTROS SERVICIOS (sin campo Horas) ── */}
          {conceptosServicio.length > 0 && (
            <details style="background:var(--bg-2);border:1px solid var(--border);padding:16px" open>
              <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Agregar servicio del catálogo</summary>
              <p class="text-muted" style="font-size:11px;margin:8px 0 12px">
                Paquetes, estudio, maquillaje, catering, etc. El concepto trae su precio y reparto a proveedores ya definido.
              </p>
              <form method="POST" action={`/cotizaciones/${id}`} style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
                <input type="hidden" name="_action" value="add_concepto" />
                <div style="flex:1;min-width:280px">
                  <label class="label">Concepto</label>
                  <select class="select" name="concepto_id" required>
                    <option value="">— elegir concepto —</option>
                    {conceptosServicio.map((c: any) => (
                      <option value={c.id}>
                        {c.rol ? `[${c.rol}] ` : ''}{c.nombre} — ${Math.round(c.precio_mxn).toLocaleString('es-MX')}
                      </option>
                    ))}
                  </select>
                </div>
                <div style="min-width:120px">
                  <label class="label">Cantidad</label>
                  <input class="input" type="number" name="cantidad" min="1" step="1" value="1" required style="width:130px" />
                </div>
                <button type="submit" class="btn btn-primary">Agregar a la cotización</button>
              </form>
            </details>
          )}
        </div>
      );
    })()}

    {editable && cot.estado !== 'convertida' && proveedoresData.length > 0 && (
      <div style="margin-bottom:12px">
        <p style="font-size:11px;margin:0">
          <a href="/proveedores" style="color:var(--gold)">¿Falta un concepto? Crea o edita en el catálogo de servicios →</a>
        </p>
      </div>
    )}

    {/* ── Agregar servicio manual (fuera del catálogo) ── */}
    {editable && cot.estado !== 'convertida' && (
      <details style="background:var(--bg-2);border:1px solid var(--border);padding:16px" id="details_add_linea">
        <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted,#888)">+ Agregar servicio manual (fuera del catálogo)</summary>

        <form method="POST" action={`/cotizaciones/${id}`} style="margin-top:12px" id="form_add_linea">
          <input type="hidden" name="_action" value="add_linea" />
          <div class="row">
            <div class="col">
              <label class="label">Rol *</label>
              <select class="select" name="rol" id="inp_rol">
                <option value="">— elige rol —</option>
                {ROLES.map((r) => <option value={r}>{r}</option>)}
              </select>
            </div>
            <div class="col" style="flex:2">
              <label class="label">Descripción *</label>
              <input class="input" name="descripcion" id="inp_desc" required placeholder="Ej. Sesión foto estudio 4 hrs" />
            </div>
            <div class="col">
              <label class="label">Proveedor</label>
              <input class="input" name="proveedor_nombre" id="inp_prov" placeholder="Nombre del proveedor" />
            </div>
          </div>
          <div class="row">
            <div class="col">
              <label class="label">Precio unitario MXN</label>
              <input class="input" type="number" name="precio_base" id="inp_base" placeholder="0" min="0" step="1" oninput="calcUtilManual()" />
            </div>
            <div class="col">
              <label class="label">Cantidad</label>
              <input class="input" type="number" name="cantidad" id="inp_cant" value="1" min="1" step="1" oninput="calcUtilManual()" />
            </div>
            <div class="col">
              <label class="label">Horas</label>
              <input class="input" type="number" name="horas" id="inp_horas" value="1" min="1" step="0.5" oninput="calcUtilManual()" />
            </div>
          </div>
          <div class="row">
            <div class="col">
              <label class="label">Pago al proveedor MXN <span class="text-muted" style="font-weight:400">(vacío = 80%)</span></label>
              <input class="input" type="number" name="pago_proveedor" id="inp_pago" placeholder="auto 80%" min="0" step="1" oninput="calcUtilManual()" />
            </div>
            <div class="col" style="display:flex;align-items:flex-end">
              <div id="util_manual" style="font-size:12px;color:var(--text-muted,#888);font-weight:600;padding-bottom:10px"></div>
            </div>
            <div class="col"></div>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top:8px">Agregar</button>
        </form>
      </details>
    )}
  </div>

  {/* ── Modelos propuestos ── */}
  <div id="modelos" style="margin-bottom:32px">
    <h2 style="margin-bottom:12px">
      Modelos propuestos
      <small class="text-muted" style="font-size:12px;letter-spacing:0;font-family:var(--font-body);text-transform:none">
        {modelosPropuestos?.length ?? 0}
      </small>
    </h2>
    {modelosPropuestos && modelosPropuestos.length > 0 ? (
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px">
        {(modelosPropuestos as any[]).map((m) => (
          <div style="display:flex;align-items:center;gap:6px;background:var(--bg-2);border:1px solid var(--border);padding:6px 10px;border-radius:20px;font-size:12px">
            <a href={`/modelos/${m.modelo_id}`} style="color:inherit;font-weight:600">{m.nombre}</a>
            {m.rol && <span class="text-muted">· {m.rol}</span>}
            {m.instagram && <span class="text-muted" style="font-size:11px">@{m.instagram.replace(/^@/, '')}</span>}
            {editable && cot.estado !== 'convertida' && (
              <form method="POST" action={`/cotizaciones/${id}`} style="display:inline;margin-left:4px">
                <input type="hidden" name="_action" value="remove_modelo_cot" />
                <input type="hidden" name="cm_id" value={m.id} />
                <button type="submit" class="btn btn-sm btn-danger" title="Quitar de la cotización"
                        style="padding:1px 6px;font-size:11px;line-height:1;border-radius:50%">×</button>
              </form>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-muted" style="font-size:12px;margin-bottom:12px">Sin modelos propuestos aún. Agrega del roster abajo.</p>
    )}

    {editable && cot.estado !== 'convertida' && (modelosCat?.length ?? 0) > 0 && (
      <form method="POST" action={`/cotizaciones/${id}`}
            style="display:flex;gap:6px;align-items:flex-end;background:var(--bg-2);border:1px solid var(--border);padding:12px;border-radius:4px"
            id="form_add_modelo_cot">
        <input type="hidden" name="_action" value="add_modelo_cot" />
        <input type="hidden" name="modelo_id" id="modelo_id_hidden" required />
        <div style="flex:2">
          <label class="label">Buscar modelo por nombre, instagram o ciudad</label>
          <input class="input" id="modelo_search" list="modelos_disponibles" placeholder="Escribe para buscar..." autocomplete="off" required />
          <datalist id="modelos_disponibles">
            {(modelosCat as any[]).filter((m) => !propIds.has(m.id)).map((m) => (
              <option value={m.nombre} data-id={m.id}>{[m.instagram && `@${m.instagram.replace(/^@/, '')}`, m.ciudad].filter(Boolean).join(' · ')}</option>
            ))}
          </datalist>
        </div>
        <div style="flex:1">
          <label class="label">Rol (opcional)</label>
          <input class="input" name="rol" placeholder="Ej. Imagen principal" />
        </div>
        <button type="submit" class="btn btn-primary">+ Agregar</button>
      </form>
    )}

    <script is:inline define:vars={{ modelosDisponibles: (modelosCat ?? []).filter((m: any) => !propIds.has(m.id)) }}>
      // Resuelve nombre escrito -> id antes del submit. Tolera coincidencias por
      // nombre exacto, por instagram (@usuario) o por id directo.
      (function () {
        const inp    = document.getElementById('modelo_search');
        const hidden = document.getElementById('modelo_id_hidden');
        const form   = document.getElementById('form_add_modelo_cot');
        if (!inp || !hidden || !form) return;
        const map = new Map();
        modelosDisponibles.forEach(function (m) {
          map.set(m.nombre.toLowerCase(), m.id);
          if (m.instagram) map.set('@' + m.instagram.replace(/^@/, '').toLowerCase(), m.id);
        });
        function resolve() {
          const v = (inp.value || '').trim().toLowerCase();
          hidden.value = map.get(v) || '';
        }
        inp.addEventListener('input', resolve);
        inp.addEventListener('change', resolve);
        form.addEventListener('submit', function (e) {
          resolve();
          if (!hidden.value) {
            e.preventDefault();
            alert('Elige un modelo de la lista (escribe el nombre y selecciona la sugerencia).');
          }
        });
      })();
    </script>
    {(modelosCat?.length ?? 0) === 0 && (
      <p class="text-muted" style="font-size:11px">No hay modelos activos en el roster.</p>
    )}
  </div>

  {/* ── Equipo de producción propuesto (del directorio de proveedores) ── */}
  <div id="equipo" style="margin-bottom:32px">
    <h2 style="margin-bottom:12px">
      Equipo de producción propuesto
      <small class="text-muted" style="font-size:12px;letter-spacing:0;font-family:var(--font-body);text-transform:none">
        {provsPropuestos?.length ?? 0}
      </small>
    </h2>
    {provsPropuestos && provsPropuestos.length > 0 ? (
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px">
        {(provsPropuestos as any[]).map((p) => (
          <div style="display:flex;align-items:center;gap:6px;background:var(--bg-2);border:1px solid var(--border);padding:6px 10px;border-radius:20px;font-size:12px">
            <a href={`/proveedores/personas/${p.proveedor_dir_id}`} style="color:inherit;font-weight:600">{p.nombre}</a>
            {p.tipo && <span class="text-muted">· {p.tipo}</span>}
            {p.rol && p.rol !== p.tipo && <span class="text-muted">· {p.rol}</span>}
            {p.instagram && <span class="text-muted" style="font-size:11px">@{p.instagram.replace(/^@/, '')}</span>}
            {editable && cot.estado !== 'convertida' && (
              <form method="POST" action={`/cotizaciones/${id}`} style="display:inline;margin-left:4px">
                <input type="hidden" name="_action" value="remove_prov_cot" />
                <input type="hidden" name="cp_id" value={p.id} />
                <button type="submit" class="btn btn-sm btn-danger" title="Quitar del equipo"
                        style="padding:1px 6px;font-size:11px;line-height:1;border-radius:50%">×</button>
              </form>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-muted" style="font-size:12px;margin-bottom:12px">Sin equipo propuesto aún. Agrega del directorio abajo.</p>
    )}

    {editable && cot.estado !== 'convertida' && (provDirCat?.length ?? 0) > 0 && (
      <form method="POST" action={`/cotizaciones/${id}`}
            style="display:flex;gap:6px;align-items:flex-end;background:var(--bg-2);border:1px solid var(--border);padding:12px;border-radius:4px"
            id="form_add_prov_cot">
        <input type="hidden" name="_action" value="add_prov_cot" />
        <input type="hidden" name="proveedor_dir_id" id="prov_dir_id_hidden" required />
        <div style="flex:2">
          <label class="label">Buscar proveedor del directorio (fotógrafo, maquillista, catering, etc.)</label>
          <input class="input" id="prov_dir_search" list="dl_provs_directorio" placeholder="Escribe para buscar..." autocomplete="off" required />
          <datalist id="dl_provs_directorio">
            {(provDirCat as any[]).filter((p) => !provPropIds.has(p.id)).map((p) => (
              <option value={p.nombre}>{[p.tipo, p.instagram && '@'+p.instagram.replace(/^@/, '')].filter(Boolean).join(' · ')}</option>
            ))}
          </datalist>
        </div>
        <div style="flex:1">
          <label class="label">Rol (opcional)</label>
          <input class="input" name="rol" placeholder="Ej. Fotografía principal" />
        </div>
        <button type="submit" class="btn btn-primary">+ Agregar</button>
      </form>
    )}

    <script is:inline define:vars={{ provsDisponibles: (provDirCat ?? []).filter((p: any) => !provPropIds.has(p.id)) }}>
      // Resuelve nombre escrito -> id antes del submit (igual que modelos)
      (function () {
        const inp    = document.getElementById('prov_dir_search');
        const hidden = document.getElementById('prov_dir_id_hidden');
        const form   = document.getElementById('form_add_prov_cot');
        if (!inp || !hidden || !form) return;
        const map = new Map();
        provsDisponibles.forEach(function (p) {
          map.set(String(p.nombre).toLowerCase(), p.id);
        });
        function resolve() {
          hidden.value = map.get(String(inp.value || '').trim().toLowerCase()) || '';
        }
        inp.addEventListener('input', resolve);
        inp.addEventListener('change', resolve);
        form.addEventListener('submit', function (e) {
          resolve();
          if (!hidden.value) {
            e.preventDefault();
            alert('Elige un proveedor de la lista (escribe el nombre y selecciona la sugerencia).');
          }
        });
      })();
    </script>

    {(provDirCat?.length ?? 0) === 0 && (
      <p class="text-muted" style="font-size:11px">
        No hay proveedores en el <a href="/proveedores/personas" style="color:var(--gold)">directorio</a>. Da uno de alta primero.
      </p>
    )}
  </div>

  {/* ── Editar cabecera ── */}
  {editable && cot.estado !== 'convertida' && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:32px">
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">Editar datos generales</summary>
      <form method="POST" action={`/cotizaciones/${id}`} style="margin-top:16px">
        <input type="hidden" name="_action" value="edit_header" />
        <label class="label">Título *</label>
        <input class="input" name="titulo" value={cot.titulo} required />
        <div class="row">
          <div class="col">
            <label class="label">Cliente registrado</label>
            <select class="select" name="cliente_id">
              <option value="">— sin asignar —</option>
              {clientes?.map((c: any) => <option value={c.id} selected={cot.cliente_id === c.id}>{c.nombre}</option>)}
            </select>
          </div>
          <div class="col">
            <label class="label">O cliente libre</label>
            <input class="input" name="cliente_libre" value={cot.cliente_libre ?? ''} />
          </div>
          <div class="col">
            <label class="label">Fecha vencimiento</label>
            <input class="input" type="date" name="fecha_vencimiento" value={cot.fecha_vencimiento ?? ''} />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Tipo de producción</label>
            <select class="select" name="tipo">
              <option value="">— sin definir —</option>
              {['editorial','pasarela','campaña','social media','plan district studio','otro'].map((t) => (
                <option value={t} selected={cot.tipo === t}>{t}</option>
              ))}
            </select>
          </div>
          <div class="col">
            <label class="label">Fecha del evento</label>
            <input class="input" type="date" name="fecha_evento" value={cot.fecha_evento ?? ''} />
          </div>
          <div class="col">
            <label class="label">Hora</label>
            <input class="input" type="time" name="hora_evento" value={cot.hora_evento ?? ''} />
          </div>
          <div class="col">
            <label class="label">Ubicación</label>
            <input class="input" name="ubicacion" value={cot.ubicacion ?? ''} placeholder="Ej. District Studio" />
          </div>
        </div>
        <label class="label">Notas para el cliente</label>
        <textarea class="textarea" name="notas">{cot.notas ?? ''}</textarea>
        <label class="label">Notas internas</label>
        <textarea class="textarea" name="notas_internas">{cot.notas_internas ?? ''}</textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Guardar cambios</button>
      </form>
    </details>
  )}

  {cot.notas && (
    <div class="card" style="margin-bottom:24px">
      <div class="card-meta">Notas para el cliente</div>
      <p style="margin-top:8px;white-space:pre-wrap;font-size:14px">{cot.notas}</p>
    </div>
  )}
</Layout>

<script define:vars={{ proveedoresData }}>
// Datos del catálogo inyectados por el servidor
const CATALOGO = proveedoresData;

const fmtMX = (n) => `$${Math.round(n || 0).toLocaleString('es-MX')}`;

// Preview del subtotal + reparto al elegir un concepto del catálogo
function onProvChange() {
  const sel = document.getElementById('sel_prov_cat');
  if (!sel) return;
  const concepto = CATALOGO.find((c) => c.id === sel.value);
  const box = document.getElementById('preview_concepto');
  const cont = document.getElementById('preview_repartos');
  if (!concepto || !box || !cont) {
    if (box) box.style.display = 'none';
    return;
  }

  const precioBase = concepto.precio_mxn || 0;
  const horaAd = concepto.precio_hora_adicional;
  const porHora = horaAd != null && horaAd > 0;

  // Campo Horas SOLO aparece cuando el concepto es de modelos.
  // Para cualquier otro concepto se oculta y horas se ignora (=1).
  const esModelo = /modelo/i.test(String(concepto.rol || '')) || /modelo/i.test(String(concepto.nombre || ''));
  const colHoras = document.getElementById('col_horas_cat');
  if (colHoras) colHoras.style.display = esModelo ? '' : 'none';

  // Labels mas claras cuando es modelo
  const lblCant = document.getElementById('lbl_cantidad_cat');
  const lblHoras = document.getElementById('lbl_horas_cat');
  if (lblCant)  lblCant.textContent  = esModelo ? 'Cantidad de modelos' : 'Cantidad';
  if (lblHoras) lblHoras.textContent = esModelo ? 'Horas de modelo'     : 'Horas';

  let cantidad = parseFloat(document.getElementById('inp_cantidad_cat')?.value || '1') || 1;
  if (cantidad < 1) cantidad = 1;
  // Para modelos siempre usamos las horas capturadas (no dependemos del flag
  // por_hora que puede estar en 0 para algun concepto nuevo).
  let horas = esModelo ? (parseFloat(document.getElementById('inp_horas_cat')?.value || '1') || 1) : 1;
  if (horas < 1) horas = 1;

  // Subtotal: tiered (1ª hora + extras) × cantidad, o precio × cantidad × horas.
  const subtotal = porHora
    ? cantidad * (horas > 1 ? precioBase + (horas - 1) * horaAd : precioBase)
    : precioBase * cantidad * horas;

  let html = '';
  if (porHora && horas > 1) {
    html += `<div style="color:#888;font-size:11px;margin-bottom:6px">${cantidad} × (1ª hora ${fmtMX(precioBase)} + ${horas - 1} h extra a ${fmtMX(horaAd)})</div>`;
  } else {
    html += `<div style="color:#888;font-size:11px;margin-bottom:6px">${cantidad} × ${fmtMX(precioBase)}${horas > 1 ? ` × ${horas} h` : ''}</div>`;
  }

  // Reparto a proveedores (si lo tiene), escalado al subtotal.
  const repartos = concepto.repartos ?? [];
  const sumRep = repartos.reduce((s, r) => s + (r.monto_mxn || 0), 0);
  const factor = precioBase > 0 ? subtotal / precioBase : cantidad * horas;
  for (const r of repartos) {
    html += `<div style="display:flex;justify-content:space-between;padding:2px 0">
      <span>· ${r.proveedor_nombre}${r.rol ? ` <span style="color:#888">(${r.rol})</span>` : ''}</span>
      <span class="mono" style="color:var(--danger,#e25555)">${fmtMX((r.monto_mxn || 0) * factor)}</span></div>`;
  }
  if (repartos.length > 0) {
    html += `<div style="display:flex;justify-content:space-between;padding:6px 0 2px;margin-top:4px;border-top:1px solid var(--border)">
        <span style="color:var(--gold)">Utilidad FC Agency</span>
        <span class="mono" style="color:var(--text-ok,#4ade80)">${fmtMX(subtotal - sumRep * factor)}</span></div>`;
  }
  html += `<div style="display:flex;justify-content:space-between;padding:2px 0;font-weight:600">
      <span>Subtotal de la línea</span>
      <span class="mono" style="color:var(--gold)">${fmtMX(subtotal)}</span></div>`;
  cont.innerHTML = html;
  box.style.display = 'block';
}

// Init: sincronizar el form al cargar (por si el browser recuerda el ultimo
// valor del select), asi el campo Horas aparece de entrada cuando aplica
// y los labels se actualizan sin requerir interaccion.
if (typeof document !== 'undefined') {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onProvChange);
  } else {
    onProvChange();
  }
}

// Utilidad en vivo en el form manual
function calcUtilManual() {
  const base = parseFloat(document.getElementById('inp_base')?.value || '0') || 0;
  const cant = parseFloat(document.getElementById('inp_cant')?.value || '1') || 1;
  const horas = parseFloat(document.getElementById('inp_horas')?.value || '1') || 1;
  const subtotal = base * cant * horas;
  const pagoRaw = document.getElementById('inp_pago')?.value;
  const pago = pagoRaw === '' || pagoRaw == null ? Math.round(subtotal * 0.8) : (parseFloat(pagoRaw) || 0);
  const out = document.getElementById('util_manual');
  if (out) out.textContent = subtotal > 0 ? `Subtotal ${fmtMX(subtotal)} · Utilidad FC ${fmtMX(subtotal - pago)}` : '';
}
</script>
