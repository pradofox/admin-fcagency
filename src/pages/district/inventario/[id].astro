---
import Layout from '../../../components/Layout.astro';
import DistrictNav from '../../../components/DistrictNav.astro';
import { requireUser, canEdit } from '../../../lib/session';
import { getDB, now } from '../../../lib/db';
import { newId } from '../../../lib/ids';
import { formatFecha } from '../../../lib/fechas';

const user = requireUser(Astro);
const editable = canEdit(user);
const db = getDB(Astro);
const { id } = Astro.params;

let saved = false;
let error: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const method = form.get('_method');
  const action = form.get('_action');

  if (method === 'DELETE') {
    await db.prepare('DELETE FROM inventario_district WHERE id = ?').bind(id).run();
    return Astro.redirect('/district/inventario');
  }

  if (action === 'registrar_movimiento') {
    const tipo = form.get('tipo_mov') as string;
    const cant = Number(form.get('cantidad')) || 1;
    const fecha = (form.get('fecha') as string) || new Date().toISOString().slice(0, 10);
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    const item = await db.prepare('SELECT cantidad_disponible, cantidad_total, estado FROM inventario_district WHERE id = ?').bind(id).first<any>();
    if (!item) {
      error = 'Item inválido.';
    } else {
      let nuevaDisp = item.cantidad_disponible;
      let nuevoEstado = item.estado;
      if (tipo === 'salida' || tipo === 'prestamo') {
        nuevaDisp -= cant;
        if (nuevaDisp < 0) {
          error = 'No hay suficiente disponible.';
        }
        if (tipo === 'prestamo' && nuevaDisp >= 0) nuevoEstado = 'prestado';
      } else if (tipo === 'entrada' || tipo === 'devolucion') {
        nuevaDisp += cant;
        if (nuevaDisp > item.cantidad_total) nuevaDisp = item.cantidad_total;
        if (nuevaDisp === item.cantidad_total) nuevoEstado = 'disponible';
      } else if (tipo === 'mantenimiento') {
        nuevoEstado = 'mantenimiento';
      } else if (tipo === 'baja') {
        nuevoEstado = 'roto';
      }
      if (!error) {
        const ts = now();
        await db
          .prepare(
            `INSERT INTO movimientos_inventario (
              id, item_id, tipo, cantidad, fecha, fecha_devolucion_esperada,
              persona, miembro_id, produccion_id, notas, registrado_por, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
          )
          .bind(newId(), id, tipo, cant, fecha, get('fecha_devolucion_esperada'), get('persona'), get('miembro_id'), get('produccion_id'), get('notas'), user.id, ts)
          .run();
        await db
          .prepare('UPDATE inventario_district SET cantidad_disponible = ?, estado = ?, updated_at = ? WHERE id = ?')
          .bind(nuevaDisp, nuevoEstado, ts, id)
          .run();
        return Astro.redirect(`/district/inventario/${id}`);
      }
    }
  }

  if (!action) {
    const nombre = (form.get('nombre') as string)?.trim();
    if (!nombre) {
      error = 'Nombre obligatorio.';
    } else {
      const get = (k: string) => {
        const v = form.get(k);
        return v === null || v === '' ? null : String(v).trim();
      };
      const num = (k: string) => {
        const v = form.get(k);
        if (v === null || v === '') return null;
        const n = Number(v);
        return Number.isFinite(n) ? n : null;
      };
      await db
        .prepare(
          `UPDATE inventario_district SET nombre = ?, categoria = ?, marca = ?, modelo = ?, serial = ?,
                  ubicacion = ?, valor_mxn = ?, notas = ?, updated_at = ?
           WHERE id = ?`
        )
        .bind(nombre, get('categoria'), get('marca'), get('modelo'), get('serial'), get('ubicacion'), num('valor_mxn'), get('notas'), now(), id)
        .run();
      saved = true;
    }
  }
}

const item = await db.prepare('SELECT * FROM inventario_district WHERE id = ?').bind(id).first<any>();
if (!item) return Astro.redirect('/district/inventario');

const { results: movimientos } = await db
  .prepare(
    `SELECT mv.*, u.nombre as registrado_por_nombre, mi.nombre as miembro_nombre, p.titulo as produccion_titulo
     FROM movimientos_inventario mv
     LEFT JOIN users u ON u.id = mv.registrado_por
     LEFT JOIN miembros_district mi ON mi.id = mv.miembro_id
     LEFT JOIN producciones p ON p.id = mv.produccion_id
     WHERE mv.item_id = ?
     ORDER BY mv.fecha DESC, mv.created_at DESC LIMIT 100`
  )
  .bind(id)
  .all<any>();

const { results: miembros } = await db
  .prepare("SELECT id, nombre FROM miembros_district WHERE activo = 1 ORDER BY nombre")
  .all<{ id: string; nombre: string }>();

const { results: producciones } = await db
  .prepare("SELECT id, titulo FROM producciones WHERE estado != 'cancelada' ORDER BY fecha_inicio DESC LIMIT 50")
  .all<{ id: string; titulo: string }>();

const estadoColor: Record<string, string> = {
  disponible: 'chip-ok',
  prestado: 'chip-warning',
  mantenimiento: 'chip',
  roto: 'chip-danger'
};

const tipoMovColor: Record<string, string> = {
  entrada: 'chip-ok',
  salida: 'chip-warning',
  prestamo: 'chip-warning',
  devolucion: 'chip-ok',
  mantenimiento: 'chip',
  baja: 'chip-danger'
};

const todayISO = new Date().toISOString().slice(0, 10);
---

<Layout title={item.nombre} pageTitle="District Studio">
  <div class="page-head">
    <h1>{item.nombre}</h1>
    <div style="display:flex;gap:8px">
      <a href="/district/inventario" class="btn btn-sm">Volver</a>
      {editable && (
        <form method="POST" action={`/district/inventario/${id}`} onsubmit="return confirm('¿Eliminar este item y su historial?')" style="display:inline">
          <input type="hidden" name="_method" value="DELETE" />
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      )}
    </div>
  </div>
  <DistrictNav />

  {saved && <p class="text-ok" style="margin-bottom:16px">Guardado.</p>}
  {error && <p class="text-danger" style="margin-bottom:16px">{error}</p>}

  <div class="row" style="margin-bottom:24px">
    <div class="col card">
      <div class="card-meta">Estado</div>
      <div class="card-title"><span class={`chip ${estadoColor[item.estado] ?? ''}`}>{item.estado}</span></div>
    </div>
    <div class="col card">
      <div class="card-meta">Disponible</div>
      <div class="card-title mono">{item.cantidad_disponible} / {item.cantidad_total}</div>
    </div>
    <div class="col card">
      <div class="card-meta">Ubicación</div>
      <div class="card-title">{item.ubicacion ?? '—'}</div>
    </div>
    {item.valor_mxn && (
      <div class="col card">
        <div class="card-meta">Valor</div>
        <div class="card-title mono">${Math.round(item.valor_mxn).toLocaleString('es-MX')}</div>
      </div>
    )}
  </div>

  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:24px">
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Registrar movimiento</summary>
      <form method="POST" action={`/district/inventario/${id}`} style="margin-top:16px">
        <input type="hidden" name="_action" value="registrar_movimiento" />
        <div class="row">
          <div class="col">
            <label class="label">Tipo *</label>
            <select class="select" name="tipo_mov" required>
              <option value="prestamo">Préstamo (sale)</option>
              <option value="devolucion">Devolución (regresa)</option>
              <option value="salida">Salida definitiva</option>
              <option value="entrada">Entrada (compra/agrega)</option>
              <option value="mantenimiento">A mantenimiento</option>
              <option value="baja">Baja / roto</option>
            </select>
          </div>
          <div class="col">
            <label class="label">Cantidad</label>
            <input class="input" type="number" name="cantidad" value="1" min="1" />
          </div>
          <div class="col">
            <label class="label">Fecha</label>
            <input class="input" type="date" name="fecha" value={todayISO} />
          </div>
          <div class="col">
            <label class="label">Devolución esperada</label>
            <input class="input" type="date" name="fecha_devolucion_esperada" />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Persona (texto libre)</label>
            <input class="input" name="persona" placeholder="Nombre" />
          </div>
          <div class="col">
            <label class="label">o Miembro</label>
            <select class="select" name="miembro_id">
              <option value="">—</option>
              {miembros?.map((m) => <option value={m.id}>{m.nombre}</option>)}
            </select>
          </div>
          <div class="col">
            <label class="label">Producción (opcional)</label>
            <select class="select" name="produccion_id">
              <option value="">—</option>
              {producciones?.map((p) => <option value={p.id}>{p.titulo}</option>)}
            </select>
          </div>
        </div>
        <label class="label">Notas</label>
        <textarea class="textarea" name="notas"></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Registrar movimiento</button>
      </form>
    </details>
  )}

  <h2>Historial de movimientos</h2>
  {movimientos && movimientos.length > 0 ? (
    <div class="table-card" style="margin-bottom:32px">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Tipo</th><th class="right">Cant</th><th>Persona/Miembro</th><th>Producción</th><th>Notas</th></tr>
        </thead>
        <tbody>
          {movimientos.map((m: any) => (
            <tr>
              <td class="mono">{formatFecha(m.fecha)}</td>
              <td><span class={`chip ${tipoMovColor[m.tipo] ?? ''}`}>{m.tipo}</span></td>
              <td class="right mono">{m.cantidad}</td>
              <td>{m.miembro_nombre ?? m.persona ?? <span class="text-muted">—</span>}</td>
              <td>{m.produccion_titulo ? <a href={`/producciones/${m.produccion_id}`} style="color:var(--gold)">{m.produccion_titulo}</a> : <span class="text-muted">—</span>}</td>
              <td><small class="text-muted">{m.notas ?? ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="text-muted" style="margin-bottom:32px">Sin movimientos registrados.</p>
  )}

  <h2>Datos del item</h2>
  <form method="POST" action={`/district/inventario/${id}`}>
    <div class="row">
      <div class="col">
        <label class="label">Nombre *</label>
        <input class="input" name="nombre" value={item.nombre} required />
      </div>
      <div class="col">
        <label class="label">Categoría</label>
        <input class="input" name="categoria" value={item.categoria ?? ''} />
      </div>
      <div class="col">
        <label class="label">Marca</label>
        <input class="input" name="marca" value={item.marca ?? ''} />
      </div>
      <div class="col">
        <label class="label">Modelo</label>
        <input class="input" name="modelo" value={item.modelo ?? ''} />
      </div>
    </div>
    <div class="row">
      <div class="col">
        <label class="label">Serial</label>
        <input class="input" name="serial" value={item.serial ?? ''} />
      </div>
      <div class="col">
        <label class="label">Ubicación</label>
        <input class="input" name="ubicacion" value={item.ubicacion ?? ''} />
      </div>
      <div class="col">
        <label class="label">Valor MXN</label>
        <input class="input" type="number" step="0.01" name="valor_mxn" value={item.valor_mxn ?? ''} />
      </div>
    </div>
    <label class="label">Notas</label>
    <textarea class="textarea" name="notas">{item.notas ?? ''}</textarea>
    {editable && <div class="form-actions"><button type="submit" class="btn btn-primary">Guardar cambios</button></div>}
  </form>
</Layout>
