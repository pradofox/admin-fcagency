---
import Layout from '../../../components/Layout.astro';
import DistrictNav from '../../../components/DistrictNav.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../../lib/session';
import { getDB } from '../../../lib/db';
import { formatFecha } from '../../../lib/fechas';

const user = requireUser(Astro);
const db = getDB(Astro);

const filtro = Astro.url.searchParams.get('filtro') ?? 'todos';
const search = (Astro.url.searchParams.get('q') ?? '').trim();
const todayISO = new Date().toISOString().slice(0, 10);
const in7 = new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10);

const base = `SELECT mi.id, mi.nombre, mi.email, mi.whatsapp, mi.empresa, mi.activo,
                     m.fecha_proximo_pago, m.estado as membresia_estado,
                     p.nombre as plan_nombre, p.precio_mxn
              FROM miembros_district mi
              LEFT JOIN membresias_district m ON m.miembro_id = mi.id AND m.estado = 'activa'
              LEFT JOIN planes_district p ON p.id = m.plan_id`;

const where: string[] = [];
const binds: any[] = [];
if (search) {
  const like = `%${search}%`;
  where.push('(mi.nombre LIKE ? OR mi.email LIKE ? OR mi.whatsapp LIKE ? OR mi.empresa LIKE ?)');
  binds.push(like, like, like, like);
}
if (filtro === 'activos') where.push('mi.activo = 1');
if (filtro === 'inactivos') where.push('mi.activo = 0');
if (filtro === 'vencidos') {
  where.push("m.estado = 'activa' AND m.fecha_proximo_pago < ?");
  binds.push(todayISO);
}
if (filtro === 'proximos') {
  where.push("m.estado = 'activa' AND m.fecha_proximo_pago BETWEEN ? AND ?");
  binds.push(todayISO, in7);
}
if (filtro === 'sin_membresia') where.push('m.id IS NULL');

const sql = `${base}${where.length ? ' WHERE ' + where.join(' AND ') : ''} ORDER BY mi.activo DESC, mi.nombre LIMIT 300`;
const { results: miembros } = await db.prepare(sql).bind(...binds).all<any>();

const filtros = [
  { v: 'todos', label: 'todos' },
  { v: 'activos', label: 'activos' },
  { v: 'inactivos', label: 'inactivos' },
  { v: 'vencidos', label: 'pago vencido' },
  { v: 'proximos', label: 'pago próximo (7d)' },
  { v: 'sin_membresia', label: 'sin membresía' }
];
---

<Layout title="District — Miembros" pageTitle="District Studio">
  <div class="page-head">
    <h1>Miembros</h1>
    {canEdit(user) && <a href="/district/miembros/nuevo" class="btn btn-primary">+ Nuevo miembro</a>}
  </div>
  <DistrictNav />

  <form method="GET" action="/district/miembros" class="toolbar">
    <input class="input" type="search" name="q" value={search} placeholder="Buscar por nombre, email, whatsapp, empresa…" />
    {filtro !== 'todos' && <input type="hidden" name="filtro" value={filtro} />}
  </form>

  <div class="filters" style="margin-bottom:24px">
    {filtros.map((f) => (
      <a href={`/district/miembros?filtro=${f.v}${search ? '&q=' + encodeURIComponent(search) : ''}`} class={`filter-chip ${filtro === f.v ? 'active' : ''}`}>{f.label}</a>
    ))}
  </div>

  {miembros && miembros.length > 0 ? (
    <div class="grid">
      {miembros.map((m: any) => {
        const venc = m.fecha_proximo_pago && m.fecha_proximo_pago < todayISO;
        return (
          <a href={`/district/miembros/${m.id}`} class="card" style={`display:block;color:inherit;text-decoration:none;${m.activo ? '' : 'opacity:.5;'}${venc ? 'border-left:3px solid var(--danger,#e25555)' : ''}`}>
            <div class="card-title">{m.nombre}</div>
            <div class="card-meta">
              {!m.activo && <span class="chip">inactivo</span>}
              {m.empresa && <span class="chip">{m.empresa}</span>}
              {m.email && <span class="text-muted">{m.email}</span>}
              {m.whatsapp && <span class="text-muted">{m.whatsapp}</span>}
            </div>
            <div class="card-meta" style="margin-top:8px;border-top:1px solid var(--border);padding-top:8px">
              {m.plan_nombre ? (
                <>
                  <span><strong>{m.plan_nombre}</strong></span>
                  <span class="mono" style={venc ? 'color:var(--danger,#e25555)' : 'color:var(--gold)'}>{formatFecha(m.fecha_proximo_pago)}</span>
                </>
              ) : (
                <span class="text-muted">Sin membresía vigente</span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <EmptyState title="Sin miembros" message="Agrega el primer miembro para empezar." />
  )}
</Layout>
