---
import Layout from '../../../components/Layout.astro';
import DistrictNav from '../../../components/DistrictNav.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../../lib/session';
import { getDB, now } from '../../../lib/db';
import { newId } from '../../../lib/ids';
import { formatFecha, addMinutes } from '../../../lib/fechas';

const user = requireUser(Astro);
const editable = canEdit(user);
const db = getDB(Astro);

const HORA_APERTURA = '08:00';
const HORA_CIERRE   = '21:00';
const GAP_MIN       = 30;

const todayISO = new Date().toISOString().slice(0, 10);

let error: string | null = null;
let vencidaMiembroId: string | null = null;
let vencidaNombre: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form       = await Astro.request.formData();
  const fecha      = (form.get('fecha')       as string)?.trim();
  const horaInicio = (form.get('hora_inicio') as string)?.trim();
  const horaFin    = (form.get('hora_fin')    as string)?.trim();
  const miembroId  = (form.get('miembro_id')  as string)?.trim() || null;

  if (!fecha || !horaInicio || !horaFin) {
    error = 'Fecha, hora inicio y hora fin son obligatorios.';
  } else if (horaInicio < HORA_APERTURA || horaFin > HORA_CIERRE) {
    error = `El estudio solo está disponible de ${HORA_APERTURA} a ${HORA_CIERRE} h.`;
  } else if (horaFin <= horaInicio) {
    error = 'La hora de fin debe ser posterior al inicio.';
  } else {
    // Verificar membresia del miembro (no aplica a clientes libres)
    if (miembroId) {
      const mem = await db
        .prepare(`SELECT mb.id, mb.fecha_proximo_pago, p.tipo as plan_tipo, p.nombre as plan_nombre
                  FROM membresias_district mb
                  LEFT JOIN planes_district p ON p.id = mb.plan_id
                  WHERE mb.miembro_id = ? AND mb.estado = 'activa' LIMIT 1`)
        .bind(miembroId)
        .first<any>();
      const miembroRow = await db.prepare('SELECT nombre FROM miembros_district WHERE id = ?').bind(miembroId).first<any>();
      const nombreMiembro = miembroRow?.nombre ?? 'Este miembro';

      if (!mem) {
        error = `${nombreMiembro} no tiene membresía activa. Asigna una antes de reservar.`;
      } else if (mem.fecha_proximo_pago < todayISO) {
        vencidaMiembroId = miembroId;
        vencidaNombre    = nombreMiembro;
        error = `La membresía de ${vencidaNombre} está vencida.`;
      } else if (mem.plan_tipo !== 'estudio' && mem.plan_tipo !== 'cowork') {
        error = `${nombreMiembro} tiene membresía "${mem.plan_nombre}" (${mem.plan_tipo ?? 'sin tipo'}) — el estudio solo es accesible con membresía de estudio o cowork.`;
      }
    }

    if (!error) {
      // Conflicto con gap de 30 min
      const nfBuf     = addMinutes(horaFin,    GAP_MIN);
      const nsMinus30 = addMinutes(horaInicio, -GAP_MIN);
      const conflict  = await db
        .prepare(
          `SELECT id FROM reservas_estudio
           WHERE fecha = ? AND estado != 'cancelada'
             AND hora_inicio < ? AND hora_fin > ?
           LIMIT 1`
        )
        .bind(fecha, nfBuf, nsMinus30)
        .first<any>();

      if (conflict) {
        error = `Horario no disponible. Se requieren ${GAP_MIN} min de margen entre producciones.`;
      } else {
        const get = (k: string) => {
          const v = form.get(k);
          return v === null || v === '' ? null : String(v).trim();
        };
        const num = (k: string) => {
          const v = form.get(k);
          if (v === null || v === '') return null;
          const n = Number(v);
          return Number.isFinite(n) ? n : null;
        };
        const id = newId();
        const ts = now();
        await db
          .prepare(
            `INSERT INTO reservas_estudio (
              id, fecha, hora_inicio, hora_fin, tipo, miembro_id, cliente_libre, contacto_whatsapp,
              estado, precio_mxn, pagado, notas, created_by, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'confirmada', ?, 0, ?, ?, ?, ?)`
          )
          .bind(id, fecha, horaInicio, horaFin, get('tipo') ?? 'foto', miembroId, get('cliente_libre'), get('contacto_whatsapp'), num('precio_mxn'), get('notas'), user.id, ts, ts)
          .run();
        return Astro.redirect(`/district/estudio/${id}`);
      }
    }
  }
}

const filtro = Astro.url.searchParams.get('filtro') ?? 'proximas';
const tipo   = Astro.url.searchParams.get('tipo') ?? '';

const where: string[] = [];
const binds: any[] = [];
if (filtro === 'proximas')  { where.push('r.fecha >= ?'); binds.push(todayISO); }
if (filtro === 'pasadas')   { where.push('r.fecha < ?');  binds.push(todayISO); }
if (filtro === 'sin_pagar') { where.push("r.pagado = 0 AND r.estado != 'cancelada'"); }
if (tipo) { where.push('r.tipo = ?'); binds.push(tipo); }

const sql = `SELECT r.id, r.fecha, r.hora_inicio, r.hora_fin, r.tipo, r.cliente_libre, r.estado, r.precio_mxn, r.pagado,
                    mi.nombre as miembro_nombre
             FROM reservas_estudio r
             LEFT JOIN miembros_district mi ON mi.id = r.miembro_id
             ${where.length ? 'WHERE ' + where.join(' AND ') : ''}
             ORDER BY r.fecha ${filtro === 'pasadas' ? 'DESC' : 'ASC'}, r.hora_inicio ASC
             LIMIT 200`;

const { results: reservas } = await db.prepare(sql).bind(...binds).all<any>();

// Dropdown con status de membresia y tipo de plan visible
const { results: miembros } = await db
  .prepare(
    `SELECT mi.id, mi.nombre, mi.numero_membresia,
            mb.fecha_proximo_pago as mem_vence,
            p.tipo as plan_tipo, p.nombre as plan_nombre
     FROM miembros_district mi
     LEFT JOIN membresias_district mb ON mb.miembro_id = mi.id AND mb.estado = 'activa'
     LEFT JOIN planes_district p ON p.id = mb.plan_id
     WHERE mi.activo = 1
     ORDER BY mi.nombre`
  )
  .all<any>();
---

<Layout title="Estudio foto/video" pageTitle="District Studio">
  <div class="page-head">
    <h1>Estudio foto/video</h1>
    <small class="text-muted" style="font-size:12px">{HORA_APERTURA}-{HORA_CIERRE} h &nbsp;&middot;&nbsp; gap {GAP_MIN} min entre producciones</small>
  </div>
  <DistrictNav />

  {error && (
    <div class="text-danger" style="margin-bottom:16px;padding:12px;border:1px solid var(--danger,#e25555);border-radius:4px">
      {error}
      {vencidaMiembroId && (
        <span style="margin-left:12px">
          <a href={`/district/miembros/${vencidaMiembroId}`} class="btn btn-sm btn-primary">Ir a pago de membresía</a>
        </span>
      )}
    </div>
  )}

  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:24px" open={!!error}>
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Nueva reserva</summary>
      <form method="POST" action="/district/estudio" style="margin-top:16px">
        <div class="row">
          <div class="col">
            <label class="label">Fecha *</label>
            <input class="input" type="date" name="fecha" required value={todayISO} />
          </div>
          <div class="col">
            <label class="label">Hora inicio * <small class="text-muted">(desde {HORA_APERTURA})</small></label>
            <input class="input" type="time" name="hora_inicio" required min={HORA_APERTURA} max={HORA_CIERRE} />
          </div>
          <div class="col">
            <label class="label">Hora fin * <small class="text-muted">(hasta {HORA_CIERRE})</small></label>
            <input class="input" type="time" name="hora_fin" required min={HORA_APERTURA} max={HORA_CIERRE} />
          </div>
          <div class="col">
            <label class="label">Tipo</label>
            <select class="select" name="tipo">
              <option value="foto">Foto</option>
              <option value="video">Video</option>
              <option value="ambos">Ambos</option>
            </select>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Miembro <small class="text-muted">(solo estudio o cowork)</small></label>
            <select class="select" name="miembro_id" id="sel_miembro" onchange="calcPrecioEstudio()">
              <option value="" data-tipo="">— sin asignar (externo) —</option>
              {miembros?.map((m: any) => {
                const vencida  = m.mem_vence && m.mem_vence < todayISO;
                const sinMem   = !m.mem_vence;
                const planInfo = m.plan_tipo ? ` [${m.plan_tipo}]` : ' — sin membresía';
                const estado   = vencida ? ' ⚠ VENCIDA' : sinMem ? '' : ' ✓';
                const label    = `${m.nombre}${m.numero_membresia ? ' (' + m.numero_membresia + ')' : ''}${planInfo}${estado}`;
                return <option value={m.id} data-tipo={m.plan_tipo ?? ''}>{label}</option>;
              })}
            </select>
          </div>
          <div class="col">
            <label class="label">O cliente externo</label>
            <input class="input" name="cliente_libre" placeholder="Si no es miembro" />
          </div>
          <div class="col">
            <label class="label">WhatsApp contacto</label>
            <input class="input" name="contacto_whatsapp" />
          </div>
          <div class="col">
            <label class="label">Precio MXN <small class="text-muted" id="hint_precio">(externo $800/hr)</small></label>
            <input class="input" type="number" step="1" name="precio_mxn" id="inp_precio" placeholder="0" />
          </div>
        </div>
        <label class="label">Notas</label>
        <textarea class="textarea" name="notas"></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Crear reserva</button>
      </form>
    </details>
  )}

  <script>
  function calcPrecioEstudio() {
    const sel   = document.getElementById('sel_miembro') as HTMLSelectElement | null;
    const hint  = document.getElementById('hint_precio');
    const inp   = document.getElementById('inp_precio') as HTMLInputElement | null;
    if (!sel || !inp) return;

    const tipo      = sel.selectedOptions[0]?.dataset.tipo ?? '';
    const tarifaHr  = tipo === 'cowork' ? 700 : 800;
    const label     = tipo === 'estudio' ? 'membresía incluye horas — solo cobrar extras'
                    : tipo === 'cowork'  ? `cowork $${tarifaHr}/hr`
                    : `externo $${tarifaHr}/hr`;
    if (hint) hint.textContent = label;

    // Auto-calcular si ya hay horas seleccionadas
    const inicio = (document.querySelector('input[name="hora_inicio"]') as HTMLInputElement)?.value;
    const fin    = (document.querySelector('input[name="hora_fin"]')    as HTMLInputElement)?.value;
    if (inicio && fin && inicio < fin) {
      const [hi, mi] = inicio.split(':').map(Number);
      const [hf, mf] = fin.split(':').map(Number);
      const hrs = ((hf * 60 + mf) - (hi * 60 + mi)) / 60;
      if (tipo !== 'estudio') {
        inp.value = String(Math.round(hrs * tarifaHr));
      } else {
        // Membresía de estudio — horas ya pagadas, sugiere 0
        inp.value = '0';
      }
    }
  }

  // También recalcular cuando cambian las horas
  document.querySelectorAll('input[name="hora_inicio"], input[name="hora_fin"]').forEach((el) => {
    el.addEventListener('change', calcPrecioEstudio);
  });
  </script>

  <div class="filters" style="margin-bottom:8px">
    {[
      { v: 'proximas',  label: 'proximas' },
      { v: 'pasadas',   label: 'pasadas' },
      { v: 'sin_pagar', label: 'sin pagar' },
      { v: 'todas',     label: 'todas' }
    ].map((f) => (
      <a href={`/district/estudio?filtro=${f.v}${tipo ? '&tipo=' + tipo : ''}`} class={`filter-chip ${filtro === f.v ? 'active' : ''}`}>{f.label}</a>
    ))}
  </div>

  <div class="filters" style="margin-bottom:24px">
    {[
      { v: '',      label: 'todos' },
      { v: 'foto',  label: 'foto' },
      { v: 'video', label: 'video' },
      { v: 'ambos', label: 'ambos' }
    ].map((t) => (
      <a href={`/district/estudio?filtro=${filtro}${t.v ? '&tipo=' + t.v : ''}`} class={`filter-chip ${tipo === t.v ? 'active' : ''}`}>{t.label}</a>
    ))}
  </div>

  {reservas && reservas.length > 0 ? (
    <div>
      {reservas.map((r: any) => (
        <a href={`/district/estudio/${r.id}`} class="card" style={`display:block;color:inherit;text-decoration:none;margin-bottom:8px;${r.estado === 'cancelada' ? 'opacity:.4' : ''}`}>
          <div style="display:flex;justify-content:space-between;gap:14px;align-items:center">
            <div style="flex:1;min-width:0">
              <div style="font-weight:500">{r.miembro_nombre ?? r.cliente_libre ?? '—'}</div>
              <div class="card-meta" style="margin-top:4px">
                <span class="chip">{r.tipo}</span>
                <span class="mono">{formatFecha(r.fecha)} {r.hora_inicio}-{r.hora_fin}</span>
                {r.precio_mxn && <span class="text-gold mono">${Math.round(r.precio_mxn).toLocaleString('es-MX')}</span>}
                {r.precio_mxn && <span class={`chip ${r.pagado ? 'chip-ok' : 'chip-warning'}`}>{r.pagado ? 'pagado' : 'por pagar'}</span>}
                {r.estado === 'cancelada' && <span class="chip chip-danger">cancelada</span>}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <EmptyState title="Sin reservas" message="No hay reservas con estos filtros." />
  )}
</Layout>
