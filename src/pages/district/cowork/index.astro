---
import Layout from '../../../components/Layout.astro';
import DistrictNav from '../../../components/DistrictNav.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../../lib/session';
import { getDB, now } from '../../../lib/db';
import { newId } from '../../../lib/ids';
import { formatFecha, esFindeSemana } from '../../../lib/fechas';

const user = requireUser(Astro);
const editable = canEdit(user);
const db = getDB(Astro);

const HORA_APERTURA  = '09:00';
const HORA_CIERRE    = '21:00';
const MAX_HOT_DESK   = 12;

const todayISO = new Date().toISOString().slice(0, 10);

let error: string | null = null;
let vencidaMiembroId: string | null = null;
let vencidaNombre: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form  = await Astro.request.formData();
  const fecha = (form.get('fecha') as string)?.trim();
  const horaInicio = (form.get('hora_inicio') as string)?.trim();
  const horaFin    = (form.get('hora_fin')    as string)?.trim();
  const espacio    = (form.get('espacio') as string) ?? 'hot_desk';
  const miembroId  = (form.get('miembro_id') as string)?.trim() || null;

  if (!fecha || !horaInicio || !horaFin) {
    error = 'Fecha, hora inicio y hora fin son obligatorios.';
  } else if (esFindeSemana(fecha)) {
    error = 'Hot desk y sala de juntas solo disponibles de lunes a viernes.';
  } else if (horaInicio < HORA_APERTURA || horaFin > HORA_CIERRE) {
    error = `Horario de cowork: ${HORA_APERTURA} a ${HORA_CIERRE} h, lunes a viernes.`;
  } else if (horaFin <= horaInicio) {
    error = 'La hora de fin debe ser posterior al inicio.';
  } else {
    // Verificar membresia del miembro si aplica
    if (miembroId) {
      const mem = await db
        .prepare("SELECT id, fecha_proximo_pago FROM membresias_district WHERE miembro_id = ? AND estado = 'activa' LIMIT 1")
        .bind(miembroId)
        .first<any>();
      if (!mem) {
        const row = await db.prepare('SELECT nombre FROM miembros_district WHERE id = ?').bind(miembroId).first<any>();
        error = `${row?.nombre ?? 'Este miembro'} no tiene membresía activa.`;
      } else if (mem.fecha_proximo_pago < todayISO) {
        const row = await db.prepare('SELECT nombre FROM miembros_district WHERE id = ?').bind(miembroId).first<any>();
        vencidaMiembroId = miembroId;
        vencidaNombre    = row?.nombre ?? 'El miembro';
        error = `La membresía de ${vencidaNombre} está vencida.`;
      }
    }

    if (!error && espacio === 'sala_juntas') {
      const conflict = await db
        .prepare(
          `SELECT id FROM reservas_cowork
           WHERE fecha = ? AND espacio = 'sala_juntas'
             AND hora_inicio < ? AND hora_fin > ?
           LIMIT 1`
        )
        .bind(fecha, horaFin, horaInicio)
        .first<any>();
      if (conflict) {
        error = 'La sala de juntas ya esta reservada en ese horario.';
      }
    } else if (!error && espacio === 'hot_desk') {
      // Las membresías son individuales: si hay miembro, siempre ocupa 1 lugar
      const personasNuevas = miembroId ? 1 : Math.max(1, Number(form.get('capacidad') ?? 1) || 1);
      const row = await db
        .prepare(
          `SELECT COALESCE(SUM(COALESCE(capacidad, 1)), 0) as ocupados FROM reservas_cowork
           WHERE fecha = ? AND espacio = 'hot_desk'
             AND hora_inicio < ? AND hora_fin > ?`
        )
        .bind(fecha, horaFin, horaInicio)
        .first<any>();
      const ocupados = row?.ocupados ?? 0;
      if (ocupados + personasNuevas > MAX_HOT_DESK) {
        const libres = MAX_HOT_DESK - ocupados;
        error = libres <= 0
          ? `Aforo completo — no hay lugares disponibles en ese horario.`
          : `Solo quedan ${libres} lugar${libres !== 1 ? 'es' : ''} en ese horario (máx ${MAX_HOT_DESK}).`;
      }
    }
  }

  if (!error) {
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    // Membresía = individual, siempre 1 persona
    const capacidadFinal = miembroId ? 1 : (Number(form.get('capacidad') ?? 1) || 1);
    const id = newId();
    const ts = now();
    await db
      .prepare(
        `INSERT INTO reservas_cowork (
          id, fecha, hora_inicio, hora_fin, tipo, espacio, titulo, miembro_id, invitado_libre,
          capacidad, notas, created_by, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
      )
      .bind(id, fecha, horaInicio, horaFin, get('tipo') ?? 'visita', espacio, get('titulo'), get('miembro_id'), get('invitado_libre'), capacidadFinal, get('notas'), user.id, ts, ts)
      .run();
    return Astro.redirect(`/district/cowork/${id}`);
  }
}

const filtro        = Astro.url.searchParams.get('filtro')  ?? 'proximas';
const espacioFiltro = Astro.url.searchParams.get('espacio') ?? '';

const where: string[] = [];
const binds: any[] = [];
if (filtro === 'proximas') { where.push('r.fecha >= ?'); binds.push(todayISO); }
if (filtro === 'pasadas')  { where.push('r.fecha < ?');  binds.push(todayISO); }
if (espacioFiltro) { where.push('r.espacio = ?'); binds.push(espacioFiltro); }

const sql = `SELECT r.id, r.fecha, r.hora_inicio, r.hora_fin, r.tipo, r.espacio, r.titulo, r.invitado_libre, r.capacidad,
                    mi.nombre as miembro_nombre
             FROM reservas_cowork r
             LEFT JOIN miembros_district mi ON mi.id = r.miembro_id
             ${where.length ? 'WHERE ' + where.join(' AND ') : ''}
             ORDER BY r.fecha ${filtro === 'pasadas' ? 'DESC' : 'ASC'}, r.hora_inicio ASC
             LIMIT 200`;

const { results: reservas } = await db.prepare(sql).bind(...binds).all<any>();

const { results: miembros } = await db
  .prepare(
    `SELECT mi.id, mi.nombre, mi.numero_membresia,
            mb.fecha_proximo_pago as mem_vence
     FROM miembros_district mi
     LEFT JOIN membresias_district mb ON mb.miembro_id = mi.id AND mb.estado = 'activa'
     WHERE mi.activo = 1
     ORDER BY mi.nombre`
  )
  .all<any>();

const TIPOS_COWORK = [
  { v: 'visita',            label: 'Visita' },
  { v: 'evento_comunidad',  label: 'Evento comunidad' },
  { v: 'after_office',      label: 'After office' },
  { v: 'actividad_interna', label: 'Actividad interna' },
  { v: 'club',              label: 'Club' }
];
---

<Layout title="Cowork" pageTitle="District Studio">
  <div class="page-head">
    <h1>Cowork</h1>
    <small class="text-muted" style="font-size:12px">Lun-Vie {HORA_APERTURA}-{HORA_CIERRE} h &nbsp;&middot;&nbsp; hot desk max {MAX_HOT_DESK} personas &nbsp;&middot;&nbsp; 1 sala de juntas</small>
  </div>
  <DistrictNav />

  {error && (
    <div class="text-danger" style="margin-bottom:16px;padding:12px;border:1px solid var(--danger,#e25555);border-radius:4px">
      {error}
      {vencidaMiembroId && (
        <span style="margin-left:12px">
          <a href={`/district/miembros/${vencidaMiembroId}`} class="btn btn-sm btn-primary">Ir a pago de membresía</a>
        </span>
      )}
    </div>
  )}

  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:24px" open={!!error}>
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Nueva reserva</summary>
      <form method="POST" action="/district/cowork" style="margin-top:16px">
        <div class="row">
          <div class="col">
            <label class="label">Espacio *</label>
            <select class="select" name="espacio">
              <option value="hot_desk">Hot desk (max {MAX_HOT_DESK} personas)</option>
              <option value="sala_juntas">Sala de juntas</option>
            </select>
          </div>
          <div class="col">
            <label class="label">Tipo de evento</label>
            <select class="select" name="tipo">
              {TIPOS_COWORK.map((t) => <option value={t.v}>{t.label}</option>)}
            </select>
          </div>
          <div class="col">
            <label class="label">Fecha * <small class="text-muted">(lun-vie)</small></label>
            <input class="input" type="date" name="fecha" required value={todayISO} />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Hora inicio * <small class="text-muted">(desde {HORA_APERTURA})</small></label>
            <input class="input" type="time" name="hora_inicio" required min={HORA_APERTURA} max={HORA_CIERRE} />
          </div>
          <div class="col">
            <label class="label">Hora fin * <small class="text-muted">(hasta {HORA_CIERRE})</small></label>
            <input class="input" type="time" name="hora_fin" required min={HORA_APERTURA} max={HORA_CIERRE} />
          </div>
          <div class="col">
            <label class="label">Titulo / nombre</label>
            <input class="input" name="titulo" placeholder="Ej. Reunion de equipo" />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Miembro <small class="text-muted">(verifica membresía)</small></label>
            <select class="select" name="miembro_id">
              <option value="">— sin asignar —</option>
              {miembros?.map((m: any) => {
                const vencida = m.mem_vence && m.mem_vence < todayISO;
                const sinMem  = !m.mem_vence;
                const label   = `${m.nombre}${m.numero_membresia ? ' (' + m.numero_membresia + ')' : ''}${vencida ? ' ⚠ VENCIDA' : sinMem ? ' — sin membresía' : ' ✓'}`;
                return <option value={m.id}>{label}</option>;
              })}
            </select>
          </div>
          <div class="col">
            <label class="label">Invitado / visitante</label>
            <input class="input" name="invitado_libre" />
          </div>
          <div class="col">
            <label class="label">Personas <small class="text-muted">(miembro = 1)</small></label>
            <input class="input" type="number" name="capacidad" min="1" max={MAX_HOT_DESK} placeholder={`max ${MAX_HOT_DESK}`} id="capacidad_input" />
          </div>
        </div>
        <label class="label">Notas</label>
        <textarea class="textarea" name="notas"></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Crear reserva</button>
      </form>
    </details>
  )}

  <div class="filters" style="margin-bottom:8px">
    {[
      { v: 'proximas', label: 'proximas' },
      { v: 'pasadas',  label: 'pasadas' },
      { v: 'todas',    label: 'todas' }
    ].map((f) => (
      <a href={`/district/cowork?filtro=${f.v}${espacioFiltro ? '&espacio=' + espacioFiltro : ''}`} class={`filter-chip ${filtro === f.v ? 'active' : ''}`}>{f.label}</a>
    ))}
  </div>

  <div class="filters" style="margin-bottom:24px">
    <a href={`/district/cowork?filtro=${filtro}`} class={`filter-chip ${!espacioFiltro ? 'active' : ''}`}>todos los espacios</a>
    <a href={`/district/cowork?filtro=${filtro}&espacio=hot_desk`} class={`filter-chip ${espacioFiltro === 'hot_desk' ? 'active' : ''}`}>hot desk</a>
    <a href={`/district/cowork?filtro=${filtro}&espacio=sala_juntas`} class={`filter-chip ${espacioFiltro === 'sala_juntas' ? 'active' : ''}`}>sala de juntas</a>
  </div>

  {reservas && reservas.length > 0 ? (
    <div>
      {reservas.map((r: any) => (
        <a href={`/district/cowork/${r.id}`} class="card" style="display:block;color:inherit;text-decoration:none;margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;gap:14px;align-items:center">
            <div style="flex:1;min-width:0">
              <div style="font-weight:500">{r.titulo ?? r.miembro_nombre ?? r.invitado_libre ?? '—'}</div>
              <div class="card-meta" style="margin-top:4px">
                <span class="chip">{r.espacio === 'sala_juntas' ? 'sala juntas' : 'hot desk'}</span>
                <span class="chip">{(r.tipo ?? '').replace(/_/g, ' ')}</span>
                <span class="mono">{formatFecha(r.fecha)}{r.hora_inicio ? ' ' + r.hora_inicio : ''}{r.hora_fin ? '-' + r.hora_fin : ''}</span>
                {(r.miembro_nombre || r.invitado_libre) && r.titulo && <span class="text-muted">{r.miembro_nombre ?? r.invitado_libre}</span>}
                {r.capacidad && <span class="text-muted">{r.capacidad} persona{r.capacidad !== 1 ? 's' : ''}</span>}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <EmptyState title="Sin reservas" message="No hay reservas con estos filtros." />
  )}
</Layout>
