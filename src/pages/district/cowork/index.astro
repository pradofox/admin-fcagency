---
import Layout from '../../../components/Layout.astro';
import DistrictNav from '../../../components/DistrictNav.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../../lib/session';
import { getDB, now } from '../../../lib/db';
import { newId } from '../../../lib/ids';
import { formatFecha } from '../../../lib/fechas';

const user = requireUser(Astro);
const editable = canEdit(user);
const db = getDB(Astro);

let error: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const fecha = (form.get('fecha') as string)?.trim();
  if (!fecha) {
    error = 'Fecha obligatoria.';
  } else {
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    const num = (k: string) => {
      const v = form.get(k);
      if (v === null || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    };
    const id = newId();
    const ts = now();
    await db
      .prepare(
        `INSERT INTO reservas_cowork (
          id, fecha, hora_inicio, hora_fin, tipo, titulo, miembro_id, invitado_libre,
          capacidad, notas, created_by, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
      )
      .bind(id, fecha, get('hora_inicio'), get('hora_fin'), get('tipo') ?? 'visita', get('titulo'), get('miembro_id'), get('invitado_libre'), num('capacidad'), get('notas'), user.id, ts, ts)
      .run();
    return Astro.redirect(`/district/cowork/${id}`);
  }
}

const filtro = Astro.url.searchParams.get('filtro') ?? 'proximas';
const tipoFiltro = Astro.url.searchParams.get('tipo') ?? '';
const todayISO = new Date().toISOString().slice(0, 10);

const where: string[] = [];
const binds: any[] = [];
if (filtro === 'proximas') { where.push('r.fecha >= ?'); binds.push(todayISO); }
if (filtro === 'pasadas') { where.push('r.fecha < ?'); binds.push(todayISO); }
if (tipoFiltro) { where.push('r.tipo = ?'); binds.push(tipoFiltro); }

const sql = `SELECT r.id, r.fecha, r.hora_inicio, r.hora_fin, r.tipo, r.titulo, r.invitado_libre, r.capacidad,
                    mi.nombre as miembro_nombre
             FROM reservas_cowork r
             LEFT JOIN miembros_district mi ON mi.id = r.miembro_id
             ${where.length ? 'WHERE ' + where.join(' AND ') : ''}
             ORDER BY r.fecha ${filtro === 'pasadas' ? 'DESC' : 'ASC'}, r.hora_inicio ASC
             LIMIT 200`;

const { results: reservas } = await db.prepare(sql).bind(...binds).all<any>();

const { results: miembros } = await db
  .prepare("SELECT id, nombre FROM miembros_district WHERE activo = 1 ORDER BY nombre")
  .all<{ id: string; nombre: string }>();

const TIPOS_COWORK = [
  { v: 'visita', label: 'Visita' },
  { v: 'evento_comunidad', label: 'Evento comunidad' },
  { v: 'after_office', label: 'After office' },
  { v: 'actividad_interna', label: 'Actividad interna' },
  { v: 'club', label: 'Club' }
];
---

<Layout title="Cowork" pageTitle="District Studio">
  <div class="page-head">
    <h1>Cowork</h1>
  </div>
  <DistrictNav />

  {error && <p class="text-danger" style="margin-bottom:16px">{error}</p>}

  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:24px" open={!!error}>
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Nueva reserva / evento</summary>
      <form method="POST" action="/district/cowork" style="margin-top:16px">
        <div class="row">
          <div class="col">
            <label class="label">Tipo</label>
            <select class="select" name="tipo">
              {TIPOS_COWORK.map((t) => <option value={t.v}>{t.label}</option>)}
            </select>
          </div>
          <div class="col">
            <label class="label">Fecha *</label>
            <input class="input" type="date" name="fecha" required value={todayISO} />
          </div>
          <div class="col">
            <label class="label">Hora inicio</label>
            <input class="input" type="time" name="hora_inicio" />
          </div>
          <div class="col">
            <label class="label">Hora fin</label>
            <input class="input" type="time" name="hora_fin" />
          </div>
        </div>
        <label class="label">Título / nombre del evento</label>
        <input class="input" name="titulo" placeholder="Ej. After office octubre" />
        <div class="row">
          <div class="col">
            <label class="label">Miembro</label>
            <select class="select" name="miembro_id">
              <option value="">— sin asignar —</option>
              {miembros?.map((m) => <option value={m.id}>{m.nombre}</option>)}
            </select>
          </div>
          <div class="col">
            <label class="label">Invitado / asistente libre</label>
            <input class="input" name="invitado_libre" />
          </div>
          <div class="col">
            <label class="label">Capacidad</label>
            <input class="input" type="number" name="capacidad" placeholder="cupo total" />
          </div>
        </div>
        <label class="label">Notas</label>
        <textarea class="textarea" name="notas"></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Crear reserva</button>
      </form>
    </details>
  )}

  <div class="filters" style="margin-bottom:8px">
    {[
      { v: 'proximas', label: 'próximas' },
      { v: 'pasadas', label: 'pasadas' },
      { v: 'todas', label: 'todas' }
    ].map((f) => (
      <a href={`/district/cowork?filtro=${f.v}${tipoFiltro ? '&tipo=' + tipoFiltro : ''}`} class={`filter-chip ${filtro === f.v ? 'active' : ''}`}>{f.label}</a>
    ))}
  </div>

  <div class="filters" style="margin-bottom:24px">
    <a href={`/district/cowork?filtro=${filtro}`} class={`filter-chip ${!tipoFiltro ? 'active' : ''}`}>todos los tipos</a>
    {TIPOS_COWORK.map((t) => (
      <a href={`/district/cowork?filtro=${filtro}&tipo=${t.v}`} class={`filter-chip ${tipoFiltro === t.v ? 'active' : ''}`}>{t.label}</a>
    ))}
  </div>

  {reservas && reservas.length > 0 ? (
    <div>
      {reservas.map((r: any) => (
        <a href={`/district/cowork/${r.id}`} class="card" style="display:block;color:inherit;text-decoration:none;margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;gap:14px;align-items:center">
            <div style="flex:1;min-width:0">
              <div style="font-weight:500">{r.titulo ?? r.miembro_nombre ?? r.invitado_libre ?? '—'}</div>
              <div class="card-meta" style="margin-top:4px">
                <span class="chip">{r.tipo.replace(/_/g, ' ')}</span>
                <span class="mono">{formatFecha(r.fecha)}{r.hora_inicio ? ' ' + r.hora_inicio : ''}{r.hora_fin ? '-' + r.hora_fin : ''}</span>
                {(r.miembro_nombre || r.invitado_libre) && r.titulo && <span class="text-muted">{r.miembro_nombre ?? r.invitado_libre}</span>}
                {r.capacidad && <span class="text-muted">cupo {r.capacidad}</span>}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <EmptyState title="Sin reservas" message="No hay reservas con estos filtros." />
  )}
</Layout>
