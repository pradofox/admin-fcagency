---
import Layout from '../../components/Layout.astro';
import { requireUser } from '../../lib/session';
import { getDB } from '../../lib/db';
import { parseCumpleanos } from '../../lib/fechas';

const user = requireUser(Astro);
const db = getDB(Astro);

const TIPOS = ['Tarea', 'Producción', 'Fitting', 'Booking', 'Campaña', 'Junta', 'Estudio', 'Cumpleaños'] as const;
type Tipo = typeof TIPOS[number];

interface Event {
  fecha: string;
  tipo: Tipo;
  titulo: string;
  href: string;
  done?: boolean;
  prioridad?: string | null;
  esMia?: boolean;
}

// Filtros
const params      = Astro.url.searchParams;
const filtroParam = params.get('show');
const filtrosActivos: Set<Tipo> = filtroParam
  ? new Set(filtroParam.split(',').filter((t): t is Tipo => (TIPOS as readonly string[]).includes(t)))
  : new Set(TIPOS);
const soloMias = params.get('mias') === '1';

// Filtros por marca / cliente (afectan producciones y derivados)
const marcaFiltro   = params.get('marca') || null;
const clienteFiltro = params.get('cliente') || null;
const prodFiltrada  = !!(marcaFiltro || clienteFiltro);
const prodWhereExtra = `${marcaFiltro ? ' AND marca_id = ?' : ''}${clienteFiltro ? ' AND cliente_id = ?' : ''}`;
const prodBindsExtra: any[] = [];
if (marcaFiltro) prodBindsExtra.push(marcaFiltro);
if (clienteFiltro) prodBindsExtra.push(clienteFiltro);

const marcasList   = (await db.prepare('SELECT id, nombre FROM marcas WHERE activa = 1 ORDER BY orden').all<any>()).results ?? [];
const clientesList = (await db.prepare('SELECT id, nombre FROM clientes ORDER BY nombre').all<any>()).results ?? [];

// Filtro por modelo: el "calendario por perfil de modelo" es este mismo calendario
// restringido a las producciones donde aparece ese modelo.
const modeloFiltro = params.get('modelo');
let modeloProdIds: Set<string> | null = null;
let modeloNombre: string | null = null;
if (modeloFiltro) {
  const { results: mp } = await db
    .prepare('SELECT DISTINCT produccion_id FROM lineas_produccion WHERE modelo_id = ?')
    .bind(modeloFiltro).all<any>();
  modeloProdIds = new Set((mp ?? []).map((r: any) => r.produccion_id));
  const mrow = await db.prepare('SELECT nombre FROM modelos WHERE id = ?').bind(modeloFiltro).first<any>();
  modeloNombre = mrow?.nombre ?? null;
}

// Mes a mostrar
const today     = new Date();
const todayStr  = today.toISOString().slice(0, 10);
const mesParam  = params.get('mes');
const [y, m]    = mesParam ? mesParam.split('-').map(Number) : [today.getFullYear(), today.getMonth() + 1];

const firstOfMonth = new Date(Date.UTC(y, m - 1, 1));
const lastOfMonth  = new Date(Date.UTC(y, m, 0));
const daysInMonth  = lastOfMonth.getUTCDate();

// Lunes como inicio de semana
const firstWeekday = (firstOfMonth.getUTCDay() + 6) % 7;
const totalCells   = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;

const gridStart = new Date(firstOfMonth);
gridStart.setUTCDate(gridStart.getUTCDate() - firstWeekday);
const gridEnd = new Date(gridStart);
gridEnd.setUTCDate(gridEnd.getUTCDate() + totalCells - 1);
const startStr = gridStart.toISOString().slice(0, 10);
const endStr   = gridEnd.toISOString().slice(0, 10);

let events: Event[] = [];

// ── Tareas ──────────────────────────────────────────────────────────────────
if (filtrosActivos.has('Tarea') && !prodFiltrada) {
  const cond   = soloMias ? 'AND a.asignado_a = ?' : '';
  const binds: any[] = [startStr, endStr];
  if (soloMias) binds.push(user.id);
  const { results: tareas } = await db
    .prepare(`SELECT a.id, a.fecha, a.tarea, a.prioridad, a.estado, a.asignado_a
              FROM acciones_calendario a
              WHERE a.fecha BETWEEN ? AND ? ${cond}`)
    .bind(...binds)
    .all<any>();
  events.push(...(tareas ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Tarea' as const,
    titulo: e.tarea, href: `/tareas/${e.id}`,
    done: e.estado === 'completada', prioridad: e.prioridad,
    esMia: e.asignado_a === user.id
  })));
}

// ── Producciones generales (excluyendo Fitting, Booking, Campaña) ───────────
if (filtrosActivos.has('Producción')) {
  const { results: prods } = await db
    .prepare(`SELECT id, titulo, fecha_inicio as fecha, tipo_produccion
              FROM producciones
              WHERE fecha_inicio BETWEEN ? AND ?
                AND estado != 'cancelada'
                AND (tipo_produccion IS NULL OR tipo_produccion NOT IN ('Fitting','Booking','Campaña'))${prodWhereExtra}`)
    .bind(startStr, endStr, ...prodBindsExtra)
    .all<any>();
  events.push(...(prods ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Producción' as const,
    titulo: `${e.titulo}${e.tipo_produccion ? ' · ' + e.tipo_produccion : ''}`,
    href: `/producciones/${e.id}`
  })));
}

// ── Fittings ─────────────────────────────────────────────────────────────────
if (filtrosActivos.has('Fitting')) {
  const { results: fittings } = await db
    .prepare(`SELECT id, titulo, fecha_inicio as fecha
              FROM producciones
              WHERE fecha_inicio BETWEEN ? AND ?
                AND estado != 'cancelada'
                AND tipo_produccion = 'Fitting'${prodWhereExtra}`)
    .bind(startStr, endStr, ...prodBindsExtra)
    .all<any>();
  events.push(...(fittings ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Fitting' as const,
    titulo: e.titulo, href: `/producciones/${e.id}`
  })));
}

// ── Bookings ──────────────────────────────────────────────────────────────────
if (filtrosActivos.has('Booking')) {
  const { results: bookings } = await db
    .prepare(`SELECT id, titulo, fecha_inicio as fecha
              FROM producciones
              WHERE fecha_inicio BETWEEN ? AND ?
                AND estado != 'cancelada'
                AND tipo_produccion = 'Booking'${prodWhereExtra}`)
    .bind(startStr, endStr, ...prodBindsExtra)
    .all<any>();
  events.push(...(bookings ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Booking' as const,
    titulo: e.titulo, href: `/producciones/${e.id}`
  })));
}

// ── Campañas ──────────────────────────────────────────────────────────────────
if (filtrosActivos.has('Campaña')) {
  const { results: campanas } = await db
    .prepare(`SELECT id, titulo, fecha_inicio as fecha
              FROM producciones
              WHERE fecha_inicio BETWEEN ? AND ?
                AND estado != 'cancelada'
                AND tipo_produccion = 'Campaña'${prodWhereExtra}`)
    .bind(startStr, endStr, ...prodBindsExtra)
    .all<any>();
  events.push(...(campanas ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Campaña' as const,
    titulo: e.titulo, href: `/producciones/${e.id}`
  })));
}

// ── Juntas (sala de juntas District) ─────────────────────────────────────────
if (filtrosActivos.has('Junta') && !prodFiltrada) {
  const { results: juntas } = await db
    .prepare(`SELECT rc.id, rc.fecha, rc.hora_inicio, rc.titulo, mi.nombre as miembro_nombre, rc.invitado_libre
              FROM reservas_cowork rc
              LEFT JOIN miembros_district mi ON mi.id = rc.miembro_id
              WHERE rc.fecha BETWEEN ? AND ? AND rc.espacio = 'sala_juntas'`)
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(juntas ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Junta' as const,
    titulo: `${e.titulo ?? e.miembro_nombre ?? e.invitado_libre ?? 'Junta'}${e.hora_inicio ? ' ' + e.hora_inicio : ''}`,
    href: `/district/cowork/${e.id}`
  })));
}

// ── Estudio foto/video ────────────────────────────────────────────────────────
if (filtrosActivos.has('Estudio') && !prodFiltrada) {
  const { results: estudio } = await db
    .prepare(`SELECT re.id, re.fecha, re.hora_inicio, re.tipo, mi.nombre as miembro_nombre, re.cliente_libre
              FROM reservas_estudio re
              LEFT JOIN miembros_district mi ON mi.id = re.miembro_id
              WHERE re.fecha BETWEEN ? AND ? AND re.estado != 'cancelada'`)
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(estudio ?? []).map((e: any) => ({
    fecha: e.fecha, tipo: 'Estudio' as const,
    titulo: `${e.tipo} · ${e.miembro_nombre ?? e.cliente_libre ?? 'Reserva'}${e.hora_inicio ? ' ' + e.hora_inicio : ''}`,
    href: `/district/estudio/${e.id}`
  })));
}

// ── Cumpleaños de modelos ─────────────────────────────────────────────────────
if (filtrosActivos.has('Cumpleaños') && !prodFiltrada && !modeloFiltro) {
  const { results: mods } = await db
    .prepare(`SELECT id, nombre, cumpleanos FROM modelos
              WHERE estado != 'archivado' AND cumpleanos IS NOT NULL AND TRIM(cumpleanos) != ''`)
    .all<any>();
  const gridYears = new Set([gridStart.getUTCFullYear(), gridEnd.getUTCFullYear()]);
  for (const mo of mods ?? []) {
    const c = parseCumpleanos(mo.cumpleanos);
    if (!c) continue;
    for (const yr of gridYears) {
      const iso = `${yr}-${String(c.mes).padStart(2, '0')}-${String(c.dia).padStart(2, '0')}`;
      if (iso < startStr || iso > endStr) continue;
      const edad = c.anio ? yr - c.anio : null;
      events.push({
        fecha: iso, tipo: 'Cumpleaños' as const,
        titulo: `🎂 ${mo.nombre}${edad != null ? ` (${edad})` : ''}`,
        href: `/modelos/${mo.id}`,
      });
    }
  }
}

// ── Filtro por modelo: solo eventos de producción de ese modelo ──────────────
if (modeloFiltro && modeloProdIds) {
  const PROD_TIPOS = ['Producción', 'Fitting', 'Booking', 'Campaña'];
  events = events.filter((e) =>
    PROD_TIPOS.includes(e.tipo) && modeloProdIds!.has(e.href.split('/').pop() as string)
  );
}

// ── Agrupar por fecha ──────────────────────────────────────────────────────────
const byDate: Record<string, Event[]> = {};
for (const e of events) {
  if (!e.fecha) continue;
  byDate[e.fecha] = byDate[e.fecha] ?? [];
  byDate[e.fecha].push(e);
}

// Navegación de mes
const prevMonth = m === 1 ? `${y - 1}-12` : `${y}-${String(m - 1).padStart(2, '0')}`;
const nextMonth = m === 12 ? `${y + 1}-01` : `${y}-${String(m + 1).padStart(2, '0')}`;
const mesActual = `${y}-${String(m).padStart(2, '0')}`;
const nombreMes = new Date(y, m - 1, 1).toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });

function buildHref(overrides: Record<string, string | undefined>) {
  const p = new URLSearchParams();
  const mesDefault = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;
  if (mesActual !== mesDefault) p.set('mes', mesActual);
  if (filtroParam) p.set('show', filtroParam);
  if (soloMias) p.set('mias', '1');
  if (modeloFiltro) p.set('modelo', modeloFiltro);
  if (marcaFiltro) p.set('marca', marcaFiltro);
  if (clienteFiltro) p.set('cliente', clienteFiltro);
  for (const k in overrides) {
    const v = overrides[k];
    if (v === undefined || v === '') p.delete(k); else p.set(k, v);
  }
  const s = p.toString();
  return `/calendario${s ? '?' + s : ''}`;
}

function toggleTipoHref(tipo: Tipo) {
  const next = new Set(filtrosActivos);
  if (next.has(tipo)) next.delete(tipo); else next.add(tipo);
  const show = next.size === TIPOS.length ? undefined : Array.from(next).join(',');
  return buildHref({ show });
}

// Grid
const cells: { date: string; day: number; inMonth: boolean; isToday: boolean }[] = [];
for (let i = 0; i < totalCells; i++) {
  const d = new Date(gridStart);
  d.setUTCDate(d.getUTCDate() + i);
  const iso = d.toISOString().slice(0, 10);
  cells.push({ date: iso, day: d.getUTCDate(), inMonth: d.getUTCMonth() === m - 1, isToday: iso === todayStr });
}

const chipColor: Record<Tipo, string> = {
  'Tarea':      'cal-tarea',
  'Producción': 'cal-prod',
  'Fitting':    'cal-fitting',
  'Booking':    'cal-booking',
  'Campaña':    'cal-campana',
  'Junta':      'cal-junta',
  'Estudio':    'cal-estudio',
  'Cumpleaños': 'cal-cumple'
};

const labelTipo: Record<Tipo, string> = {
  'Tarea':      'Tareas',
  'Producción': 'Producciones',
  'Fitting':    'Fittings',
  'Booking':    'Bookings',
  'Campaña':    'Campañas',
  'Junta':      'Juntas',
  'Estudio':    'Estudio',
  'Cumpleaños': 'Cumpleaños'
};

const diasSemana = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
---

<Layout title="Calendario" pageTitle="Calendario">
  <div class="page-head">
    <h1 style="text-transform:capitalize">{nombreMes}</h1>
    <div style="display:flex;gap:8px;align-items:center">
      <a href={buildHref({ mes: prevMonth })} class="btn btn-sm">←</a>
      <a href="/calendario" class="btn btn-sm">hoy</a>
      <a href={buildHref({ mes: nextMonth })} class="btn btn-sm">→</a>
    </div>
  </div>

  {modeloFiltro && (
    <div class="card" style="margin-bottom:16px;border-left:3px solid var(--gold);display:flex;justify-content:space-between;align-items:center">
      <div>
        <span class="text-muted" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase">Agenda de modelo</span>
        <div style="color:var(--gold);font-weight:600;font-size:15px">{modeloNombre ?? 'Modelo'}</div>
      </div>
      <div style="display:flex;gap:8px">
        <a href={`/modelos/${modeloFiltro}`} class="btn btn-sm">Ver perfil</a>
        <a href="/calendario" class="btn btn-sm">✕ Quitar filtro</a>
      </div>
    </div>
  )}

  <div class="filters" style="margin-bottom:8px">
    {TIPOS.map((t) => (
      <a href={toggleTipoHref(t)} class={`filter-chip cal-filter ${chipColor[t]} ${filtrosActivos.has(t) ? 'active' : ''}`}>
        {filtrosActivos.has(t) ? '●' : '○'} {labelTipo[t]}
      </a>
    ))}
  </div>

  <div class="filters" style="margin-bottom:16px">
    <a href={buildHref({ mias: soloMias ? undefined : '1' })} class={`filter-chip ${soloMias ? 'active' : ''}`}>
      {soloMias ? '★' : '☆'} solo mis tareas
    </a>
    <a href="/calendario" class="filter-chip">limpiar filtros</a>
  </div>

  {/* Filtros por marca / cliente (solo afectan producciones) */}
  <form method="GET" action="/calendario" id="cal-filtros" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px;align-items:center">
    {mesActual !== `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}` && <input type="hidden" name="mes" value={mesActual} />}
    {filtroParam && <input type="hidden" name="show" value={filtroParam} />}
    {soloMias && <input type="hidden" name="mias" value="1" />}
    <select class="select" name="marca" onchange="document.getElementById('cal-filtros').submit()" style="font-size:12px;padding:6px 10px;max-width:200px">
      <option value="">Todas las marcas</option>
      {(marcasList as any[]).map((mk) => <option value={mk.id} selected={marcaFiltro === mk.id}>{mk.nombre}</option>)}
    </select>
    <select class="select" name="cliente" onchange="document.getElementById('cal-filtros').submit()" style="font-size:12px;padding:6px 10px;max-width:220px">
      <option value="">Todos los clientes</option>
      {(clientesList as any[]).map((cl) => <option value={cl.id} selected={clienteFiltro === cl.id}>{cl.nombre}</option>)}
    </select>
    {prodFiltrada && <a href={buildHref({ marca: undefined, cliente: undefined })} class="filter-chip">✕ quitar</a>}
    {prodFiltrada && <span class="text-muted" style="font-size:11px">Mostrando solo producciones del filtro.</span>}
  </form>

  <div class="cal-grid">
    {diasSemana.map((d) => <div class="cal-weekday">{d}</div>)}
    {cells.map((c) => (
      <div class={`cal-cell ${c.inMonth ? '' : 'cal-out'} ${c.isToday ? 'cal-today' : ''}`}>
        <div class="cal-daynum">{c.day}</div>
        {(byDate[c.date] ?? []).slice(0, 5).map((e) => (
          <a href={e.href} class={`cal-event ${chipColor[e.tipo]} ${e.done ? 'cal-done' : ''} ${e.esMia ? 'cal-mine' : ''}`} title={`${e.tipo} · ${e.titulo}`}>
            {e.esMia && <span>★</span>}
            {e.prioridad === 'Alta' && <span style="color:#ff6b6b">!</span>}
            <span class="cal-event-title">{e.titulo}</span>
          </a>
        ))}
        {(byDate[c.date]?.length ?? 0) > 5 && (
          <div class="cal-more">+{(byDate[c.date]?.length ?? 0) - 5} más</div>
        )}
      </div>
    ))}
  </div>

  <style>
    .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:1px; background:var(--border); border:1px solid var(--border); }
    .cal-weekday { background:var(--bg-2); padding:8px 10px; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-2); }
    .cal-cell { background:var(--bg); min-height:110px; padding:6px; display:flex; flex-direction:column; gap:3px; overflow:hidden; }
    .cal-out { background:var(--bg-2); opacity:.4; }
    .cal-today .cal-daynum { background:var(--gold); color:#000; border-radius:3px; padding:0 6px; display:inline-block; width:fit-content; }
    .cal-daynum { font-size:12px; color:var(--text-2); font-family:var(--font-mono); margin-bottom:2px; }
    .cal-event { display:flex; align-items:center; gap:3px; font-size:11px; padding:2px 5px; border-left:2px solid; text-decoration:none; color:var(--text); background:var(--bg-2); white-space:nowrap; overflow:hidden; }
    .cal-event-title { overflow:hidden; text-overflow:ellipsis; flex:1; min-width:0; }
    .cal-event:hover { background:var(--bg-3,#1a1a1a); }
    .cal-event.cal-done { opacity:.4; text-decoration:line-through; }
    .cal-event.cal-mine { font-weight:500; }
    .cal-more { font-size:10px; color:var(--text-2); padding:0 4px; }
    /* Colores por tipo */
    .cal-tarea    { border-left-color:#E5E5E5; }
    .cal-prod     { border-left-color:var(--gold); }
    .cal-fitting  { border-left-color:#f472b6; }
    .cal-booking  { border-left-color:#a78bfa; }
    .cal-campana  { border-left-color:#6ab7ff; }
    .cal-junta    { border-left-color:#34d399; }
    .cal-estudio  { border-left-color:#fb923c; }
    .cal-cumple   { border-left-color:#e879f9; }
    /* Filtros activos */
    .cal-filter.cal-tarea.active   { border-left:3px solid #E5E5E5; }
    .cal-filter.cal-prod.active    { border-left:3px solid var(--gold); }
    .cal-filter.cal-fitting.active { border-left:3px solid #f472b6; }
    .cal-filter.cal-booking.active { border-left:3px solid #a78bfa; }
    .cal-filter.cal-campana.active { border-left:3px solid #6ab7ff; }
    .cal-filter.cal-junta.active   { border-left:3px solid #34d399; }
    .cal-filter.cal-estudio.active { border-left:3px solid #fb923c; }
    .cal-filter.cal-cumple.active  { border-left:3px solid #e879f9; }
    @media (max-width:768px) {
      .cal-cell { min-height:80px; padding:4px; }
      .cal-event { font-size:10px; }
      .cal-weekday { font-size:9px; padding:6px; }
    }
  </style>
</Layout>
