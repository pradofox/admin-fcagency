---
import Layout from '../../components/Layout.astro';
import { requireUser } from '../../lib/session';
import { getDB } from '../../lib/db';

const user = requireUser(Astro);
const db = getDB(Astro);

interface Event {
  fecha: string;
  tipo: 'Tarea' | 'Producción' | 'Brief' | 'Pieza' | 'Contacto';
  titulo: string;
  href: string;
  done?: boolean;
  prioridad?: string | null;
  esMia?: boolean;
}

const TIPOS = ['Tarea', 'Producción', 'Brief', 'Pieza', 'Contacto', 'Estudio', 'Cowork'] as const;
type Tipo = typeof TIPOS[number];

// Filtros
const params = Astro.url.searchParams;
const filtroParam = params.get('show');
const filtrosActivos: Set<Tipo> = filtroParam
  ? new Set(filtroParam.split(',').filter((t): t is Tipo => (TIPOS as readonly string[]).includes(t)))
  : new Set(TIPOS);
const soloMias = params.get('mias') === '1';

// Mes a mostrar: YYYY-MM. Default mes actual.
const today = new Date();
const todayStr = today.toISOString().slice(0, 10);
const mesParam = params.get('mes');
const [y, m] = mesParam ? mesParam.split('-').map(Number) : [today.getFullYear(), today.getMonth() + 1];

const firstOfMonth = new Date(Date.UTC(y, m - 1, 1));
const lastOfMonth = new Date(Date.UTC(y, m, 0));
const daysInMonth = lastOfMonth.getUTCDate();

// Lunes como inicio de semana. JS: 0=domingo. Convertir a 0=lunes, 6=domingo.
const firstWeekday = (firstOfMonth.getUTCDay() + 6) % 7;
const totalCells = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;

const gridStart = new Date(firstOfMonth);
gridStart.setUTCDate(gridStart.getUTCDate() - firstWeekday);
const gridEnd = new Date(gridStart);
gridEnd.setUTCDate(gridEnd.getUTCDate() + totalCells - 1);
const startStr = gridStart.toISOString().slice(0, 10);
const endStr = gridEnd.toISOString().slice(0, 10);

let events: Event[] = [];

if (filtrosActivos.has('Tarea')) {
  const cond = soloMias ? 'AND a.asignado_a = ?' : '';
  const binds: any[] = [startStr, endStr];
  if (soloMias) binds.push(user.id);
  const tareas = await db
    .prepare(
      `SELECT a.id, a.fecha, a.tarea, a.prioridad, a.estado, a.asignado_a
       FROM acciones_calendario a
       WHERE a.fecha BETWEEN ? AND ? ${cond}`
    )
    .bind(...binds)
    .all<any>();
  events.push(...(tareas.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Tarea' as const,
    titulo: e.tarea,
    href: `/tareas/${e.id}`,
    done: e.estado === 'completada',
    prioridad: e.prioridad,
    esMia: e.asignado_a === user.id
  })));
}

if (filtrosActivos.has('Producción')) {
  const producciones = await db
    .prepare(
      `SELECT id, titulo, fecha_inicio as fecha, estado
       FROM producciones
       WHERE fecha_inicio BETWEEN ? AND ? AND estado != 'cancelada'`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(producciones.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Producción' as const,
    titulo: e.titulo,
    href: `/producciones/${e.id}`
  })));
}

if (filtrosActivos.has('Brief')) {
  const briefs = await db
    .prepare(
      `SELECT id, titulo, fecha_publicacion as fecha
       FROM briefs
       WHERE fecha_publicacion BETWEEN ? AND ?`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(briefs.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Brief' as const,
    titulo: e.titulo,
    href: `/briefs/${e.id}`
  })));
}

if (filtrosActivos.has('Pieza')) {
  const piezas = await db
    .prepare(
      `SELECT id, titulo, fecha_programada as fecha
       FROM piezas_contenido
       WHERE fecha_programada BETWEEN ? AND ?`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(piezas.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Pieza' as const,
    titulo: e.titulo,
    href: '/contenido'
  })));
}

if (filtrosActivos.has('Contacto')) {
  const contactos = await db
    .prepare(
      `SELECT id, nombre, next_action_date as fecha, next_action_text
       FROM contactos
       WHERE next_action_date BETWEEN ? AND ? AND estatus_crm != 'cerrado'`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(contactos.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Contacto' as const,
    titulo: `${e.nombre}${e.next_action_text ? ' — ' + e.next_action_text : ''}`,
    href: `/contactos/${e.id}`
  })));
}

if (filtrosActivos.has('Estudio')) {
  const estudio = await db
    .prepare(
      `SELECT re.id, re.fecha, re.hora_inicio, re.tipo, re.titulo,
              mi.nombre as miembro_nombre, re.cliente_libre
       FROM reservas_estudio re
       LEFT JOIN miembros_district mi ON mi.id = re.miembro_id
       WHERE re.fecha BETWEEN ? AND ? AND re.estado != 'cancelada'`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(estudio.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Estudio' as const,
    titulo: `${e.tipo} · ${e.titulo ?? e.miembro_nombre ?? e.cliente_libre ?? 'Reserva'}${e.hora_inicio ? ' ' + e.hora_inicio : ''}`,
    href: `/district/estudio/${e.id}`
  })));
}

if (filtrosActivos.has('Cowork')) {
  const cowork = await db
    .prepare(
      `SELECT rc.id, rc.fecha, rc.hora_inicio, rc.tipo, rc.titulo,
              mi.nombre as miembro_nombre, rc.invitado_libre
       FROM reservas_cowork rc
       LEFT JOIN miembros_district mi ON mi.id = rc.miembro_id
       WHERE rc.fecha BETWEEN ? AND ?`
    )
    .bind(startStr, endStr)
    .all<any>();
  events.push(...(cowork.results ?? []).map((e: any) => ({
    fecha: e.fecha,
    tipo: 'Cowork' as const,
    titulo: `${e.titulo ?? e.miembro_nombre ?? e.invitado_libre ?? e.tipo}${e.hora_inicio ? ' ' + e.hora_inicio : ''}`,
    href: `/district/cowork/${e.id}`
  })));
}

// Agrupar por fecha
const byDate: Record<string, Event[]> = {};
for (const e of events) {
  if (!e.fecha) continue;
  byDate[e.fecha] = byDate[e.fecha] ?? [];
  byDate[e.fecha].push(e);
}

// Navegación de mes
const prevMonth = m === 1 ? `${y - 1}-12` : `${y}-${String(m - 1).padStart(2, '0')}`;
const nextMonth = m === 12 ? `${y + 1}-01` : `${y}-${String(m + 1).padStart(2, '0')}`;
const mesActual = `${y}-${String(m).padStart(2, '0')}`;
const nombreMes = new Date(y, m - 1, 1).toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });

// Helper para construir hrefs preservando filtros
function buildHref(overrides: Record<string, string | undefined>) {
  const p = new URLSearchParams();
  if (mesActual !== `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`) p.set('mes', mesActual);
  if (filtroParam) p.set('show', filtroParam);
  if (soloMias) p.set('mias', '1');
  for (const k in overrides) {
    if (overrides[k] === undefined) p.delete(k);
    else if (overrides[k] === '') p.delete(k);
    else p.set(k, overrides[k] as string);
  }
  const s = p.toString();
  return `/calendario${s ? '?' + s : ''}`;
}

function toggleTipoHref(tipo: Tipo) {
  const next = new Set(filtrosActivos);
  if (next.has(tipo)) next.delete(tipo);
  else next.add(tipo);
  const show = next.size === TIPOS.length ? undefined : Array.from(next).join(',');
  return buildHref({ show });
}

// Render del grid
const cells: { date: string; day: number; inMonth: boolean; isToday: boolean }[] = [];
for (let i = 0; i < totalCells; i++) {
  const d = new Date(gridStart);
  d.setUTCDate(d.getUTCDate() + i);
  const iso = d.toISOString().slice(0, 10);
  cells.push({
    date: iso,
    day: d.getUTCDate(),
    inMonth: d.getUTCMonth() === m - 1,
    isToday: iso === todayStr
  });
}

const chipColor: Record<Tipo, string> = {
  'Tarea': 'cal-tarea',
  'Producción': 'cal-prod',
  'Brief': 'cal-brief',
  'Pieza': 'cal-pieza',
  'Contacto': 'cal-contacto',
  'Estudio': 'cal-estudio',
  'Cowork': 'cal-cowork'
};

const diasSemana = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
---

<Layout title="Calendario" pageTitle="Calendario">
  <div class="page-head">
    <h1 style="text-transform:capitalize">{nombreMes}</h1>
    <div style="display:flex;gap:8px;align-items:center">
      <a href={buildHref({ mes: prevMonth })} class="btn btn-sm">←</a>
      <a href="/calendario" class="btn btn-sm">hoy</a>
      <a href={buildHref({ mes: nextMonth })} class="btn btn-sm">→</a>
    </div>
  </div>

  <div class="filters" style="margin-bottom:8px">
    {TIPOS.map((t) => (
      <a href={toggleTipoHref(t)} class={`filter-chip cal-filter ${chipColor[t]} ${filtrosActivos.has(t) ? 'active' : ''}`}>
        {filtrosActivos.has(t) ? '●' : '○'} {
          t === 'Producción' ? 'Producciones' :
          t === 'Pieza' ? 'Piezas' :
          t === 'Brief' ? 'Briefs' :
          t === 'Tarea' ? 'Tareas' :
          t === 'Estudio' ? 'Estudio' :
          t === 'Cowork' ? 'Cowork' :
          'Contactos'
        }
      </a>
    ))}
  </div>

  <div class="filters" style="margin-bottom:24px">
    <a href={buildHref({ mias: soloMias ? undefined : '1' })} class={`filter-chip ${soloMias ? 'active' : ''}`}>
      {soloMias ? '★' : '☆'} solo mis tareas
    </a>
  </div>

  <div class="cal-grid">
    {diasSemana.map((d) => (
      <div class="cal-weekday">{d}</div>
    ))}
    {cells.map((c) => (
      <div class={`cal-cell ${c.inMonth ? '' : 'cal-out'} ${c.isToday ? 'cal-today' : ''}`}>
        <div class="cal-daynum">{c.day}</div>
        {(byDate[c.date] ?? []).slice(0, 4).map((e) => (
          <a href={e.href} class={`cal-event ${chipColor[e.tipo]} ${e.done ? 'cal-done' : ''} ${e.esMia ? 'cal-mine' : ''}`} title={`${e.tipo} · ${e.titulo}`}>
            {e.esMia && <span>★</span>}
            {e.prioridad === 'Alta' && <span style="color:#ff6b6b">!</span>}
            <span class="cal-event-title">{e.titulo}</span>
          </a>
        ))}
        {(byDate[c.date]?.length ?? 0) > 4 && (
          <div class="cal-more">+{(byDate[c.date]?.length ?? 0) - 4} más</div>
        )}
      </div>
    ))}
  </div>

  <style>
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
    }
    .cal-weekday {
      background: var(--bg-2);
      padding: 8px 10px;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-2);
      text-align: left;
    }
    .cal-cell {
      background: var(--bg);
      min-height: 110px;
      padding: 6px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      overflow: hidden;
    }
    .cal-out {
      background: var(--bg-2);
      opacity: .45;
    }
    .cal-today .cal-daynum {
      background: var(--gold);
      color: #000;
      border-radius: 3px;
      padding: 0 6px;
      display: inline-block;
      width: fit-content;
    }
    .cal-daynum {
      font-size: 12px;
      color: var(--text-2);
      font-family: var(--font-mono);
      margin-bottom: 2px;
    }
    .cal-event {
      display: flex;
      align-items: center;
      gap: 3px;
      font-size: 11px;
      padding: 2px 5px;
      border-left: 2px solid;
      text-decoration: none;
      color: var(--text);
      background: var(--bg-2);
      white-space: nowrap;
      overflow: hidden;
    }
    .cal-event-title {
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
      min-width: 0;
    }
    .cal-event:hover { background: var(--bg-3, #1a1a1a); }
    .cal-event.cal-done { opacity: .4; text-decoration: line-through; }
    .cal-event.cal-mine { font-weight: 500; }
    .cal-tarea { border-left-color: #e9b949; }
    .cal-prod { border-left-color: var(--gold); }
    .cal-brief { border-left-color: #6ab7ff; }
    .cal-pieza { border-left-color: #4ade80; }
    .cal-contacto { border-left-color: #a78bfa; }
    .cal-estudio { border-left-color: #fb923c; }
    .cal-cowork { border-left-color: #34d399; }
    .cal-more {
      font-size: 10px;
      color: var(--text-2);
      padding: 0 4px;
    }
    .cal-filter.cal-tarea.active { border-left: 3px solid #e9b949; }
    .cal-filter.cal-prod.active { border-left: 3px solid var(--gold); }
    .cal-filter.cal-brief.active { border-left: 3px solid #6ab7ff; }
    .cal-filter.cal-pieza.active { border-left: 3px solid #4ade80; }
    .cal-filter.cal-contacto.active { border-left: 3px solid #a78bfa; }
    .cal-filter.cal-estudio.active { border-left: 3px solid #fb923c; }
    .cal-filter.cal-cowork.active { border-left: 3px solid #34d399; }
    @media (max-width: 768px) {
      .cal-cell { min-height: 80px; padding: 4px; }
      .cal-event { font-size: 10px; }
      .cal-weekday { font-size: 9px; padding: 6px; }
    }
  </style>
</Layout>
