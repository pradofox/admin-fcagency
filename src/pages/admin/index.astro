---
import Layout from '../../components/Layout.astro';
import { requireAdmin, labelRol } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { logAudit } from '../../lib/audit';
import { inviteUser } from '../../lib/auth';
import { sendEmail, buildInvitationHtml } from '../../lib/email';

// Mapeo de "perfil" (lo que el admin elige en UI) -> { rol, solo_district }
// Los valores 'admin' / 'editor' / 'viewer' van directo al CHECK de la DB,
// 'district' es el alias para editor + solo_district=1.
const PERFILES: Record<string, { rol: 'admin' | 'editor' | 'viewer'; solo_district: number; label: string }> = {
  admin:    { rol: 'admin',  solo_district: 0, label: 'Admin' },
  editor:   { rol: 'editor', solo_district: 0, label: 'Project Manager' },
  district: { rol: 'editor', solo_district: 1, label: 'Encargada District' },
  viewer:   { rol: 'viewer', solo_district: 0, label: 'Team' },
};

function perfilDeUser(rol: string, soloDistrict: number): string {
  if (rol === 'admin')  return 'admin';
  if (rol === 'viewer') return 'viewer';
  if (rol === 'editor') return soloDistrict ? 'district' : 'editor';
  return rol;
}

const user = requireAdmin(Astro);
const db = getDB(Astro);

let mensaje: string | null = null;
let mensajeError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;

  // ── Invitar nuevo usuario (no requiere userId previo) ────────────────────
  if (action === 'invitar') {
    const email = (form.get('email') as string)?.trim().toLowerCase() || '';
    const nombre = (form.get('nombre') as string)?.trim() || '';
    const perfilKey = (form.get('perfil') as string) || 'viewer';
    const perfil = PERFILES[perfilKey];
    if (!email || !nombre) {
      mensajeError = 'Email y nombre son obligatorios.';
    } else if (!perfil) {
      mensajeError = 'Perfil invalido.';
    } else {
      const res = await inviteUser(db as any, email, nombre, perfil.rol, !!perfil.solo_district);
      if ('error' in res) {
        mensajeError = res.error;
      } else {
        const origin = Astro.url.origin;
        const link = `${origin}/auth/verify?token=${res.token}`;
        const runtime = (Astro.locals as any).runtime;
        const apiKey = runtime?.env?.RESEND_API_KEY;
        const html = buildInvitationHtml(link, nombre, perfil.label, user.nombre);
        const sendRes = await sendEmail({ to: email, subject: `Invitación a FC Admin como ${perfil.label}`, html }, apiKey);
        await logAudit(db, { user, accion: 'create', entidad: 'usuario', entidad_id: res.userId, entidad_label: `${nombre} (${email})`, payload: { perfil: perfilKey, rol: perfil.rol, solo_district: perfil.solo_district, status: res.status, email_enviado: sendRes.ok } });
        if (sendRes.ok) {
          mensaje = res.status === 'ya_existia'
            ? `${nombre} ya tenía cuenta; perfil actualizado a ${perfil.label} y se mandó link nuevo a ${email}.`
            : `Invitación enviada a ${email} con perfil ${perfil.label} (válida 24 horas).`;
        } else {
          mensaje = `Cuenta creada con perfil ${perfil.label}, pero el envío de email falló: ${sendRes.error}. Link manual: ${link}`;
        }
      }
    }
  }

  const userId = form.get('user_id') as string;
  const target = userId
    ? await db.prepare('SELECT email, nombre, rol, activo FROM users WHERE id = ?').bind(userId).first<{ email: string; nombre: string; rol: string; activo: number }>()
    : null;
  const label = target ? `${target.nombre} (${target.email})` : null;

  if (action === 'change_perfil') {
    const perfilKey = form.get('perfil') as string;
    const perfil = PERFILES[perfilKey];
    if (perfil) {
      await db
        .prepare('UPDATE users SET rol = ?, solo_district = ?, updated_at = ? WHERE id = ?')
        .bind(perfil.rol, perfil.solo_district, now(), userId)
        .run();
      await logAudit(db, { user, accion: 'rol_change', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { a: perfilKey, rol: perfil.rol, solo_district: perfil.solo_district } });
      mensaje = `Perfil actualizado a ${perfil.label}.`;
    }
  } else if (action === 'toggle_activo') {
    const nuevo = form.get('nuevo') as string;
    const activoNuevo = nuevo === '1' ? 1 : 0;
    await db.prepare('UPDATE users SET activo = ?, updated_at = ? WHERE id = ?').bind(activoNuevo, now(), userId).run();
    await logAudit(db, { user, accion: 'state_change', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { activo: activoNuevo } });
    mensaje = 'Estado actualizado.';
  } else if (action === 'delete_sessions') {
    await db.prepare('DELETE FROM sessions WHERE user_id = ?').bind(userId).run();
    await logAudit(db, { user, accion: 'logout', entidad: 'sesion', entidad_id: userId, entidad_label: label, payload: { motivo: 'cerrar_sesiones_admin' } });
    mensaje = 'Sesiones cerradas.';
  } else if (action === 'assign_marcas') {
    const marcasSel = form.getAll('marca').map((v) => String(v)).filter(Boolean);
    await db.prepare('UPDATE users SET marcas = ?, updated_at = ? WHERE id = ?')
      .bind(JSON.stringify(marcasSel), now(), userId).run();
    await logAudit(db, { user, accion: 'update', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { marcas: marcasSel } });
    mensaje = 'Marcas asignadas. El usuario debe reiniciar sesión para aplicar el cambio.';
  }
}

const { results: users } = await db
  .prepare('SELECT id, email, nombre, rol, marcas, activo, created_at, ultimo_login, solo_district FROM users ORDER BY created_at DESC')
  .all<{ id: string; email: string; nombre: string; rol: string; marcas: string | null; activo: number; created_at: number; ultimo_login: number | null; solo_district: number }>();

const marcas = (await db.prepare('SELECT id, nombre FROM marcas WHERE activa = 1 ORDER BY orden').all<{ id: string; nombre: string }>()).results ?? [];

function parseMarcas(raw: string | null): string[] {
  try { return raw ? JSON.parse(raw) : []; } catch { return []; }
}
function nombreMarca(mid: string): string {
  return marcas.find((m) => m.id === mid)?.nombre ?? mid;
}
---

<Layout title="Admin" pageTitle="Administración">
  <div class="page-head">
    <h1>Usuarios</h1>
    <div style="display:flex;gap:10px">
      <a href="/admin/auditoria" class="btn btn-sm">Auditoría</a>
      <a href="/admin/importar" class="btn btn-sm">Importar CSV</a>
      <a href="/admin/duplicados" class="btn btn-sm">Limpieza de datos</a>
      <a href="/dashboard" class="btn btn-sm">Volver</a>
    </div>
  </div>

  <p class="text-muted" style="font-size:12px;margin-bottom:8px">
    Solo administradores ven esta página. Cambia roles, asigna marcas (scope), desactiva cuentas o cierra sesiones.
    Auto-registro está abierto: cualquiera con la URL puede crear cuenta como viewer.
  </p>
  <div class="card" style="margin-bottom:24px;font-size:12px;line-height:1.7">
    <strong style="color:var(--gold)">Roles:</strong>
    <span class="text-muted">
      <b>Admin</b> = todo, incluye catálogo de servicios y ganancias.
      <b>Project Manager</b> = todo menos catálogo de servicios y ganancias.
      <b>Encargada District</b> = solo District Studio (estudio, cowork, planes, miembros, inventario, pagos district) + dashboard, modelos, calendario y tareas. NO ve cosas de FC Agency (cotizaciones, producciones, briefs, redes, clientes, pagos FC).
      <b>Team</b> = solo dashboard, modelos, producciones, redes sociales, calendario y tareas. No ve precios.
    </span>
    <br /><span class="text-muted">El scope de marcas se aplica al reiniciar sesión del usuario.</span>
  </div>

  {mensaje      && <p class="text-ok"      style="margin-bottom:20px">{mensaje}</p>}
  {mensajeError && <p class="text-danger"  style="margin-bottom:20px">{mensajeError}</p>}

  {/* ── Invitar nuevo usuario ── */}
  <details style="background:var(--bg-2);border:1px solid var(--border);padding:18px;margin-bottom:24px">
    <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">
      + Invitar nuevo usuario
    </summary>
    <form method="POST" action="/admin" style="margin-top:14px">
      <input type="hidden" name="_action" value="invitar" />
      <div class="row">
        <div class="col" style="flex:2">
          <label class="label">Nombre completo *</label>
          <input class="input" name="nombre" required placeholder="Ej. Andrea Martínez" />
        </div>
        <div class="col" style="flex:2">
          <label class="label">Email *</label>
          <input class="input" type="email" name="email" required placeholder="andrea@fcagency.mx" />
        </div>
        <div class="col">
          <label class="label">Perfil *</label>
          <select class="select" name="perfil" required>
            <option value="viewer">Team (solo operativo, sin precios)</option>
            <option value="district">Encargada District (solo District Studio + modelos/calendario)</option>
            <option value="editor" selected>Project Manager (todo menos catálogo y ganancias)</option>
            <option value="admin">Admin (todo)</option>
          </select>
        </div>
      </div>
      <p class="text-muted" style="font-size:11px;margin-top:8px">
        Se manda un correo con un link de acceso (válido 24 horas) directo al rol elegido. Si ya tiene cuenta, se actualiza su rol y se reenvía el link.
      </p>
      <button type="submit" class="btn btn-primary" style="margin-top:8px">Mandar invitación</button>
    </form>
  </details>

  <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <thead>
        <tr style="border-bottom:1px solid var(--border);text-align:left">
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Nombre</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Email</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Rol</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Marcas (scope)</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Estado</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Creado</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Último login</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {users && users.map((u) => (
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:12px 10px">{u.nombre}</td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">{u.email}</td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" style="display:inline">
                <input type="hidden" name="_action" value="change_perfil" />
                <input type="hidden" name="user_id" value={u.id} />
                {(() => {
                  const perfilActual = perfilDeUser(u.rol, u.solo_district);
                  return (
                    <select name="perfil" onchange="this.form.submit()" class="select" style="font-size:12px;padding:5px 8px">
                      {Object.entries(PERFILES).map(([k, p]) => (
                        <option value={k} selected={perfilActual === k}>{p.label}</option>
                      ))}
                    </select>
                  );
                })()}
              </form>
            </td>
            <td style="padding:12px 10px">
              {(() => {
                const asignadas = parseMarcas(u.marcas);
                if (u.rol === 'admin') return <span class="text-muted" style="font-size:11px">todas</span>;
                if (marcas.length === 0) return <span class="text-muted" style="font-size:11px">—</span>;
                return (
                  <details>
                    <summary style="cursor:pointer;font-size:12px;list-style:none">
                      {asignadas.length === 0
                        ? <span class="text-muted">todas</span>
                        : asignadas.map((mid) => <span class="chip" style="font-size:10px;margin-right:3px">{nombreMarca(mid)}</span>)}
                      <span style="color:var(--gold);margin-left:4px;font-size:11px">editar</span>
                    </summary>
                    <form method="POST" action="/admin" style="margin-top:8px;display:flex;flex-direction:column;gap:5px">
                      <input type="hidden" name="_action" value="assign_marcas" />
                      <input type="hidden" name="user_id" value={u.id} />
                      {marcas.map((mk) => (
                        <label style="display:flex;align-items:center;gap:6px;font-size:12px">
                          <input type="checkbox" name="marca" value={mk.id} checked={asignadas.includes(mk.id)} />
                          {mk.nombre}
                        </label>
                      ))}
                      <button type="submit" class="btn btn-sm btn-primary" style="margin-top:4px;align-self:flex-start">Guardar</button>
                      <span class="text-muted" style="font-size:10px">Sin marcas = acceso a todas.</span>
                    </form>
                  </details>
                );
              })()}
            </td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" style="display:inline">
                <input type="hidden" name="_action" value="toggle_activo" />
                <input type="hidden" name="user_id" value={u.id} />
                <input type="hidden" name="nuevo" value={u.activo ? '0' : '1'} />
                <button type="submit" class={`chip ${u.activo ? 'chip-ok' : 'chip-danger'}`} style="border:0;cursor:pointer">
                  {u.activo ? 'Activo' : 'Inactivo'}
                </button>
              </form>
            </td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">
              {new Date(u.created_at).toLocaleDateString('es-MX')}
            </td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">
              {u.ultimo_login ? new Date(u.ultimo_login).toLocaleDateString('es-MX') : <span class="text-muted">—</span>}
            </td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" onsubmit="return confirm('¿Cerrar todas las sesiones de este usuario?')" style="display:inline">
                <input type="hidden" name="_action" value="delete_sessions" />
                <input type="hidden" name="user_id" value={u.id} />
                <button type="submit" class="btn btn-sm">Cerrar sesiones</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
