---
import Layout from '../../components/Layout.astro';
import { requireAdmin } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { logAudit } from '../../lib/audit';

const user = requireAdmin(Astro);
const db = getDB(Astro);

let mensaje: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;
  const userId = form.get('user_id') as string;

  const target = await db.prepare('SELECT email, nombre, rol, activo FROM users WHERE id = ?').bind(userId).first<{ email: string; nombre: string; rol: string; activo: number }>();
  const label = target ? `${target.nombre} (${target.email})` : null;

  if (action === 'change_rol') {
    const nuevoRol = form.get('rol') as string;
    if (['admin', 'editor', 'viewer'].includes(nuevoRol)) {
      await db.prepare('UPDATE users SET rol = ?, updated_at = ? WHERE id = ?').bind(nuevoRol, now(), userId).run();
      await logAudit(db, { user, accion: 'rol_change', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { de: target?.rol, a: nuevoRol } });
      mensaje = 'Rol actualizado.';
    }
  } else if (action === 'toggle_activo') {
    const nuevo = form.get('nuevo') as string;
    const activoNuevo = nuevo === '1' ? 1 : 0;
    await db.prepare('UPDATE users SET activo = ?, updated_at = ? WHERE id = ?').bind(activoNuevo, now(), userId).run();
    await logAudit(db, { user, accion: 'state_change', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { activo: activoNuevo } });
    mensaje = 'Estado actualizado.';
  } else if (action === 'delete_sessions') {
    await db.prepare('DELETE FROM sessions WHERE user_id = ?').bind(userId).run();
    await logAudit(db, { user, accion: 'logout', entidad: 'sesion', entidad_id: userId, entidad_label: label, payload: { motivo: 'cerrar_sesiones_admin' } });
    mensaje = 'Sesiones cerradas.';
  } else if (action === 'assign_marcas') {
    const marcasSel = form.getAll('marca').map((v) => String(v)).filter(Boolean);
    await db.prepare('UPDATE users SET marcas = ?, updated_at = ? WHERE id = ?')
      .bind(JSON.stringify(marcasSel), now(), userId).run();
    await logAudit(db, { user, accion: 'update', entidad: 'usuario', entidad_id: userId, entidad_label: label, payload: { marcas: marcasSel } });
    mensaje = 'Marcas asignadas. El usuario debe reiniciar sesión para aplicar el cambio.';
  }
}

const { results: users } = await db
  .prepare('SELECT id, email, nombre, rol, marcas, activo, created_at, ultimo_login FROM users ORDER BY created_at DESC')
  .all<{ id: string; email: string; nombre: string; rol: string; marcas: string | null; activo: number; created_at: number; ultimo_login: number | null }>();

const marcas = (await db.prepare('SELECT id, nombre FROM marcas WHERE activa = 1 ORDER BY orden').all<{ id: string; nombre: string }>()).results ?? [];

function parseMarcas(raw: string | null): string[] {
  try { return raw ? JSON.parse(raw) : []; } catch { return []; }
}
function nombreMarca(mid: string): string {
  return marcas.find((m) => m.id === mid)?.nombre ?? mid;
}
---

<Layout title="Admin" pageTitle="Administración">
  <div class="page-head">
    <h1>Usuarios</h1>
    <div style="display:flex;gap:10px">
      <a href="/admin/auditoria" class="btn btn-sm">Auditoría</a>
      <a href="/admin/importar" class="btn btn-sm">Importar CSV</a>
      <a href="/admin/duplicados" class="btn btn-sm">Limpieza de datos</a>
      <a href="/dashboard" class="btn btn-sm">Volver</a>
    </div>
  </div>

  <p class="text-muted" style="font-size:12px;margin-bottom:8px">
    Solo administradores ven esta página. Cambia roles, asigna marcas (scope), desactiva cuentas o cierra sesiones.
    Auto-registro está abierto: cualquiera con la URL puede crear cuenta como viewer.
  </p>
  <div class="card" style="margin-bottom:24px;font-size:12px;line-height:1.7">
    <strong style="color:var(--gold)">Roles:</strong>
    <span class="text-muted">
      <b>admin</b> = todo, incluye catálogo de servicios y ganancias.
      <b>editor</b> (Project Manager) = todo menos catálogo de servicios y ganancias.
      <b>viewer</b> (Team) = solo dashboard, modelos, producciones, redes sociales, calendario y tareas. No ve precios.
    </span>
    <br /><span class="text-muted">El scope de marcas se aplica al reiniciar sesión del usuario.</span>
  </div>

  {mensaje && <p class="text-ok" style="margin-bottom:20px">{mensaje}</p>}

  <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <thead>
        <tr style="border-bottom:1px solid var(--border);text-align:left">
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Nombre</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Email</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Rol</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Marcas (scope)</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Estado</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Creado</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Último login</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {users && users.map((u) => (
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:12px 10px">{u.nombre}</td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">{u.email}</td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" style="display:inline">
                <input type="hidden" name="_action" value="change_rol" />
                <input type="hidden" name="user_id" value={u.id} />
                <select name="rol" onchange="this.form.submit()" class="select" style="font-size:12px;padding:5px 8px">
                  {['admin', 'editor', 'viewer'].map((r) => (
                    <option value={r} selected={u.rol === r}>{r}</option>
                  ))}
                </select>
              </form>
            </td>
            <td style="padding:12px 10px">
              {(() => {
                const asignadas = parseMarcas(u.marcas);
                if (u.rol === 'admin') return <span class="text-muted" style="font-size:11px">todas</span>;
                if (marcas.length === 0) return <span class="text-muted" style="font-size:11px">—</span>;
                return (
                  <details>
                    <summary style="cursor:pointer;font-size:12px;list-style:none">
                      {asignadas.length === 0
                        ? <span class="text-muted">todas</span>
                        : asignadas.map((mid) => <span class="chip" style="font-size:10px;margin-right:3px">{nombreMarca(mid)}</span>)}
                      <span style="color:var(--gold);margin-left:4px;font-size:11px">editar</span>
                    </summary>
                    <form method="POST" action="/admin" style="margin-top:8px;display:flex;flex-direction:column;gap:5px">
                      <input type="hidden" name="_action" value="assign_marcas" />
                      <input type="hidden" name="user_id" value={u.id} />
                      {marcas.map((mk) => (
                        <label style="display:flex;align-items:center;gap:6px;font-size:12px">
                          <input type="checkbox" name="marca" value={mk.id} checked={asignadas.includes(mk.id)} />
                          {mk.nombre}
                        </label>
                      ))}
                      <button type="submit" class="btn btn-sm btn-primary" style="margin-top:4px;align-self:flex-start">Guardar</button>
                      <span class="text-muted" style="font-size:10px">Sin marcas = acceso a todas.</span>
                    </form>
                  </details>
                );
              })()}
            </td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" style="display:inline">
                <input type="hidden" name="_action" value="toggle_activo" />
                <input type="hidden" name="user_id" value={u.id} />
                <input type="hidden" name="nuevo" value={u.activo ? '0' : '1'} />
                <button type="submit" class={`chip ${u.activo ? 'chip-ok' : 'chip-danger'}`} style="border:0;cursor:pointer">
                  {u.activo ? 'Activo' : 'Inactivo'}
                </button>
              </form>
            </td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">
              {new Date(u.created_at).toLocaleDateString('es-MX')}
            </td>
            <td style="padding:12px 10px;color:var(--text-2);font-size:12px">
              {u.ultimo_login ? new Date(u.ultimo_login).toLocaleDateString('es-MX') : <span class="text-muted">—</span>}
            </td>
            <td style="padding:12px 10px">
              <form method="POST" action="/admin" onsubmit="return confirm('¿Cerrar todas las sesiones de este usuario?')" style="display:inline">
                <input type="hidden" name="_action" value="delete_sessions" />
                <input type="hidden" name="user_id" value={u.id} />
                <button type="submit" class="btn btn-sm">Cerrar sesiones</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
