---
import Layout from '../../components/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../lib/session';
import { getDB } from '../../lib/db';

const user = requireUser(Astro);
const db = getDB(Astro);

const filtroTipo = Astro.url.searchParams.get('tipo') ?? 'todos';
const filtroEstatus = Astro.url.searchParams.get('estatus') ?? 'todos';
const search = (Astro.url.searchParams.get('q') ?? '').trim();
const tipos = ['todos', 'cliente', 'modelo', 'proveedor', 'aspirante', 'colaborador'];
const estatusList = [
  'todos', 'nuevo_contacto', 'cotizacion_enviada', 'en_negociacion', 'confirmado',
  'en_produccion', 'post_produccion', 'pago_pendiente', 'cerrado'
];

const where: string[] = [];
const params: string[] = [];
if (search) {
  const like = `%${search}%`;
  where.push('(nombre LIKE ? OR email LIKE ? OR whatsapp LIKE ? OR empresa LIKE ? OR notas LIKE ?)');
  params.push(like, like, like, like, like);
}
if (filtroTipo !== 'todos') { where.push('tipo = ?'); params.push(filtroTipo); }
if (filtroEstatus !== 'todos') { where.push('estatus_crm = ?'); params.push(filtroEstatus); }

const whereClause = where.length ? `WHERE ${where.join(' AND ')}` : '';
const stmt = db.prepare(
  `SELECT id, nombre, tipo, estatus_crm, marca_id, canal, whatsapp, email, next_action_date, next_action_text
   FROM contactos ${whereClause}
   ORDER BY next_action_date ASC, created_at DESC
   LIMIT 300`
);
const { results } = await (params.length ? stmt.bind(...params) : stmt).all<any>();

const chipTipo: Record<string, string> = {
  cliente: 'chip-gold',
  modelo: 'chip-ok',
  proveedor: 'chip',
  aspirante: 'chip-warning',
  colaborador: 'chip'
};
---

<Layout title="Contactos" pageTitle="Contactos">
  <div class="page-head">
    <h1>Contactos</h1>
    <div style="display:flex;gap:8px">
      <a href="/clientes" class="btn btn-sm">← Clientes</a>
      {canEdit(user) && <a href="/contactos/nuevo" class="btn btn-primary">+ Nuevo</a>}
    </div>
  </div>

  <form method="GET" action="/contactos" class="toolbar">
    <input class="input" type="search" name="q" value={search} placeholder="Buscar por nombre, email, whatsapp, empresa, notas…" />
  </form>

  <div class="filters">
    {tipos.map((t) => (
      <a href={`/contactos?tipo=${t}${filtroEstatus !== 'todos' ? `&estatus=${filtroEstatus}` : ''}`}
         class={`filter-chip ${filtroTipo === t ? 'active' : ''}`}>{t}</a>
    ))}
  </div>

  <div class="filters">
    {estatusList.map((e) => (
      <a href={`/contactos?estatus=${e}${filtroTipo !== 'todos' ? `&tipo=${filtroTipo}` : ''}`}
         class={`filter-chip ${filtroEstatus === e ? 'active' : ''}`}>{e.replace(/_/g, ' ')}</a>
    ))}
  </div>

  {results && results.length > 0 ? (
    <div class="grid">
      {results.map((c: any) => (
        <a href={`/contactos/${c.id}`} style="display:block;color:inherit;text-decoration:none">
          <article class="card">
            <div class="card-title">{c.nombre}</div>
            <div class="card-meta">
              <span class={`chip ${chipTipo[c.tipo] ?? ''}`}>{c.tipo}</span>
              <span class="chip">{c.estatus_crm?.replace(/_/g, ' ') ?? 'sin estatus'}</span>
              {c.marca_id && <span>{c.marca_id}</span>}
              {c.canal && <span class="text-muted">{c.canal}</span>}
              {c.next_action_date && (
                <span class="text-muted">⏵ {c.next_action_date}{c.next_action_text ? ` — ${c.next_action_text}` : ''}</span>
              )}
            </div>
          </article>
        </a>
      ))}
    </div>
  ) : (
    <EmptyState title="Sin contactos" message="No hay contactos con esos filtros." />
  )}
</Layout>
