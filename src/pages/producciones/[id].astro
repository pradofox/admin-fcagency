---
import Layout from '../../components/Layout.astro';
import ProduccionForm from '../../components/producciones/ProduccionForm.astro';
import NotasTimeline from '../../components/NotasTimeline.astro';
import { requireUser, canEdit, canSeePrecios } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { newId } from '../../lib/ids';
import { formatFecha } from '../../lib/fechas';
import { enviarAvisosProduccion, recolectarDestinatarios, type GrupoAviso } from '../../lib/avisos';
import { logAudit } from '../../lib/audit';

const user = requireUser(Astro);
const verPrecios = canSeePrecios(user);
// produccion es visible para todos los roles, pero los montos se ocultan
// para viewer (Team) que no debe ver costos/cobros.
const editable = canEdit(user);
const db = getDB(Astro);
const { id } = Astro.params;

let error: string | null = null;
let saved = false;
let avisoMsg: string | null = null;

interface Linea {
  id: string;
  rol: string;
  nombre_libre: string | null;
  proveedor_id: string | null;
  modelo_id: string | null;
  cobro_cliente: number;
  comision_pct: number;
  pago_proveedor: number;
  estado: string;
  notas: string | null;
  hora_llamado: string | null;
}

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const method = form.get('_method');
  const action = form.get('_action');

  if (action === 'add_nota') {
    const texto = (form.get('nota_texto') as string)?.trim();
    if (texto) {
      await db
        .prepare(
          `INSERT INTO notas (id, entidad_tipo, entidad_id, texto, autor_user_id, autor_nombre, created_at)
           VALUES (?, 'produccion', ?, ?, ?, ?, ?)`
        )
        .bind(newId(), id, texto, user.id, user.nombre, now())
        .run();
    }
    return Astro.redirect(`/producciones/${id}`);
  }

  if (action === 'delete_nota') {
    const notaId = form.get('nota_id') as string;
    if (notaId) {
      const cond = user.rol === 'admin' ? '' : 'AND autor_user_id = ?';
      const stmt = user.rol === 'admin'
        ? db.prepare(`DELETE FROM notas WHERE id = ? AND entidad_tipo = 'produccion' AND entidad_id = ?`).bind(notaId, id)
        : db.prepare(`DELETE FROM notas WHERE id = ? AND entidad_tipo = 'produccion' AND entidad_id = ? AND autor_user_id = ?`).bind(notaId, id, user.id);
      await stmt.run();
    }
    return Astro.redirect(`/producciones/${id}`);
  }

  if (method === 'DELETE') {
    const prev = await db.prepare('SELECT titulo FROM producciones WHERE id = ?').bind(id).first<{ titulo: string }>();
    await db.prepare('DELETE FROM producciones WHERE id = ?').bind(id).run();
    await logAudit(db, { user, accion: 'delete', entidad: 'produccion', entidad_id: id, entidad_label: prev?.titulo ?? null });
    return Astro.redirect('/producciones');
  }

  if (action === 'add_linea') {
    const lineaId = newId();
    const ts = now();
    const rol = (form.get('linea_rol') as string)?.trim() || 'Otro';
    let nombre = (form.get('linea_nombre') as string)?.trim() || '';
    const cobro = Number(form.get('linea_cobro')) || 0;
    const comision = Number(form.get('linea_comision')) || 20;
    const modeloId = (form.get('linea_modelo_id') as string)?.trim() || null;
    const horaLlamado = (form.get('linea_hora_llamado') as string)?.trim() || null;
    // Si se eligió un modelo registrado y no se escribió nombre, usar el del modelo
    if (modeloId && !nombre) {
      const mm = await db.prepare('SELECT nombre FROM modelos WHERE id = ?').bind(modeloId).first<any>();
      nombre = mm?.nombre ?? '';
    }
    await db
      .prepare(
        `INSERT INTO lineas_produccion (
          id, produccion_id, rol, nombre_libre, modelo_id, cobro_cliente, comision_pct, hora_llamado, estado, created_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pendiente', ?)`
      )
      .bind(lineaId, id, rol, nombre || null, modeloId, cobro, comision, horaLlamado, ts)
      .run();
    return Astro.redirect(`/producciones/${id}`);
  }

  // ── Enviar convocatoria / recordatorio ───────────────────────────────────
  if (action === 'enviar_avisos') {
    const tipo = (form.get('tipo') as string) === 'recordatorio' ? 'recordatorio' : 'convocatoria';
    const grupos: GrupoAviso[] = [];
    if (form.get('g_modelos') === '1') grupos.push('modelos');
    if (form.get('g_proveedores') === '1') grupos.push('proveedores');
    if (form.get('g_cliente') === '1') grupos.push('cliente');
    if (grupos.length === 0) {
      avisoMsg = 'Selecciona al menos un grupo de destinatarios.';
    } else {
      const prodRow = await db.prepare('SELECT * FROM producciones WHERE id = ?').bind(id).first<any>();
      const cli = prodRow?.cliente_id
        ? await db.prepare('SELECT nombre FROM clientes WHERE id = ?').bind(prodRow.cliente_id).first<any>()
        : null;
      const runtime = (Astro.locals as any).runtime;
      const resendKey = runtime?.env?.RESEND_API_KEY;
      const appUrl    = runtime?.env?.APP_URL ?? Astro.url.origin;
      const r = await enviarAvisosProduccion(db, prodRow, resendKey, {
        tipo, grupos, clienteNombre: cli?.nombre ?? null, appUrl,
      });
      avisoMsg = r.enviados === 0 && r.errores === 0
        ? 'No había destinatarios con correo en los grupos elegidos.'
        : `${tipo === 'recordatorio' ? 'Recordatorio' : 'Convocatoria'}: ${r.enviados} enviado(s)${r.errores ? `, ${r.errores} con error` : ''}.`;
    }
  }

  if (action === 'delete_linea') {
    const lineaId = form.get('linea_id') as string;
    if (lineaId) {
      await db.prepare('DELETE FROM lineas_produccion WHERE id = ? AND produccion_id = ?').bind(lineaId, id).run();
    }
    return Astro.redirect(`/producciones/${id}`);
  }

  if (action === 'toggle_linea_pagada') {
    const lineaId = form.get('linea_id') as string;
    const nuevo = form.get('nuevo_estado') as string;
    if (lineaId && (nuevo === 'pendiente' || nuevo === 'pagado' || nuevo === 'cancelado')) {
      await db.prepare('UPDATE lineas_produccion SET estado = ? WHERE id = ? AND produccion_id = ?').bind(nuevo, lineaId, id).run();
      // Sincronizar tarea(s) ligada(s) a esta linea
      if (nuevo === 'pagado') {
        await db
          .prepare("UPDATE acciones_calendario SET estado = 'completada', done = 1, updated_at = ? WHERE linea_produccion_id = ? AND estado != 'completada'")
          .bind(now(), lineaId).run();
      } else if (nuevo === 'pendiente') {
        await db
          .prepare("UPDATE acciones_calendario SET estado = 'pendiente', done = 0, updated_at = ? WHERE linea_produccion_id = ?")
          .bind(now(), lineaId).run();
      } else if (nuevo === 'cancelado') {
        await db
          .prepare("UPDATE acciones_calendario SET estado = 'cancelada', done = 1, updated_at = ? WHERE linea_produccion_id = ?")
          .bind(now(), lineaId).run();
      }
    }
    return Astro.redirect(`/producciones/${id}`);
  }

  if (action === 'update_semaforo') {
    const field = form.get('field') as string;
    const value = form.get('value') as string;
    const allowed = ['pago_cliente_estado', 'pago_modelo_estado', 'material_recibido', 'retro_enviada', 'estado'];
    if (allowed.includes(field)) {
      const prev = await db.prepare('SELECT titulo FROM producciones WHERE id = ?').bind(id).first<{ titulo: string }>();
      await db.prepare(`UPDATE producciones SET ${field} = ?, updated_at = ? WHERE id = ?`).bind(value, now(), id).run();
      await logAudit(db, { user, accion: 'state_change', entidad: 'produccion', entidad_id: id, entidad_label: prev?.titulo ?? null, payload: { campo: field, valor: value } });
    }
    return Astro.redirect(`/producciones/${id}`);
  }

  // Update producción (solo cuando el form no trae _action)
  const titulo = (form.get('titulo') as string)?.trim();
  if (action) {
    // ya manejado arriba (p. ej. enviar_avisos que no redirige)
  } else if (!titulo) {
    error = 'El título es obligatorio.';
  } else {
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    const getNum = (k: string) => {
      const v = form.get(k);
      if (v === null || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    };
    await db
      .prepare(
        `UPDATE producciones SET
          titulo = ?, cliente_id = ?, marca_id = ?, tipo_produccion = ?,
          fecha_inicio = ?, fecha_fin = ?, hora_inicio = ?, hora_fin = ?,
          ubicacion_mua = ?, ubicacion_shoot = ?, estado = ?,
          presupuesto = ?, notas = ?,
          proximo_paso = ?, fecha_proxima_accion = ?, material_pendiente = ?,
          equipo_involucrado = ?, links_referencias = ?, archivos_referencias = ?,
          updated_at = ?
        WHERE id = ?`
      )
      .bind(
        titulo,
        get('cliente_id'),
        get('marca_id'),
        get('tipo_produccion'),
        get('fecha_inicio'),
        get('fecha_fin'),
        get('hora_inicio'),
        get('hora_fin'),
        get('ubicacion_mua'),
        get('ubicacion_shoot'),
        get('estado') ?? 'planeacion',
        getNum('presupuesto'),
        get('notas'),
        get('proximo_paso'),
        get('fecha_proxima_accion'),
        get('material_pendiente'),
        get('equipo_involucrado'),
        get('links_referencias'),
        get('archivos_referencias'),
        now(),
        id
      )
      .run();
    await logAudit(db, { user, accion: 'update', entidad: 'produccion', entidad_id: id, entidad_label: titulo });
    saved = true;
  }
}

const prod = await db.prepare('SELECT * FROM producciones WHERE id = ?').bind(id).first<any>();
if (!prod) return Astro.redirect('/producciones');

const marcas = (await db.prepare('SELECT id, nombre FROM marcas WHERE activa = 1 ORDER BY orden').all<{ id: string; nombre: string }>()).results ?? [];
const clientes = (await db.prepare('SELECT id, nombre FROM clientes ORDER BY nombre').all<{ id: string; nombre: string }>()).results ?? [];

const { results: lineas } = await db
  .prepare(
    `SELECT id, rol, nombre_libre, proveedor_id, modelo_id,
            cobro_cliente, comision_pct, pago_proveedor, estado, notas, hora_llamado
     FROM lineas_produccion WHERE produccion_id = ? ORDER BY created_at`
  )
  .bind(id)
  .all<Linea>();

const { results: tareasProd } = await db
  .prepare(
    `SELECT a.id, a.tarea, a.fecha, a.prioridad, a.estado, u.nombre as asignado_nombre
     FROM acciones_calendario a
     LEFT JOIN users u ON u.id = a.asignado_a
     WHERE a.produccion_id = ?
     ORDER BY
       CASE a.estado WHEN 'pendiente' THEN 0 WHEN 'en_curso' THEN 1 ELSE 2 END,
       a.fecha ASC`
  )
  .bind(id)
  .all<any>();

// Modelos registrados (para el selector al agregar línea de modelo)
const { results: modelosActivos } = await db
  .prepare(`SELECT id, nombre FROM modelos WHERE estado != 'archivado' ORDER BY nombre`)
  .all<any>();

// Modelos asignados a esta producción (líneas con modelo_id)
const { results: modelosAsignados } = await db
  .prepare(
    `SELECT DISTINCT m.id, m.nombre, lp.rol
     FROM lineas_produccion lp
     JOIN modelos m ON m.id = lp.modelo_id
     WHERE lp.produccion_id = ? AND lp.estado != 'cancelado'
     ORDER BY m.nombre`
  )
  .bind(id)
  .all<any>();

// Nombres resueltos para la ficha
const clienteNombre = prod.cliente_id ? (clientes.find((c: any) => c.id === prod.cliente_id)?.nombre ?? null) : null;
const marcaNombre   = prod.marca_id ? (marcas.find((m: any) => m.id === prod.marca_id)?.nombre ?? null) : null;

// ── Avisos: destinatarios disponibles e historial ──────────────────────────
const destModelos = await recolectarDestinatarios(db, prod, ['modelos']);
const destProveedores = await recolectarDestinatarios(db, prod, ['proveedores']);
const destCliente = await recolectarDestinatarios(db, prod, ['cliente']);

const { results: notifsHist } = await db
  .prepare(
    `SELECT tipo, destinatario_tipo, destinatario_nombre, email, estado, detalle, enviado_en
     FROM notificaciones WHERE produccion_id = ? ORDER BY enviado_en DESC LIMIT 50`
  )
  .bind(id)
  .all<any>();

function fechaHora(ms: number): string {
  try {
    return new Intl.DateTimeFormat('es-MX', {
      day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
    }).format(new Date(ms));
  } catch {
    return '';
  }
}

const totalCobro = (lineas ?? []).reduce((a, l) => a + (l.cobro_cliente || 0), 0);
const totalPago = (lineas ?? []).reduce((a, l) => a + (l.pago_proveedor || 0), 0);
const utilidad = totalCobro - totalPago;

const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-MX')} MXN`;

const ROLES = [
  'Fotografía', 'Video', 'Modelo', 'Maquillaje', 'Peinado', 'Styling',
  'Pantallas', 'Audio', 'Iluminación', 'Operación', 'Montaje', 'Desmontaje', 'Traslado',
  'Estudio', 'Day pass', 'Espacio de talleres', 'Otro'
];
---

<Layout title={`Editar — ${prod.titulo}`} pageTitle={prod.titulo}>
  <div class="page-head">
    <h1>{prod.titulo}</h1>
    <div style="display:flex;gap:10px">
      <a href="/producciones" class="btn btn-sm">Volver</a>
      {editable && (
        <form method="POST" action={`/producciones/${id}`} onsubmit="return confirm('¿Eliminar esta producción y todas sus líneas?')" style="display:inline">
          <input type="hidden" name="_method" value="DELETE" />
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      )}
    </div>
  </div>

  {saved && <p class="text-ok" style="margin-bottom:20px">Guardado.</p>}
  {error && <p class="text-danger" style="margin-bottom:20px">{error}</p>}

  <div class="grid-dense" style="margin-bottom:24px">
    <div class="stat stat-gold">
      <div class="stat-value">{fmt(totalCobro)}</div>
      <div class="stat-label">Cobro total</div>
    </div>
    <div class="stat">
      <div class="stat-value">{fmt(totalPago)}</div>
      <div class="stat-label">Pago proveedores</div>
    </div>
    <div class="stat stat-ok">
      <div class="stat-value">{fmt(utilidad)}</div>
      <div class="stat-label">Utilidad</div>
    </div>
  </div>

  {/* ── Ficha: resumen organizado ── */}
  <div class="card" style="margin-bottom:24px">
    <div class="ficha">
      <div class="ficha-item">
        <div class="ficha-label">Cliente</div>
        <div class="ficha-val">{prod.cliente_id ? <a href={`/clientes/${prod.cliente_id}`} style="color:inherit">{clienteNombre}</a> : <span class="text-muted">—</span>}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Marca</div>
        <div class="ficha-val">{marcaNombre ?? <span class="text-muted">—</span>}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Tipo</div>
        <div class="ficha-val">{prod.tipo_produccion ? <span class="chip">{prod.tipo_produccion}</span> : <span class="text-muted">—</span>}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Estatus / cierre</div>
        <div class="ficha-val"><span class="chip">{(prod.estado ?? 'planeacion').replace(/_/g, ' ')}</span></div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Fecha</div>
        <div class="ficha-val mono">{prod.fecha_inicio ? formatFecha(prod.fecha_inicio) : '—'}{prod.fecha_fin && prod.fecha_fin !== prod.fecha_inicio ? ` — ${formatFecha(prod.fecha_fin)}` : ''}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Horario</div>
        <div class="ficha-val mono">{prod.hora_inicio ? `${prod.hora_inicio}${prod.hora_fin ? ' – ' + prod.hora_fin : ''}` : '—'}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Ubicación maquillaje</div>
        <div class="ficha-val">{prod.ubicacion_mua ?? <span class="text-muted">—</span>}</div>
      </div>
      <div class="ficha-item">
        <div class="ficha-label">Ubicación shoot</div>
        <div class="ficha-val">{prod.ubicacion_shoot ?? <span class="text-muted">—</span>}</div>
      </div>
      {verPrecios && (
        <div class="ficha-item">
          <div class="ficha-label">Presupuesto</div>
          <div class="ficha-val mono" style="color:var(--gold)">{prod.presupuesto ? fmt(prod.presupuesto) : '—'}</div>
        </div>
      )}
      <div class="ficha-item">
        <div class="ficha-label">Equipo involucrado</div>
        <div class="ficha-val">{prod.equipo_involucrado ?? <span class="text-muted">—</span>}</div>
      </div>
    </div>
  </div>

  {/* ── Modelos asignados ── */}
  <div class="card" style="margin-bottom:24px">
    <div class="card-meta" style="margin-bottom:8px">Modelos asignados</div>
    {modelosAsignados && modelosAsignados.length > 0 ? (
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        {(modelosAsignados as any[]).map((m) => (
          <a href={`/modelos/${m.id}`} class="chip" style="text-decoration:none;color:var(--gold)">
            {m.nombre}{m.rol ? <span class="text-muted" style="margin-left:5px;font-size:10px">{m.rol}</span> : null}
          </a>
        ))}
      </div>
    ) : (
      <p class="text-muted" style="font-size:12px;margin:0">Sin modelos registrados vinculados. Agrégalos como línea con rol "Modelo" eligiendo el modelo del catálogo.</p>
    )}
  </div>

  {/* ── Avisos y recordatorios ── */}
  <div class="card" style="margin-bottom:24px">
    <div class="card-meta" style="margin-bottom:10px">Avisos y recordatorios</div>
    {avisoMsg && (
      <p style="margin:0 0 14px;padding:9px 12px;background:var(--bg-3,#1a1a1a);border-left:3px solid var(--gold);font-size:13px">{avisoMsg}</p>
    )}
    {editable ? (
      <form method="POST" action={`/producciones/${id}`}>
        <input type="hidden" name="_action" value="enviar_avisos" />
        <p class="text-muted" style="font-size:12px;margin:0 0 12px">
          Envía la convocatoria (detalles de la producción) o un recordatorio por correo a los grupos elegidos.
          Solo se envía a quienes tienen email registrado.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:18px;margin-bottom:14px">
          <label style={`display:flex;align-items:center;gap:7px;font-size:13px;${destModelos.length === 0 ? 'opacity:.45' : ''}`}>
            <input type="checkbox" name="g_modelos" value="1" checked={destModelos.length > 0} disabled={destModelos.length === 0} />
            Modelos <span class="text-muted mono">({destModelos.length})</span>
          </label>
          <label style={`display:flex;align-items:center;gap:7px;font-size:13px;${destProveedores.length === 0 ? 'opacity:.45' : ''}`}>
            <input type="checkbox" name="g_proveedores" value="1" checked={destProveedores.length > 0} disabled={destProveedores.length === 0} />
            Proveedores <span class="text-muted mono">({destProveedores.length})</span>
          </label>
          <label style={`display:flex;align-items:center;gap:7px;font-size:13px;${destCliente.length === 0 ? 'opacity:.45' : ''}`}>
            <input type="checkbox" name="g_cliente" value="1" disabled={destCliente.length === 0} />
            Cliente <span class="text-muted mono">({destCliente.length})</span>
          </label>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <button type="submit" name="tipo" value="convocatoria" class="btn btn-primary btn-sm">Enviar convocatoria</button>
          <button type="submit" name="tipo" value="recordatorio" class="btn btn-sm">Enviar recordatorio</button>
        </div>
      </form>
    ) : (
      <p class="text-muted" style="font-size:12px;margin:0">Solo lectura.</p>
    )}

    {notifsHist && notifsHist.length > 0 && (
      <div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px">
        <div class="card-meta" style="margin-bottom:8px">Historial de envíos</div>
        <div style="display:flex;flex-direction:column;gap:5px">
          {(notifsHist as any[]).map((n) => (
            <div style="display:flex;align-items:center;gap:10px;font-size:12px;flex-wrap:wrap">
              <span class="chip" style="font-size:10px">{n.tipo}</span>
              <span class={`chip ${n.estado === 'enviado' ? 'chip-ok' : 'chip-danger'}`} style="font-size:10px">{n.estado}</span>
              <span>{n.destinatario_nombre ?? n.email}</span>
              <span class="text-muted" style="font-size:11px">{n.destinatario_tipo}</span>
              <span class="text-muted mono" style="font-size:11px;margin-left:auto">{fechaHora(n.enviado_en)}</span>
              {n.estado === 'error' && n.detalle && <span class="text-danger" style="font-size:11px;width:100%">{n.detalle}</span>}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  {/* ── Links y archivos ── */}
  {(prod.links_referencias || prod.archivos_referencias) && (
    <div class="row" style="margin-bottom:24px">
      {prod.links_referencias && (
        <div class="col card">
          <div class="card-meta" style="margin-bottom:8px">Links / referencias</div>
          {String(prod.links_referencias).split('\n').filter((s: string) => s.trim()).map((line: string) => {
            const t = line.trim();
            return /^https?:\/\//.test(t)
              ? <div><a href={t} target="_blank" rel="noopener" style="color:var(--gold);font-size:13px;word-break:break-all">{t}</a></div>
              : <div style="font-size:13px">{t}</div>;
          })}
        </div>
      )}
      {prod.archivos_referencias && (
        <div class="col card">
          <div class="card-meta" style="margin-bottom:8px">Archivos / entregables</div>
          {String(prod.archivos_referencias).split('\n').filter((s: string) => s.trim()).map((line: string) => {
            const t = line.trim();
            return /^https?:\/\//.test(t)
              ? <div><a href={t} target="_blank" rel="noopener" style="color:var(--gold);font-size:13px;word-break:break-all">{t}</a></div>
              : <div style="font-size:13px">{t}</div>;
          })}
        </div>
      )}
    </div>
  )}

  {(prod.fecha_proxima_accion || prod.proximo_paso) && (
    <div class="card" style="margin-bottom:24px;border-left:3px solid var(--gold)">
      <div class="card-meta">Próxima acción</div>
      <div style="display:flex;gap:16px;align-items:center;margin-top:6px">
        {prod.fecha_proxima_accion && <span class="mono" style="color:var(--gold)">{formatFecha(prod.fecha_proxima_accion)}</span>}
        {prod.proximo_paso && <span>{prod.proximo_paso}</span>}
      </div>
    </div>
  )}

  <h2>Estado de post-producción</h2>
  <div class="row" style="margin-bottom:32px">
    {verPrecios && (
      <div class="col card">
        <div class="card-meta">Pago cliente</div>
        <form method="POST" action={`/producciones/${id}`} style="margin-top:8px">
          <input type="hidden" name="_action" value="update_semaforo" />
          <input type="hidden" name="field" value="pago_cliente_estado" />
          <select class="select" name="value" onchange="this.form.submit()" style="font-size:13px" disabled={!editable}>
            {['pendiente', 'anticipo_recibido', 'pagado', 'no_aplica'].map((e) => (
              <option value={e} selected={(prod.pago_cliente_estado ?? 'pendiente') === e}>{e.replace(/_/g, ' ')}</option>
            ))}
          </select>
        </form>
      </div>
    )}
    {verPrecios && (
      <div class="col card">
        <div class="card-meta">Pago modelo</div>
        <form method="POST" action={`/producciones/${id}`} style="margin-top:8px">
          <input type="hidden" name="_action" value="update_semaforo" />
          <input type="hidden" name="field" value="pago_modelo_estado" />
          <select class="select" name="value" onchange="this.form.submit()" style="font-size:13px" disabled={!editable}>
            {['por_pagar', 'pagado', 'no_aplica'].map((e) => (
              <option value={e} selected={(prod.pago_modelo_estado ?? 'por_pagar') === e}>{e.replace(/_/g, ' ')}</option>
            ))}
          </select>
        </form>
      </div>
    )}
    <div class="col card">
      <div class="card-meta">Material</div>
      <form method="POST" action={`/producciones/${id}`} style="margin-top:8px">
        <input type="hidden" name="_action" value="update_semaforo" />
        <input type="hidden" name="field" value="material_recibido" />
        <select class="select" name="value" onchange="this.form.submit()" style="font-size:13px" disabled={!editable}>
          <option value="0" selected={!prod.material_recibido}>Pendiente</option>
          <option value="1" selected={!!prod.material_recibido}>Recibido</option>
        </select>
      </form>
    </div>
    <div class="col card">
      <div class="card-meta">Retro</div>
      <form method="POST" action={`/producciones/${id}`} style="margin-top:8px">
        <input type="hidden" name="_action" value="update_semaforo" />
        <input type="hidden" name="field" value="retro_enviada" />
        <select class="select" name="value" onchange="this.form.submit()" style="font-size:13px" disabled={!editable}>
          <option value="0" selected={!prod.retro_enviada}>Pendiente</option>
          <option value="1" selected={!!prod.retro_enviada}>Enviada</option>
        </select>
      </form>
    </div>
  </div>

  <h2 style="margin-top:32px">Líneas de producción</h2>
  <p class="text-muted" style="font-size:12px;margin-bottom:16px">
    Cada línea es un proveedor o modelo asignado. El pago al proveedor se calcula
    automáticamente como cobro × (100 − comisión)/100.
  </p>

  {lineas && lineas.length > 0 ? (
    <div class="table-card" style="margin-bottom:16px">
      <table>
        <thead>
          <tr>
            <th>Rol</th>
            <th>Nombre</th>
            <th>Llamado</th>
            {verPrecios && <th class="right">Cobro</th>}
            {verPrecios && <th class="right">Comisión</th>}
            {verPrecios && <th class="right">Pago</th>}
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {lineas.map((l) => (
            <tr>
              <td><span class="chip">{l.rol}</span></td>
              <td>{l.nombre_libre ?? <span class="text-muted">—</span>}</td>
              <td class="mono text-muted">{l.hora_llamado ?? '—'}</td>
              {verPrecios && <td class="right mono">{fmt(l.cobro_cliente)}</td>}
              {verPrecios && <td class="right mono text-muted">{l.comision_pct}%</td>}
              {verPrecios && <td class="right mono text-gold">{fmt(l.pago_proveedor)}</td>}
              <td>
                {editable ? (
                  <form method="POST" action={`/producciones/${id}`} style="display:inline">
                    <input type="hidden" name="_action" value="toggle_linea_pagada" />
                    <input type="hidden" name="linea_id" value={l.id} />
                    <input type="hidden" name="nuevo_estado" value={l.estado === 'pagado' ? 'pendiente' : 'pagado'} />
                    <button type="submit" class={`chip ${l.estado === 'pagado' ? 'chip-ok' : 'chip-warning'}`} style="border:0;cursor:pointer;font-family:var(--font-mono)">
                      {l.estado}
                    </button>
                  </form>
                ) : (
                  <span class={`chip ${l.estado === 'pagado' ? 'chip-ok' : 'chip-warning'}`}>{l.estado}</span>
                )}
              </td>
              <td class="right">
                {editable && (
                  <form method="POST" action={`/producciones/${id}`} onsubmit="return confirm('¿Eliminar esta línea?')" style="display:inline">
                    <input type="hidden" name="_action" value="delete_linea" />
                    <input type="hidden" name="linea_id" value={l.id} />
                    <button type="submit" class="btn btn-sm btn-danger" style="padding:2px 7px">×</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="text-muted" style="margin-bottom:16px">Aún no hay líneas.</p>
  )}

  <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:32px">
    <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Agregar línea</summary>
    <form method="POST" action={`/producciones/${id}`} style="margin-top:16px">
      <input type="hidden" name="_action" value="add_linea" />
      <div class="row">
        <div class="col">
          <label class="label">Rol</label>
          <select class="select" name="linea_rol" id="linea_rol" required>
            {ROLES.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <div class="col" id="col_modelo" style="display:none">
          <label class="label">Modelo registrado</label>
          <select class="select" name="linea_modelo_id" id="linea_modelo_id">
            <option value="">— sin vincular / externo —</option>
            {(modelosActivos as any[])?.map((m) => <option value={m.id}>{m.nombre}</option>)}
          </select>
        </div>
        <div class="col">
          <label class="label">Nombre</label>
          <input class="input" name="linea_nombre" id="linea_nombre" placeholder="Persona o proveedor" />
        </div>
        <div class="col">
          <label class="label">Hora de llamado</label>
          <input class="input" type="time" name="linea_hora_llamado" id="linea_hora_llamado" />
        </div>
        <div class="col">
          <label class="label">Cobro al cliente (MXN)</label>
          <input class="input" type="number" step="0.01" name="linea_cobro" required />
        </div>
        <div class="col">
          <label class="label">Comisión %</label>
          <input class="input" type="number" step="0.01" name="linea_comision" value="20" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary" style="margin-top:16px">Agregar</button>
    </form>
  </details>

  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:32px;margin-bottom:14px">
    <h2 style="margin:0">Tareas</h2>
    {editable && <a href={`/tareas/nuevo?produccion_id=${id}`} class="btn btn-sm">+ Nueva tarea</a>}
  </div>
  {tareasProd && tareasProd.length > 0 ? (
    <div style="margin-bottom:24px">
      {tareasProd.map((t: any) => (
        <a href={`/tareas/${t.id}`} class="card" style={`display:block;color:inherit;text-decoration:none;margin-bottom:6px;${t.estado === 'completada' ? 'opacity:.6' : ''}`}>
          <div style="display:flex;justify-content:space-between;gap:14px">
            <div style="flex:1;min-width:0">
              <div style={`font-weight:500;${t.estado === 'completada' ? 'text-decoration:line-through' : ''}`}>{t.tarea}</div>
              <div class="card-meta" style="margin-top:4px">
                {t.fecha && <span class="mono">{formatFecha(t.fecha)}</span>}
                {t.asignado_nombre && <span class="text-muted">→ {t.asignado_nombre}</span>}
              </div>
            </div>
            <div style="display:flex;gap:6px;align-items:center">
              <span class={`chip ${t.estado === 'completada' ? 'chip-ok' : t.estado === 'en_curso' ? 'chip-gold' : 'chip-warning'}`}>{t.estado.replace('_', ' ')}</span>
              {t.prioridad === 'Alta' && <span class="chip chip-danger">Alta</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-muted" style="margin-bottom:24px">Sin tareas vinculadas.</p>
  )}

  <h2 style="margin-top:32px">Detalles de la producción</h2>
  {editable ? (
    <ProduccionForm
      produccion={prod}
      marcas={marcas}
      clientes={clientes}
      action={`/producciones/${id}`}
      submitLabel="Guardar cambios"
      isEdit={true}
    />
  ) : (
    <p class="text-muted" style="font-size:12px">Solo lectura.</p>
  )}

  <NotasTimeline entidadTipo="produccion" entidadId={id} />

  <style>
    .ficha { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:16px 24px; }
    .ficha-label { font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--text-2,#888); margin-bottom:3px; }
    .ficha-val { font-size:14px; }
  </style>

  <script>
    function syncModeloPicker() {
      const rol = (document.getElementById('linea_rol') as HTMLSelectElement | null)?.value;
      const col = document.getElementById('col_modelo');
      const sel = document.getElementById('linea_modelo_id') as HTMLSelectElement | null;
      const nom = document.getElementById('linea_nombre') as HTMLInputElement | null;
      if (col) col.style.display = rol === 'Modelo' ? '' : 'none';
      if (rol !== 'Modelo' && sel) sel.value = '';
      // Al elegir un modelo, autollenar el nombre
      if (sel && nom && sel.value) {
        nom.value = sel.options[sel.selectedIndex]?.textContent?.trim() ?? nom.value;
      }
    }
    document.getElementById('linea_rol')?.addEventListener('change', syncModeloPicker);
    document.getElementById('linea_modelo_id')?.addEventListener('change', () => {
      const sel = document.getElementById('linea_modelo_id') as HTMLSelectElement;
      const nom = document.getElementById('linea_nombre') as HTMLInputElement | null;
      if (nom && sel.value) nom.value = sel.options[sel.selectedIndex]?.textContent?.trim() ?? '';
    });
    syncModeloPicker();
  </script>
</Layout>
