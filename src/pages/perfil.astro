---
import Layout from '../components/Layout.astro';
import { requireUser } from '../lib/session';
import { getDB, now } from '../lib/db';

const user = requireUser(Astro);
const db = getDB(Astro);

let saved = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const nombre = (form.get('nombre') as string)?.trim();
  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    await db
      .prepare('UPDATE users SET nombre = ?, updated_at = ? WHERE id = ?')
      .bind(nombre, now(), user.id)
      .run();
    saved = true;
  }
}

// Métricas del user
const { results: misSesiones } = await db
  .prepare('SELECT id, created_at, expires_at FROM sessions WHERE user_id = ? ORDER BY created_at DESC LIMIT 5')
  .bind(user.id)
  .all<any>();

const fmt = (ts: number) => new Date(ts).toLocaleString('es-MX');
---

<Layout title="Mi perfil" pageTitle="Mi perfil">
  <div class="page-head">
    <h1>Mi perfil</h1>
  </div>

  {saved && <p class="text-ok" style="margin-bottom:20px">Guardado.</p>}
  {error && <p class="text-danger" style="margin-bottom:20px">{error}</p>}

  <form method="POST" action="/perfil" style="max-width:480px">
    <label class="label">Nombre</label>
    <input class="input" name="nombre" value={user.nombre} required />

    <label class="label">Email (no editable)</label>
    <input class="input" value={user.email} disabled />

    <label class="label">Rol</label>
    <input class="input" value={user.rol} disabled />

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
  </form>

  <h2 style="margin-top:48px">Mis sesiones activas</h2>
  {misSesiones && misSesiones.length > 0 ? (
    <table style="width:100%;border-collapse:collapse;font-size:13px;max-width:600px">
      <thead>
        <tr style="border-bottom:1px solid var(--border);text-align:left">
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Iniciada</th>
          <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Expira</th>
        </tr>
      </thead>
      <tbody>
        {misSesiones.map((s: any) => (
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:10px">{fmt(s.created_at)}</td>
            <td style="padding:10px;color:var(--text-2)">{fmt(s.expires_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p class="text-muted">Sin sesiones registradas.</p>
  )}

  <p style="margin-top:32px"><a href="/logout" class="btn btn-sm">Cerrar sesión actual</a></p>
</Layout>
