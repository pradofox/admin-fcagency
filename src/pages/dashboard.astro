---
import Layout from '../components/Layout.astro';
import { requireUser } from '../lib/session';
import { getDB } from '../lib/db';
import { formatFecha, diasAlCumple, calcularEdad, cumpleCorto } from '../lib/fechas';

const user = requireUser(Astro);
const db = getDB(Astro);

async function count(sql: string, ...params: any[]): Promise<number> {
  const stmt = params.length ? db.prepare(sql).bind(...params) : db.prepare(sql);
  const row = await stmt.first<{ c: number }>();
  return row?.c ?? 0;
}

const todayISO = new Date().toISOString().slice(0, 10);
const in7days = new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10);

const { results: misTareas } = await db
  .prepare(
    `SELECT a.id, a.tarea, a.fecha, a.prioridad, a.estado, p.titulo as produccion_titulo
     FROM acciones_calendario a
     LEFT JOIN producciones p ON p.id = a.produccion_id
     WHERE a.asignado_a = ? AND a.estado IN ('pendiente','en_curso')
     ORDER BY
       CASE WHEN a.fecha IS NULL THEN 1 ELSE 0 END,
       a.fecha ASC,
       CASE a.prioridad WHEN 'Alta' THEN 0 WHEN 'Media' THEN 1 ELSE 2 END
     LIMIT 8`
  )
  .bind(user.id)
  .all<any>();

const misTareasVencidas = misTareas?.filter((t: any) => t.fecha && t.fecha < todayISO).length ?? 0;
const misTareasHoy = misTareas?.filter((t: any) => t.fecha === todayISO).length ?? 0;

const [
  modelosActivas,
  produccionesEnCurso,
  briefsVivos,
  contactosTotal,
  castingsAbiertos,
  piezasPendientes,
  contactosConPagoPendiente,
  contactosConRetroPendiente,
  produccionesEstaSemana,
  modelosPendientesMaterial
] = await Promise.all([
  count("SELECT COUNT(*) as c FROM modelos WHERE estado = 'activo'"),
  count("SELECT COUNT(*) as c FROM producciones WHERE estado IN ('planeacion','confirmada','en_curso')"),
  count("SELECT COUNT(*) as c FROM briefs WHERE estado IN ('idea','aprobado','produccion')"),
  count('SELECT COUNT(*) as c FROM contactos'),
  count("SELECT COUNT(*) as c FROM castings WHERE etapa IN ('Abierto','Selección')"),
  count("SELECT COUNT(*) as c FROM piezas_contenido WHERE estado != 'Publicado'"),
  count("SELECT COUNT(*) as c FROM contactos WHERE pago_cliente_estado IN ('pendiente','anticipo_recibido')"),
  count('SELECT COUNT(*) as c FROM contactos WHERE retro_enviada = 0 AND estatus_crm = \'cerrado\''),
  count('SELECT COUNT(*) as c FROM producciones WHERE fecha_inicio BETWEEN ? AND ?', todayISO, in7days),
  count("SELECT COUNT(*) as c FROM modelos WHERE estado = 'activo' AND (polas = 0 OR book = 0 OR videocasting = 0)")
]);

// Próximas acciones (cross-secciones)
const { results: proxAcciones } = await db
  .prepare(
    `SELECT id, nombre as titulo, next_action_date as fecha, next_action_text as detalle, tipo
     FROM contactos
     WHERE next_action_date IS NOT NULL AND next_action_date >= date('now', 'localtime') AND estatus_crm != 'cerrado'
     ORDER BY next_action_date ASC LIMIT 8`
  )
  .all<any>();

// Próximas producciones
const { results: proxProds } = await db
  .prepare(
    `SELECT id, titulo, fecha_inicio, marca_id, ubicacion_shoot,
            (SELECT COUNT(*) FROM lineas_produccion WHERE produccion_id = producciones.id) as lineas
     FROM producciones
     WHERE fecha_inicio >= date('now', 'localtime') AND estado != 'cancelada'
     ORDER BY fecha_inicio ASC LIMIT 5`
  )
  .all<any>();

// Próximos cumpleaños de modelos (cumpleanos es TEXT libre → se parsea en JS)
const { results: modsCumple } = await db
  .prepare(`SELECT id, nombre, cumpleanos FROM modelos
            WHERE estado != 'archivado' AND cumpleanos IS NOT NULL AND TRIM(cumpleanos) != ''`)
  .all<any>();
const proxCumples = (modsCumple ?? [])
  .map((m: any) => ({
    id: m.id, nombre: m.nombre,
    dias: diasAlCumple(m.cumpleanos),
    edad: calcularEdad(m.cumpleanos),
    cuando: cumpleCorto(m.cumpleanos),
  }))
  .filter((x: any) => x.dias != null && x.dias <= 30)
  .sort((a: any, b: any) => a.dias - b.dias)
  .slice(0, 8);

// Producciones por marca con totales
const { results: porMarca } = await db
  .prepare(
    `SELECT
        COALESCE(p.marca_id, '— sin marca —') as marca,
        COUNT(p.id) as prods,
        SUM(COALESCE(t.cobro_total, 0)) as cobro
     FROM producciones p
     LEFT JOIN (
       SELECT produccion_id, SUM(cobro_cliente) as cobro_total
       FROM lineas_produccion GROUP BY produccion_id
     ) t ON t.produccion_id = p.id
     GROUP BY marca ORDER BY cobro DESC`
  )
  .all<any>();

const fmt = (n: number | null) =>
  n ? `$${Math.round(n).toLocaleString('es-MX')}` : '$0';
---

<Layout title="Dashboard" pageTitle="Dashboard">
  <div class="page-head">
    <h1>Hola, {user.nombre.split(' ')[0]}</h1>
    <small class="text-muted">{new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' })}</small>
  </div>

  {misTareas && misTareas.length > 0 && (
    <section style="margin-bottom:32px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px">
        <h2 style="margin:0">Mis tareas pendientes
          {misTareasVencidas > 0 && <span class="chip chip-danger" style="margin-left:10px">{misTareasVencidas} vencida{misTareasVencidas > 1 ? 's' : ''}</span>}
          {misTareasHoy > 0 && <span class="chip chip-warning" style="margin-left:6px">{misTareasHoy} hoy</span>}
        </h2>
        <a href="/tareas" class="text-muted" style="font-size:12px">ver todas →</a>
      </div>
      {misTareas.map((t: any) => {
        const venc = t.fecha && t.fecha < todayISO;
        const hoy = t.fecha === todayISO;
        return (
          <a href={`/tareas/${t.id}`} class="card" style={`display:block;color:inherit;text-decoration:none;margin-bottom:8px;${venc ? 'border-left:3px solid var(--danger,#e25555)' : hoy ? 'border-left:3px solid var(--gold)' : ''}`}>
            <div style="display:flex;justify-content:space-between;gap:14px">
              <div style="flex:1;min-width:0">
                <div style="font-weight:500;font-size:14px">{t.tarea}</div>
                <div class="card-meta" style="margin-top:4px">
                  {t.fecha && <span class="mono" style={venc ? 'color:var(--danger,#e25555)' : hoy ? 'color:var(--gold)' : ''}>{formatFecha(t.fecha)}</span>}
                  {t.produccion_titulo && <span class="text-muted">↳ {t.produccion_titulo}</span>}
                </div>
              </div>
              <div style="display:flex;gap:6px;flex-direction:column;align-items:flex-end">
                {t.prioridad === 'Alta' && <span class="chip chip-danger">Alta</span>}
                {t.estado === 'en_curso' && <span class="chip chip-gold">en curso</span>}
              </div>
            </div>
          </a>
        );
      })}
    </section>
  )}

  <h2>Resumen</h2>
  <div class="grid-dense" style="margin-bottom:28px">
    <a href="/modelos" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{modelosActivas}</div>
      <div class="stat-label">Modelos activas</div>
    </a>
    <a href="/producciones" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{produccionesEnCurso}</div>
      <div class="stat-label">Producciones vivas</div>
    </a>
    <a href="/clientes" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{castingsAbiertos}</div>
      <div class="stat-label">Castings abiertos</div>
    </a>
    <a href="/briefs" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{briefsVivos}</div>
      <div class="stat-label">Briefs vivos</div>
    </a>
    <a href="/contenido" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{piezasPendientes}</div>
      <div class="stat-label">Piezas por publicar</div>
    </a>
    <a href="/contactos" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{contactosTotal}</div>
      <div class="stat-label">Contactos</div>
    </a>
  </div>

  <h2>Atención requerida</h2>
  <div class="grid-dense" style="margin-bottom:28px">
    <a href="/contactos?estatus=pago_pendiente" class="stat stat-warning" style="display:block;color:inherit">
      <div class="stat-value">{contactosConPagoPendiente}</div>
      <div class="stat-label">Pago cliente pendiente</div>
    </a>
    <a href="/producciones" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{produccionesEstaSemana}</div>
      <div class="stat-label">Próximos 7 días</div>
    </a>
    <a href="/modelos" class="stat stat-gold" style="display:block;color:inherit">
      <div class="stat-value">{modelosPendientesMaterial}</div>
      <div class="stat-label">Modelos con material pendiente</div>
    </a>
    <a href="/contactos" class="stat" style="display:block;color:inherit">
      <div class="stat-value">{contactosConRetroPendiente}</div>
      <div class="stat-label">Cerrados sin retro</div>
    </a>
  </div>

  <div class="row" style="align-items:flex-start;gap:20px;margin-bottom:36px">
    <div class="col">
      <h2 style="margin-bottom:14px">Próximas producciones</h2>
      {proxProds && proxProds.length > 0 ? (
        proxProds.map((p: any) => (
          <a href={`/producciones/${p.id}`} class="card" style="display:block;color:inherit;text-decoration:none;margin-bottom:8px">
            <div style="display:flex;justify-content:space-between;gap:14px">
              <div style="flex:1;min-width:0">
                <div style="font-weight:500;font-size:14px">{p.titulo}</div>
                <small class="text-muted">{p.ubicacion_shoot ?? '—'} · {p.lineas} líneas</small>
              </div>
              <small class="text-muted" style="white-space:nowrap">{p.fecha_inicio}</small>
            </div>
          </a>
        ))
      ) : (
        <p class="text-muted">No hay producciones agendadas.</p>
      )}
    </div>

    <div class="col">
      <h2 style="margin-bottom:14px">Próximas acciones</h2>
      {proxAcciones && proxAcciones.length > 0 ? (
        proxAcciones.map((a: any) => (
          <a href={`/contactos/${a.id}`} class="card" style="display:block;color:inherit;text-decoration:none;margin-bottom:8px">
            <div style="display:flex;justify-content:space-between;gap:14px">
              <div style="flex:1;min-width:0">
                <div style="font-weight:500;font-size:14px">{a.titulo}</div>
                {a.detalle && <small class="text-muted">{a.detalle}</small>}
              </div>
              <small class="text-muted" style="white-space:nowrap">{a.fecha}</small>
            </div>
          </a>
        ))
      ) : (
        <p class="text-muted">Sin acciones registradas.</p>
      )}
    </div>
  </div>

  {proxCumples.length > 0 && (
    <div style="margin-bottom:36px">
      <h2 style="margin-bottom:14px">Próximos cumpleaños</h2>
      <div class="row" style="flex-wrap:wrap;gap:10px">
        {proxCumples.map((c: any) => {
          const cuandoTxt = c.dias === 0 ? 'HOY' : c.dias === 1 ? 'mañana' : `en ${c.dias}d`;
          const edadFutura = c.edad != null ? c.edad + (c.dias === 0 ? 0 : 1) : null;
          return (
            <a href={`/modelos/${c.id}`} class="card" style={`flex:1;min-width:160px;color:inherit;text-decoration:none;${c.dias <= 1 ? 'border-left:3px solid #e879f9' : ''}`}>
              <div style="font-weight:500;font-size:14px">🎂 {c.nombre}</div>
              <div class="card-meta" style="margin-top:4px">
                <span style={c.dias <= 1 ? 'color:#e879f9' : 'color:var(--gold)'}>{cuandoTxt}</span>
                {c.cuando && <span class="text-muted">{c.cuando}</span>}
                {edadFutura != null && <span class="text-muted">cumple {edadFutura}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}

  <h2>Producciones por marca</h2>
  <div class="table-card" style="margin-bottom:28px">
    <table>
      <thead>
        <tr>
          <th>Marca</th>
          <th class="right">Producciones</th>
          <th class="right">Cobrado</th>
        </tr>
      </thead>
      <tbody>
        {porMarca && porMarca.map((m: any) => (
          <tr>
            <td><strong>{m.marca}</strong></td>
            <td class="right mono">{m.prods}</td>
            <td class="right mono text-gold">{fmt(m.cobro)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
