---
import Layout from '../components/Layout.astro';
import { requireUser } from '../lib/session';
import { getDB } from '../lib/db';

const user = requireUser(Astro);
const db = getDB(Astro);

async function count(sql: string, ...params: any[]): Promise<number> {
  const stmt = params.length ? db.prepare(sql).bind(...params) : db.prepare(sql);
  const row = await stmt.first<{ c: number }>();
  return row?.c ?? 0;
}

const [
  modelosActivas,
  produccionesEnCurso,
  briefsVivos,
  contactosTotal,
  castingsAbiertos,
  piezasPendientes,
  contactosConPagoPendiente,
  contactosConRetroPendiente
] = await Promise.all([
  count("SELECT COUNT(*) as c FROM modelos WHERE estado = 'activo'"),
  count("SELECT COUNT(*) as c FROM producciones WHERE estado IN ('planeacion','confirmada','en_curso')"),
  count("SELECT COUNT(*) as c FROM briefs WHERE estado IN ('idea','aprobado','produccion')"),
  count('SELECT COUNT(*) as c FROM contactos'),
  count("SELECT COUNT(*) as c FROM castings WHERE etapa IN ('Abierto','Selección')"),
  count("SELECT COUNT(*) as c FROM piezas_contenido WHERE estado != 'Publicado'"),
  count("SELECT COUNT(*) as c FROM contactos WHERE pago_cliente_estado IN ('pendiente','anticipo_recibido')"),
  count('SELECT COUNT(*) as c FROM contactos WHERE retro_enviada = 0')
]);

// Próximas acciones (calendario de Victoria + próximas acciones por contacto)
const { results: proxAcciones } = await db
  .prepare(
    `SELECT 'contacto' as origen, c.id, c.nombre as titulo, c.next_action_date as fecha, c.next_action_text as detalle
     FROM contactos c WHERE c.next_action_date IS NOT NULL AND c.next_action_date >= date('now', 'localtime') AND c.estatus_crm != 'cerrado'
     ORDER BY c.next_action_date ASC LIMIT 10`
  )
  .all<{ origen: string; id: string; titulo: string; fecha: string; detalle: string | null }>();
---

<Layout title="Dashboard" pageTitle="Dashboard">
  <div class="page-head">
    <h1>Hola, {user.nombre.split(' ')[0]}</h1>
  </div>

  <h2 style="margin-bottom:14px">Resumen</h2>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));margin-bottom:36px">
    <a href="/modelos" class="card" style="display:block;color:inherit">
      <div class="card-title">{modelosActivas}</div>
      <div class="card-meta">Modelos activas</div>
    </a>
    <a href="/producciones" class="card" style="display:block;color:inherit">
      <div class="card-title">{produccionesEnCurso}</div>
      <div class="card-meta">Producciones en curso</div>
    </a>
    <a href="/castings" class="card" style="display:block;color:inherit">
      <div class="card-title">{castingsAbiertos}</div>
      <div class="card-meta">Castings abiertos</div>
    </a>
    <a href="/briefs" class="card" style="display:block;color:inherit">
      <div class="card-title">{briefsVivos}</div>
      <div class="card-meta">Briefs vivos</div>
    </a>
    <a href="/contenido" class="card" style="display:block;color:inherit">
      <div class="card-title">{piezasPendientes}</div>
      <div class="card-meta">Piezas por publicar</div>
    </a>
    <a href="/contactos" class="card" style="display:block;color:inherit">
      <div class="card-title">{contactosTotal}</div>
      <div class="card-meta">Contactos totales</div>
    </a>
  </div>

  <h2 style="margin-bottom:14px">Pendientes urgentes</h2>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));margin-bottom:36px">
    <a href="/contactos?estatus=pago_pendiente" class="card" style="display:block;color:inherit;border-color:var(--warning)">
      <div class="card-title" style="color:var(--warning)">{contactosConPagoPendiente}</div>
      <div class="card-meta">Contactos con pago pendiente</div>
    </a>
    <a href="/contactos" class="card" style="display:block;color:inherit">
      <div class="card-title">{contactosConRetroPendiente}</div>
      <div class="card-meta">Sin retro enviada</div>
    </a>
  </div>

  <h2 style="margin-bottom:14px">Próximas acciones</h2>
  {proxAcciones && proxAcciones.length > 0 ? (
    <div class="card">
      {proxAcciones.map((a) => (
        <a href={`/contactos/${a.id}`} style="display:block;padding:10px 0;border-bottom:1px solid var(--border);color:inherit;text-decoration:none">
          <div style="display:flex;justify-content:space-between;gap:14px">
            <div>
              <div style="font-weight:500">{a.titulo}</div>
              {a.detalle && <small>{a.detalle}</small>}
            </div>
            <small class="text-muted">{a.fecha}</small>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-muted">Sin acciones próximas registradas.</p>
  )}
</Layout>
