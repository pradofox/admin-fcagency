---
import Layout from '../../components/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { requireSection, canEdit } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { newId } from '../../lib/ids';
import { formatFecha } from '../../lib/fechas';
import { logAudit } from '../../lib/audit';

const user = requireSection(Astro, 'pagos');
const editable = canEdit(user);
const db = getDB(Astro);

// Acción: marcar línea como pagada (solo si cliente pagó)
let msgOk: string | null = null;
let msgErr: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form   = await Astro.request.formData();
  const action = form.get('_action') as string;

  if (action === 'pagar_linea') {
    const lineaId = form.get('linea_id') as string;
    const linea = await db
      .prepare(`SELECT lp.id, p.pago_cliente_estado, p.titulo
                FROM lineas_produccion lp
                JOIN producciones p ON p.id = lp.produccion_id
                WHERE lp.id = ?`)
      .bind(lineaId)
      .first<any>();
    if (!linea) {
      msgErr = 'Línea no encontrada.';
    } else if (linea.pago_cliente_estado !== 'pagado') {
      msgErr = `No puedes marcar el pago hasta que el cliente liquide "${linea.titulo}".`;
    } else {
      await db.prepare("UPDATE lineas_produccion SET estado = 'pagado' WHERE id = ?").bind(lineaId).run();
      // Completar automaticamente la(s) tarea(s) ligadas a esta linea de pago
      await db
        .prepare("UPDATE acciones_calendario SET estado = 'completada', done = 1, updated_at = ? WHERE linea_produccion_id = ? AND estado != 'completada'")
        .bind(now(), lineaId).run();
      await logAudit(db, { user, accion: 'state_change', entidad: 'pago', entidad_id: lineaId, entidad_label: linea.titulo, payload: { estado: 'pagado' } });
      return Astro.redirect('/pagos?tab=pagos');
    }
  }

  // ── Revertir pago a proveedor (volver a pendiente por si fue por error) ──
  if (action === 'revertir_pago_linea') {
    const lineaId = form.get('linea_id') as string;
    const linea = await db
      .prepare(`SELECT lp.id, p.titulo FROM lineas_produccion lp JOIN producciones p ON p.id = lp.produccion_id WHERE lp.id = ?`)
      .bind(lineaId).first<any>();
    if (linea) {
      await db.prepare("UPDATE lineas_produccion SET estado = 'pendiente' WHERE id = ?").bind(lineaId).run();
      // Regresar la tarea vinculada a pendiente
      await db
        .prepare("UPDATE acciones_calendario SET estado = 'pendiente', done = 0, updated_at = ? WHERE linea_produccion_id = ?")
        .bind(now(), lineaId).run();
      await logAudit(db, { user, accion: 'state_change', entidad: 'pago', entidad_id: lineaId, entidad_label: linea.titulo, payload: { estado: 'pendiente', motivo: 'revertido' } });
    }
    return Astro.redirect('/pagos?tab=pagados');
  }

  // ── Revertir cobro de cliente (produccion vuelve a pendiente) ────────────
  if (action === 'revertir_cliente_pago') {
    const prodId = form.get('prod_id') as string;
    const prod = await db.prepare('SELECT titulo FROM producciones WHERE id = ?').bind(prodId).first<any>();
    if (prod) {
      await db.prepare("UPDATE producciones SET pago_cliente_estado = 'pendiente', updated_at = ? WHERE id = ?").bind(now(), prodId).run();
      await logAudit(db, { user, accion: 'state_change', entidad: 'produccion', entidad_id: prodId, entidad_label: prod.titulo, payload: { pago_cliente_estado: 'pendiente', motivo: 'revertido' } });
    }
    return Astro.redirect('/pagos?tab=cobros');
  }

  if (action === 'cliente_pago') {
    const prodId = form.get('prod_id') as string;
    const ts = now();
    const fechaHoy = new Date().toISOString().slice(0, 10);

    // Marcar producción como cobrada
    const prod = await db.prepare('SELECT titulo FROM producciones WHERE id = ?').bind(prodId).first<any>();
    await db.prepare("UPDATE producciones SET pago_cliente_estado = 'pagado', updated_at = ? WHERE id = ?").bind(ts, prodId).run();
    await logAudit(db, { user, accion: 'state_change', entidad: 'produccion', entidad_id: prodId, entidad_label: prod?.titulo ?? null, payload: { pago_cliente_estado: 'pagado' } });

    // Auto-crear tareas: pagar a cada proveedor/modelo de esta producción
    const { results: lineasPend } = await db
      .prepare("SELECT id, nombre_libre, rol, pago_proveedor FROM lineas_produccion WHERE produccion_id = ? AND estado = 'pendiente'")
      .bind(prodId).all<any>();

    for (const l of (lineasPend ?? [])) {
      if (!l.nombre_libre && !l.rol) continue;
      const nombre   = l.nombre_libre ?? l.rol;
      const monto    = l.pago_proveedor ? ` ($${Math.round(l.pago_proveedor).toLocaleString('es-MX')})` : '';
      const tarea    = `Pagar a ${nombre}${monto} — ${prod?.titulo ?? 'producción'}`;
      await db
        .prepare(`INSERT INTO acciones_calendario (id, fecha, tarea, produccion_id, linea_produccion_id, prioridad, estado, asignado_por, created_at, updated_at)
                  VALUES (?, ?, ?, ?, ?, 'Alta', 'pendiente', ?, ?, ?)`)
        .bind(newId(), fechaHoy, tarea, prodId, l.id, user.id, ts, ts)
        .run();
    }

    const ntareas = lineasPend?.length ?? 0;
    return Astro.redirect(`/pagos?tab=cobros&tareas=${ntareas}`);
  }
}

const tabRaw = Astro.url.searchParams.get('tab');
const tab = ['cobros', 'pagos', 'pagados'].includes(tabRaw ?? '') ? tabRaw! : 'cobros';

// Buscador por produccion (titulo / cliente)
const search = (Astro.url.searchParams.get('q') ?? '').trim();
const searchLike = search ? `%${search}%` : null;

// Flash message de tareas auto-creadas
const tareasMsgN = Astro.url.searchParams.get('tareas');
const tareasMsg = tareasMsgN !== null
  ? (Number(tareasMsgN) > 0
      ? `✓ Ingreso registrado — ${tareasMsgN} tarea${Number(tareasMsgN) !== 1 ? 's' : ''} de pago creada${Number(tareasMsgN) !== 1 ? 's' : ''} en Tareas`
      : '✓ Ingreso registrado.')
  : null;

// Filtro opcional por busqueda (titulo de produccion o nombre del cliente)
const cobrosSql = `SELECT p.id, p.titulo, p.fecha_inicio, p.estado as prod_estado, p.tipo_produccion,
                          p.pago_cliente_estado,
                          c.nombre as cliente_nombre,
                          SUM(lp.cobro_cliente) as total_cobrar,
                          COUNT(lp.id) as n_lineas
                   FROM producciones p
                   LEFT JOIN clientes c ON c.id = p.cliente_id
                   LEFT JOIN lineas_produccion lp ON lp.produccion_id = p.id AND lp.estado != 'cancelado'
                   WHERE p.pago_cliente_estado = 'pendiente' AND p.estado != 'cancelada'
                     ${searchLike ? 'AND (p.titulo LIKE ? OR c.nombre LIKE ?)' : ''}
                   GROUP BY p.id
                   ORDER BY p.fecha_inicio DESC`;
const cobrosBinds = searchLike ? [searchLike, searchLike] : [];
const { results: cobros } = await (cobrosBinds.length ? db.prepare(cobrosSql).bind(...cobrosBinds) : db.prepare(cobrosSql)).all<any>();

// Producciones recientemente cobradas (para poder revertir si fue por error)
const cobradasSql = `SELECT p.id, p.titulo, p.fecha_inicio, c.nombre as cliente_nombre,
                            SUM(lp.cobro_cliente) as total
                     FROM producciones p
                     LEFT JOIN clientes c ON c.id = p.cliente_id
                     LEFT JOIN lineas_produccion lp ON lp.produccion_id = p.id AND lp.estado != 'cancelado'
                     WHERE p.pago_cliente_estado = 'pagado' AND p.estado != 'cancelada'
                       ${searchLike ? 'AND (p.titulo LIKE ? OR c.nombre LIKE ?)' : ''}
                     GROUP BY p.id
                     ORDER BY p.updated_at DESC
                     LIMIT 30`;
const cobradasBinds = searchLike ? [searchLike, searchLike] : [];
const { results: cobradas } = await (cobradasBinds.length ? db.prepare(cobradasSql).bind(...cobradasBinds) : db.prepare(cobradasSql)).all<any>();

const pagosSql = `SELECT lp.id as linea_id, lp.nombre_libre, lp.rol, lp.cobro_cliente, lp.pago_proveedor, lp.estado as linea_estado,
                         p.id as prod_id, p.titulo, p.fecha_inicio, p.pago_cliente_estado,
                         c.nombre as cliente_nombre
                  FROM lineas_produccion lp
                  JOIN producciones p ON p.id = lp.produccion_id
                  LEFT JOIN clientes c ON c.id = p.cliente_id
                  WHERE lp.estado = 'pendiente' AND p.estado != 'cancelada'
                    ${searchLike ? 'AND (p.titulo LIKE ? OR c.nombre LIKE ? OR lp.nombre_libre LIKE ?)' : ''}
                  ORDER BY p.pago_cliente_estado ASC, p.fecha_inicio DESC, lp.nombre_libre ASC`;
const pagosBinds = searchLike ? [searchLike, searchLike, searchLike] : [];
const { results: pagos } = await (pagosBinds.length ? db.prepare(pagosSql).bind(...pagosBinds) : db.prepare(pagosSql)).all<any>();

const pagadosSql = `SELECT lp.id as linea_id, lp.nombre_libre, lp.rol, lp.cobro_cliente, lp.pago_proveedor,
                           p.id as prod_id, p.titulo, p.fecha_inicio,
                           c.nombre as cliente_nombre
                    FROM lineas_produccion lp
                    JOIN producciones p ON p.id = lp.produccion_id
                    LEFT JOIN clientes c ON c.id = p.cliente_id
                    WHERE lp.estado = 'pagado'
                      ${searchLike ? 'AND (p.titulo LIKE ? OR c.nombre LIKE ? OR lp.nombre_libre LIKE ?)' : ''}
                    ORDER BY p.fecha_inicio DESC, lp.nombre_libre ASC
                    LIMIT 100`;
const pagadosBinds = searchLike ? [searchLike, searchLike, searchLike] : [];
const { results: pagados } = await (pagadosBinds.length ? db.prepare(pagadosSql).bind(...pagadosBinds) : db.prepare(pagadosSql)).all<any>();

// Totales
const totalCobrar     = cobros?.reduce((s: number, r: any) => s + (r.total_cobrar ?? 0), 0) ?? 0;
const pagosBloqueados = pagos?.filter((r: any) => r.pago_cliente_estado !== 'pagado') ?? [];
const pagosLibres     = pagos?.filter((r: any) => r.pago_cliente_estado === 'pagado')  ?? [];
const totalPagar      = pagosLibres.reduce((s: number, r: any) => s + (r.pago_proveedor ?? 0), 0);
const totalBloqueado  = pagosBloqueados.reduce((s: number, r: any) => s + (r.pago_proveedor ?? 0), 0);

// Utilidades
const utilidadDisponible = pagosLibres.reduce(
  (s: number, r: any) => s + ((r.cobro_cliente ?? 0) - (r.pago_proveedor ?? 0)), 0);
const utilidadBloqueada  = pagosBloqueados.reduce(
  (s: number, r: any) => s + ((r.cobro_cliente ?? 0) - (r.pago_proveedor ?? 0)), 0);
const utilidadRealizada  = pagados?.reduce(
  (s: number, r: any) => s + ((r.cobro_cliente ?? 0) - (r.pago_proveedor ?? 0)), 0) ?? 0;

const fmt = (n: number | null | undefined) =>
  n != null && n > 0 ? `$${Math.round(n).toLocaleString('es-MX')}` : '$0';
---

<Layout title="Cobros y Pagos" pageTitle="Cobros y Pagos">
  <div class="page-head">
    <h1>Cobros y Pagos</h1>
    <a href="/api/pagos/export" class="btn btn-sm">Exportar CSV</a>
  </div>

  {/* Buscador contextual segun tab activo */}
  <form method="GET" action="/pagos" style="display:flex;gap:6px;margin-bottom:16px;align-items:center">
    {tab && <input type="hidden" name="tab" value={tab} />}
    <input class="input" type="search" name="q" value={search}
           placeholder={
             tab === 'cobros'  ? 'Buscar producción o cliente…' :
             tab === 'pagos'   ? 'Buscar proveedor, producción o cliente…' :
                                 'Buscar proveedor o producción…'
           }
           style="max-width:400px" autofocus />
    <button type="submit" class="btn btn-sm">Buscar</button>
    {search && <a href={`/pagos?tab=${tab}`} class="btn btn-sm">✕</a>}
    <span class="text-muted" style="font-size:11px;margin-left:auto">
      {tab === 'cobros'  ? 'En esta pestaña buscas producciones.' :
       tab === 'pagos'   ? 'En esta pestaña buscas proveedores pendientes de pago.' :
                           'En esta pestaña buscas proveedores ya pagados.'}
    </span>
  </form>

  {msgOk     && <p class="text-ok"    style="margin-bottom:16px">{msgOk}</p>}
  {tareasMsg && <p class="text-ok"    style="margin-bottom:16px;display:flex;gap:10px;align-items:center">{tareasMsg} <a href="/tareas" class="btn btn-sm">Ver Tareas →</a></p>}
  {msgErr    && <p class="text-danger" style="margin-bottom:16px">{msgErr}</p>}

  <div class="row" style="margin-bottom:12px">
    <div class="col card">
      <div class="card-meta">Por cobrar a clientes</div>
      <div class="card-title mono" style="color:#E5E5E5">{fmt(totalCobrar)}</div>
      <small class="text-muted">{cobros?.length ?? 0} produccion{cobros?.length !== 1 ? 'es' : ''}</small>
    </div>
    <div class="col card">
      <div class="card-meta">Por pagar — disponible</div>
      <div class="card-title mono text-ok">{fmt(totalPagar)}</div>
      <small class="text-muted">{pagosLibres.length} línea{pagosLibres.length !== 1 ? 's' : ''}</small>
    </div>
    <div class="col card">
      <div class="card-meta">Por pagar — bloqueado</div>
      <div class="card-title mono" style="color:var(--danger,#e25555)">{fmt(totalBloqueado)}</div>
      <small class="text-muted">Esperando cobro al cliente</small>
    </div>
  </div>

  <div class="row" style="margin-bottom:24px">
    <div class="col card" style="border-left:3px solid var(--gold)">
      <div class="card-meta">Utilidad disponible</div>
      <div class="card-title mono" style="color:var(--gold)">{fmt(utilidadDisponible)}</div>
      <small class="text-muted">Cliente cobrado, proveedor sin pagar</small>
    </div>
    <div class="col card" style="border-left:3px solid #666">
      <div class="card-meta">Utilidad pendiente</div>
      <div class="card-title mono text-muted">{fmt(utilidadBloqueada)}</div>
      <small class="text-muted">Esperando cobro al cliente</small>
    </div>
    <div class="col card" style="border-left:3px solid var(--text-ok,#4ade80)">
      <div class="card-meta">Utilidad realizada</div>
      <div class="card-title mono text-ok">{fmt(utilidadRealizada)}</div>
      <small class="text-muted">Ya cobrado y ya pagado ({pagados?.length ?? 0} líneas)</small>
    </div>
  </div>

  <!-- Tabs -->
  <div class="filters" style="margin-bottom:24px">
    <a href="/pagos?tab=cobros" class={`filter-chip ${tab === 'cobros' ? 'active' : ''}`}>
      Cobros a clientes {cobros?.length ? `(${cobros.length})` : ''}
    </a>
    <a href="/pagos?tab=pagos" class={`filter-chip ${tab === 'pagos' ? 'active' : ''}`}>
      Pagos a proveedores {pagos?.length ? `(${pagos.length})` : ''}
    </a>
    <a href="/pagos?tab=pagados" class={`filter-chip ${tab === 'pagados' ? 'active' : ''}`}>
      Pagados {pagados?.length ? `(${pagados.length})` : ''}
    </a>
  </div>

  {tab === 'cobros' && (
    <>
    {(cobros && cobros.length > 0) ? (
      <div>
        {cobros.map((r: any) => (
          <div class="card" style="margin-bottom:10px;border-left:3px solid #E5E5E5">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
              <div style="flex:1">
                <div style="font-weight:600">
                  <a href={`/producciones/${r.id}`} style="color:inherit">{r.titulo}</a>
                </div>
                <div class="card-meta" style="margin-top:4px">
                  <span class="text-muted">{r.cliente_nombre ?? 'Sin cliente'}</span>
                  {r.tipo_produccion && <span class="chip">{r.tipo_produccion}</span>}
                  <span class="mono">{formatFecha(r.fecha_inicio)}</span>
                  <span class="chip">{r.prod_estado}</span>
                  <span class="text-muted">{r.n_lineas} línea{r.n_lineas !== 1 ? 's' : ''}</span>
                </div>
              </div>
              <div style="text-align:right;flex-shrink:0">
                <div class="mono" style="color:#E5E5E5;font-size:18px">{fmt(r.total_cobrar)}</div>
                {editable && (
                  <form method="POST" action="/pagos" style="margin-top:8px">
                    <input type="hidden" name="_action" value="cliente_pago" />
                    <input type="hidden" name="prod_id" value={r.id} />
                    <button type="submit" class="btn btn-sm btn-primary"
                      onclick="return confirm('¿Confirmar que el cliente pagó esta producción?')">
                      Marcar cobrado
                    </button>
                  </form>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <EmptyState title="Sin cobros pendientes" message="Todas las producciones tienen el pago del cliente al día." />
    )}

    {cobradas && cobradas.length > 0 && (
      <details style="margin-top:24px">
        <summary class="text-muted" style="cursor:pointer;font-size:11px;letter-spacing:.15em;text-transform:uppercase">
          Producciones ya cobradas ({cobradas.length}) — revertir si fue por error
        </summary>
        <div class="table-card" style="margin-top:10px">
          <table>
            <thead>
              <tr><th>Producción</th><th>Cliente</th><th>Fecha</th><th class="right">Total</th><th></th></tr>
            </thead>
            <tbody>
              {(cobradas as any[]).map((r) => (
                <tr>
                  <td><a href={`/producciones/${r.id}`} style="color:inherit;font-weight:500">{r.titulo}</a></td>
                  <td class="text-muted">{r.cliente_nombre ?? '—'}</td>
                  <td class="mono text-muted">{formatFecha(r.fecha_inicio)}</td>
                  <td class="right mono text-ok">{fmt(r.total)}</td>
                  <td>
                    {editable && (
                      <form method="POST" action="/pagos" style="display:inline"
                            onsubmit="return confirm('¿Marcar esta producción como NO cobrada otra vez? Vuelve a aparecer en cobros pendientes.')">
                        <input type="hidden" name="_action" value="revertir_cliente_pago" />
                        <input type="hidden" name="prod_id" value={r.id} />
                        <button type="submit" class="btn btn-sm">↩ Pendiente</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )}
    </>
  )}

  {tab === 'pagados' && (
    pagados && pagados.length > 0 ? (
      <div>
        <div class="table-card">
          <table>
            <thead>
              <tr>
                <th>Proveedor</th><th>Rol</th><th>Producción</th><th>Cliente</th>
                <th class="right">Cobrado</th><th class="right">Pagado</th><th></th>
              </tr>
            </thead>
            <tbody>
              {pagados.map((r: any) => (
                <tr>
                  <td><strong>{r.nombre_libre ?? '—'}</strong></td>
                  <td class="text-muted">{r.rol}</td>
                  <td><a href={`/producciones/${r.prod_id}`} style="color:var(--gold)">{r.titulo}</a></td>
                  <td class="text-muted">{r.cliente_nombre ?? '—'}</td>
                  <td class="right mono">{fmt(r.cobro_cliente)}</td>
                  <td class="right mono text-ok">{fmt(r.pago_proveedor)}</td>
                  <td style="white-space:nowrap">
                    {editable && (
                      <form method="POST" action="/pagos" style="display:inline"
                            onsubmit="return confirm('¿Regresar este pago a pendiente? Lo verás otra vez en la pestaña Pagos por hacer.')">
                        <input type="hidden" name="_action" value="revertir_pago_linea" />
                        <input type="hidden" name="linea_id" value={r.linea_id} />
                        <button type="submit" class="btn btn-sm" title="Marcar como pendiente">↩ Pendiente</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-muted" style="font-size:12px;margin-top:8px">Mostrando últimos {pagados.length} pagos completados. Usa ↩ Pendiente si marcaste por error.</p>
      </div>
    ) : (
      <EmptyState title="Sin pagos completados" message="Aún no se ha registrado ningún pago a proveedor." />
    )
  )}

  {tab === 'pagos' && (
    pagos && pagos.length > 0 ? (
      <div>
        {pagosLibres.length > 0 && (
          <div style="margin-bottom:32px">
            <h2 style="color:var(--text-ok,#4ade80);margin-bottom:12px">Listos para pagar ({pagosLibres.length})</h2>
            <div class="table-card">
              <table>
                <thead>
                  <tr>
                    <th>Proveedor</th><th>Rol</th><th>Producción</th><th>Cliente</th>
                    <th class="right">Cobrado</th><th class="right">A pagar</th><th></th>
                  </tr>
                </thead>
                <tbody>
                  {pagosLibres.map((r: any) => (
                    <tr>
                      <td><strong>{r.nombre_libre ?? '—'}</strong></td>
                      <td class="text-muted">{r.rol}</td>
                      <td><a href={`/producciones/${r.prod_id}`} style="color:var(--gold)">{r.titulo}</a></td>
                      <td class="text-muted">{r.cliente_nombre ?? '—'}</td>
                      <td class="right mono">{fmt(r.cobro_cliente)}</td>
                      <td class="right mono text-ok">{fmt(r.pago_proveedor)}</td>
                      <td>
                        {editable && (
                          <form method="POST" action="/pagos">
                            <input type="hidden" name="_action" value="pagar_linea" />
                            <input type="hidden" name="linea_id" value={r.linea_id} />
                            <button type="submit" class="btn btn-sm btn-primary">Pagar</button>
                          </form>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {pagosBloqueados.length > 0 && (
          <div>
            <h2 style="color:var(--danger,#e25555);margin-bottom:4px">Bloqueados — cliente no ha pagado ({pagosBloqueados.length})</h2>
            <p class="text-muted" style="font-size:12px;margin-bottom:12px">
              Estos pagos se desbloquean automáticamente cuando registras el cobro al cliente en la pestaña <strong>Cobros</strong>.
            </p>
            <div class="table-card">
              <table>
                <thead>
                  <tr>
                    <th>Proveedor</th><th>Rol</th><th>Producción</th><th>Cliente</th>
                    <th class="right">Cobrado</th><th class="right">A pagar</th><th></th>
                  </tr>
                </thead>
                <tbody>
                  {pagosBloqueados.map((r: any) => (
                    <tr style="opacity:.65">
                      <td><strong>{r.nombre_libre ?? '—'}</strong></td>
                      <td class="text-muted">{r.rol}</td>
                      <td><a href={`/producciones/${r.prod_id}`} style="color:var(--gold)">{r.titulo}</a></td>
                      <td class="text-muted">{r.cliente_nombre ?? '—'}</td>
                      <td class="right mono">{fmt(r.cobro_cliente)}</td>
                      <td class="right mono" style="color:var(--danger,#e25555)">{fmt(r.pago_proveedor)}</td>
                      <td>
                        <span class="chip chip-danger" style="font-size:10px">bloqueado</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    ) : (
      <EmptyState title="Sin pagos pendientes" message="No hay líneas de producción con pago pendiente." />
    )
  )}
</Layout>
