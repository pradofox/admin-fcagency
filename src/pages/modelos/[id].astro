---
import Layout from '../../components/Layout.astro';
import ModeloForm from '../../components/modelos/ModeloForm.astro';
import { requireUser, canEdit } from '../../lib/session';
import { getDB, now } from '../../lib/db';

const user = requireUser(Astro);
const editable = canEdit(user);
const db = getDB(Astro);
const { id } = Astro.params;

let error: string | null = null;
let saved = false;

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const method = form.get('_method');
  if (method === 'DELETE') {
    await db.prepare('DELETE FROM modelos WHERE id = ?').bind(id).run();
    return Astro.redirect('/modelos');
  }
  // Update
  const nombre = (form.get('nombre') as string)?.trim();
  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    const getNum = (k: string) => {
      const v = form.get(k);
      if (v === null || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    };
    await db
      .prepare(
        `UPDATE modelos SET
          nombre = ?, email = ?, whatsapp = ?, instagram = ?, cumpleanos = ?, genero = ?,
          estatura_cm = ?, busto_cm = ?, cintura_cm = ?, cadera_cm = ?, calzado_mx = ?,
          cabello = ?, ojos = ?, ciudad = ?, talentos = ?, notas = ?, estado = ?, updated_at = ?
        WHERE id = ?`
      )
      .bind(
        nombre,
        get('email'),
        get('whatsapp'),
        get('instagram'),
        get('cumpleanos'),
        get('genero'),
        getNum('estatura_cm'),
        getNum('busto_cm'),
        getNum('cintura_cm'),
        getNum('cadera_cm'),
        getNum('calzado_mx'),
        get('cabello'),
        get('ojos'),
        get('ciudad'),
        get('talentos'),
        get('notas'),
        get('estado') ?? 'activo',
        now(),
        id
      )
      .run();
    saved = true;
  }
}

const modelo = await db
  .prepare('SELECT * FROM modelos WHERE id = ?')
  .bind(id)
  .first();

if (!modelo) {
  return Astro.redirect('/modelos');
}

// Trabajos históricos del modelo
const { results: trabajos } = await db
  .prepare(
    'SELECT id, tipo, cliente, fecha, horas, pago_mxn, notas FROM trabajos_modelo WHERE modelo_id = ? ORDER BY fecha DESC'
  )
  .bind(id)
  .all<any>();

// Líneas de producción donde aparece (FK directo o por nombre como fallback)
const nombreLike = `%${modelo.nombre}%`;
const { results: lineasPorNombre } = await db
  .prepare(
    `SELECT lp.id, lp.rol, lp.cobro_cliente, lp.pago_proveedor, lp.estado,
            p.id as prod_id, p.titulo as prod_titulo, p.fecha_inicio as prod_fecha
     FROM lineas_produccion lp
     JOIN producciones p ON p.id = lp.produccion_id
     WHERE lp.modelo_id = ? OR lp.nombre_libre LIKE ?
     ORDER BY p.fecha_inicio DESC LIMIT 30`
  )
  .bind(id, nombreLike)
  .all<any>();

// Castings donde está propuesta o seleccionada
const { results: castingsProp } = await db
  .prepare(
    `SELECT DISTINCT c.id, c.cliente, c.fecha, c.etapa,
            CASE WHEN c.modelo_seleccionado_id = ? THEN 1 ELSE 0 END as seleccionada
     FROM castings c
     LEFT JOIN casting_modelos_propuestos cmp ON cmp.casting_id = c.id
     WHERE cmp.modelo_id = ? OR c.modelo_seleccionado_id = ?
     ORDER BY c.fecha DESC LIMIT 20`
  )
  .bind(id, id, id)
  .all<any>();
---

<Layout title={`Editar — ${modelo.nombre}`} pageTitle={modelo.nombre as string}>
  <div class="page-head">
    <h1>{modelo.nombre}</h1>
    <div style="display:flex;gap:10px">
      <a href="/modelos" class="btn btn-sm">Volver</a>
      {editable && (
        <form method="POST" action={`/modelos/${id}`} onsubmit="return confirm('¿Eliminar esta modelo? No se puede deshacer.')" style="display:inline">
          <input type="hidden" name="_method" value="DELETE" />
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      )}
    </div>
  </div>

  {saved && <p class="text-ok" style="margin-bottom:20px">Guardado.</p>}
  {error && <p class="text-danger" style="margin-bottom:20px">{error}</p>}

  {trabajos && trabajos.length > 0 && (
    <>
      <h2>Trabajos históricos <small class="text-muted" style="font-size:12px;letter-spacing:0;font-family:var(--font-body);text-transform:none">{trabajos.length}</small></h2>
      <div style="overflow-x:auto;margin-bottom:32px">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
          <thead>
            <tr style="border-bottom:1px solid var(--border);text-align:left">
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Fecha</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Tipo</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Cliente</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2);text-align:right">Horas</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2);text-align:right">Pago</th>
            </tr>
          </thead>
          <tbody>
            {trabajos.map((t: any) => (
              <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:10px">{t.fecha ?? '—'}</td>
                <td style="padding:10px">{t.tipo}</td>
                <td style="padding:10px">{t.cliente ?? '—'}</td>
                <td style="padding:10px;text-align:right">{t.horas ?? '—'}</td>
                <td style="padding:10px;text-align:right;color:var(--gold)">{t.pago_mxn ? `$${Math.round(t.pago_mxn).toLocaleString('es-MX')}` : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {lineasPorNombre && lineasPorNombre.length > 0 && (
    <>
      <h2>Producciones donde aparece</h2>
      <div class="grid" style="margin-bottom:32px">
        {lineasPorNombre.map((l: any) => (
          <a href={`/producciones/${l.prod_id}`} style="display:block;color:inherit;text-decoration:none">
            <article class="card">
              <div class="card-title" style="font-size:14px">{l.prod_titulo}</div>
              <div class="card-meta">
                <span class="chip">{l.rol}</span>
                {l.prod_fecha && <span class="text-muted">{l.prod_fecha}</span>}
                <span style="color:var(--gold);margin-left:auto">${Math.round(l.pago_proveedor || 0).toLocaleString('es-MX')}</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </>
  )}

  {castingsProp && castingsProp.length > 0 && (
    <>
      <h2>Castings</h2>
      <div class="grid" style="margin-bottom:32px">
        {castingsProp.map((c: any) => (
          <a href={`/castings/${c.id}`} style="display:block;color:inherit;text-decoration:none">
            <article class="card" style={c.seleccionada ? 'border-color:var(--ok)' : ''}>
              <div class="card-title" style="font-size:14px">{c.cliente}</div>
              <div class="card-meta">
                <span class="chip">{c.etapa}</span>
                {c.seleccionada ? <span class="chip chip-ok">Seleccionada</span> : <span class="text-muted">Propuesta</span>}
                {c.fecha && <span class="text-muted">{c.fecha}</span>}
              </div>
            </article>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Datos generales</h2>
  {editable ? (
    <ModeloForm modelo={modelo as any} action={`/modelos/${id}`} method="PATCH" submitLabel="Guardar cambios" />
  ) : (
    <p class="text-muted" style="font-size:12px;margin-top:24px">Solo lectura. Necesitas rol editor o admin para modificar.</p>
  )}
</Layout>
