---
import Layout from '../../components/Layout.astro';
import ModeloForm from '../../components/modelos/ModeloForm.astro';
import { requireUser, canEdit, canSeePrecios } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { formatFecha, calcularEdad, cumpleCorto, diasAlCumple } from '../../lib/fechas';
import { logAudit } from '../../lib/audit';

const user = requireUser(Astro);
const editable = canEdit(user);
const verPrecios = canSeePrecios(user);
const db = getDB(Astro);
const { id } = Astro.params;

let error: string | null = null;
let saved = false;

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const method = form.get('_method');
  if (method === 'DELETE') {
    const prev = await db.prepare('SELECT nombre FROM modelos WHERE id = ?').bind(id).first<{ nombre: string }>();
    await db.prepare('DELETE FROM modelos WHERE id = ?').bind(id).run();
    await logAudit(db, { user, accion: 'delete', entidad: 'modelo', entidad_id: id, entidad_label: prev?.nombre ?? null });
    return Astro.redirect('/modelos');
  }
  // Update
  const nombre = (form.get('nombre') as string)?.trim();
  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    const get = (k: string) => {
      const v = form.get(k);
      return v === null || v === '' ? null : String(v).trim();
    };
    const getNum = (k: string) => {
      const v = form.get(k);
      if (v === null || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    };
    const chk = (k: string) => (form.get(k) === '1' ? 1 : 0);
    await db
      .prepare(
        `UPDATE modelos SET
          nombre = ?, email = ?, whatsapp = ?, instagram = ?, cumpleanos = ?, genero = ?,
          estatura_cm = ?, busto_cm = ?, cintura_cm = ?, cadera_cm = ?, calzado_mx = ?,
          cabello = ?, ojos = ?, ciudad = ?, talentos = ?, notas = ?, estado = ?,
          polas = ?, book = ?, videocasting = ?, drive_folder = ?,
          material_actualizado_en = ?, material_notas = ?, updated_at = ?
        WHERE id = ?`
      )
      .bind(
        nombre,
        get('email'),
        get('whatsapp'),
        get('instagram'),
        get('cumpleanos'),
        get('genero'),
        getNum('estatura_cm'),
        getNum('busto_cm'),
        getNum('cintura_cm'),
        getNum('cadera_cm'),
        getNum('calzado_mx'),
        get('cabello'),
        get('ojos'),
        get('ciudad'),
        get('talentos'),
        get('notas'),
        get('estado') ?? 'activo',
        chk('polas'),
        chk('book'),
        chk('videocasting'),
        get('drive_folder'),
        get('material_actualizado_en'),
        get('material_notas'),
        now(),
        id
      )
      .run();
    await logAudit(db, { user, accion: 'update', entidad: 'modelo', entidad_id: id, entidad_label: nombre });
    saved = true;
  }
}

const modelo = await db
  .prepare('SELECT * FROM modelos WHERE id = ?')
  .bind(id)
  .first();

if (!modelo) {
  return Astro.redirect('/modelos');
}

// Trabajos históricos del modelo
const { results: trabajos } = await db
  .prepare(
    'SELECT id, tipo, cliente, fecha, horas, pago_mxn, notas FROM trabajos_modelo WHERE modelo_id = ? ORDER BY fecha DESC'
  )
  .bind(id)
  .all<any>();

// Líneas de producción donde aparece (FK directo o por nombre como fallback)
const nombreLike = `%${modelo.nombre}%`;
const { results: lineasPorNombre } = await db
  .prepare(
    `SELECT lp.id, lp.rol, lp.cobro_cliente, lp.pago_proveedor, lp.estado,
            p.id as prod_id, p.titulo as prod_titulo, p.fecha_inicio as prod_fecha
     FROM lineas_produccion lp
     JOIN producciones p ON p.id = lp.produccion_id
     WHERE lp.modelo_id = ? OR lp.nombre_libre LIKE ?
     ORDER BY p.fecha_inicio DESC LIMIT 30`
  )
  .bind(id, nombreLike)
  .all<any>();

// Castings donde está propuesta o seleccionada
const { results: castingsProp } = await db
  .prepare(
    `SELECT DISTINCT c.id, c.cliente, c.fecha, c.etapa,
            CASE WHEN c.modelo_seleccionado_id = ? THEN 1 ELSE 0 END as seleccionada
     FROM castings c
     LEFT JOIN casting_modelos_propuestos cmp ON cmp.casting_id = c.id
     WHERE cmp.modelo_id = ? OR c.modelo_seleccionado_id = ?
     ORDER BY c.fecha DESC LIMIT 20`
  )
  .bind(id, id, id)
  .all<any>();

// Próximas producciones (agenda) del modelo
const { results: proximas } = await db
  .prepare(
    `SELECT lp.rol, p.id as prod_id, p.titulo, p.fecha_inicio, p.estado, p.tipo_produccion,
            cl.nombre as cliente, p.cliente_id
     FROM lineas_produccion lp
     JOIN producciones p   ON p.id = lp.produccion_id
     LEFT JOIN clientes cl ON cl.id = p.cliente_id
     WHERE lp.modelo_id = ? AND lp.estado != 'cancelado'
       AND p.estado != 'cancelada' AND p.fecha_inicio >= date('now')
     ORDER BY p.fecha_inicio ASC`
  )
  .bind(id)
  .all<any>();

// ── Stats del perfil ──────────────────────────────────────────────────────
// % de perfil completado: cuenta campos opcionales rellenos / total.
// Campos clave del perfil de una modelo (excluye nombre que es obligatorio
// y notas internas que no aporta al "perfil" para clientes).
const camposTexto = [
  modelo.email, modelo.whatsapp, modelo.instagram, modelo.cumpleanos, modelo.genero, modelo.ciudad,
  modelo.cabello, modelo.ojos, modelo.talentos, modelo.drive_folder,
] as (string | null | undefined)[];
const camposNum = [
  modelo.estatura_cm, modelo.busto_cm, modelo.cintura_cm, modelo.cadera_cm, modelo.calzado_mx,
] as (number | null | undefined)[];
const camposCheck = [modelo.polas, modelo.book, modelo.videocasting] as (number | null | undefined)[];
const completos =
  camposTexto.filter((v) => v !== null && v !== undefined && String(v).trim() !== '').length +
  camposNum.filter((v) => v !== null && v !== undefined).length +
  camposCheck.filter((v) => v === 1).length;
const totalCampos = camposTexto.length + camposNum.length + camposCheck.length;
const pctCompleto = totalCampos > 0 ? Math.round((completos / totalCampos) * 100) : 0;
const colorPct =
  pctCompleto >= 80 ? 'var(--text-ok,#4ade80)' :
  pctCompleto >= 50 ? '#e9b949' : 'var(--danger,#e25555)';

// Total de trabajos: trabajos_modelo (registro oficial) + lineas_produccion
// historicas (apariciones en producciones del repo nuevo).
const totalTrabajos = (trabajos?.length ?? 0) + (lineasPorNombre?.length ?? 0);

// Ultima edicion del registro: timestamp ms del UPDATE mas reciente.
const updTs = modelo.updated_at ? Number(modelo.updated_at) : null;
const ultimaEdicion = updTs ? new Date(updTs).toISOString().slice(0, 10) : null;

// Token para el feed .ics suscribible (Google/Apple Calendar). Se genera si falta.
let icsToken = (modelo as any).ics_token as string | null;
if (!icsToken) {
  icsToken = crypto.randomUUID().replace(/-/g, '');
  await db.prepare('UPDATE modelos SET ics_token = ? WHERE id = ?').bind(icsToken, id).run();
}
const icsUrl = `${Astro.url.origin}/api/ics/modelo/${icsToken}.ics`;

const colorEstado: Record<string, string> = {
  planeacion: '#e9b949', confirmada: 'var(--text-ok,#4ade80)', en_curso: '#6ab7ff',
  completada: 'var(--text-muted,#888)', cancelada: 'var(--danger,#e25555)'
};
---

<Layout title={`Editar — ${modelo.nombre}`} pageTitle={modelo.nombre as string}>
  <div class="page-head">
    <div>
      {(() => {
        const edad = calcularEdad(modelo.cumpleanos);
        const corto = cumpleCorto(modelo.cumpleanos);
        const dias = diasAlCumple(modelo.cumpleanos);
        return (
          <>
            <h1 style="margin:0">
              {modelo.nombre}
              {edad != null && (
                <span style="color:var(--text-2);font-weight:400;font-size:.7em;margin-left:10px;letter-spacing:0">
                  {edad} años
                </span>
              )}
            </h1>
            {corto && (
              <div class="card-meta" style="margin-top:4px">
                <span class="text-muted">🎂 {corto}</span>
                {dias != null && dias <= 14 && <span style="color:#e879f9">{dias === 0 ? '¡es hoy!' : dias === 1 ? 'mañana' : `en ${dias} días`}</span>}
              </div>
            )}
          </>
        );
      })()}
    </div>
    <div style="display:flex;gap:10px">
      <a href="/modelos" class="btn btn-sm">Volver</a>
      {editable && (
        <form method="POST" action={`/modelos/${id}`} onsubmit="return confirm('¿Eliminar esta modelo? No se puede deshacer.')" style="display:inline">
          <input type="hidden" name="_method" value="DELETE" />
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      )}
    </div>
  </div>

  {saved && <p class="text-ok" style="margin-bottom:20px">Guardado.</p>}
  {error && <p class="text-danger" style="margin-bottom:20px">{error}</p>}

  {/* ── Stats del perfil ── */}
  <div class="row" style="margin-bottom:24px">
    <div class="col card" style={`border-left:3px solid ${colorPct}`}>
      <div class="card-meta">Perfil completo</div>
      <div class="card-title mono" style={`color:${colorPct}`}>{pctCompleto}%</div>
      <div class="text-muted" style="font-size:11px;margin-top:2px">{completos}/{totalCampos} campos</div>
    </div>
    <div class="col card">
      <div class="card-meta">Trabajos</div>
      <div class="card-title mono">{totalTrabajos}</div>
      <div class="text-muted" style="font-size:11px;margin-top:2px">
        {trabajos?.length ?? 0} historicos · {lineasPorNombre?.length ?? 0} en producciones
      </div>
    </div>
    <div class="col card">
      <div class="card-meta">Ultima actualizacion</div>
      <div class="card-title mono" style="font-size:15px">{ultimaEdicion ?? '—'}</div>
      <div class="text-muted" style="font-size:11px;margin-top:2px">
        {modelo.material_actualizado_en ? `Material subido: ${modelo.material_actualizado_en}` : 'Sin material subido aun'}
      </div>
    </div>
  </div>

  {/* ── Agenda / próximas producciones ── */}
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <h2 style="margin:0">Próximas producciones <small class="text-muted" style="font-size:12px;letter-spacing:0;text-transform:none">{proximas?.length ?? 0}</small></h2>
    <div style="display:flex;gap:8px">
      <a href={`/calendario?modelo=${id}`} class="btn btn-sm">Ver en calendario</a>
      <button type="button" class="btn btn-sm" id="btn_copy_ics">Copiar enlace Google Calendar</button>
    </div>
  </div>

  {proximas && proximas.length > 0 ? (
    <div class="table-card" style="margin-bottom:14px">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Producción</th><th>Cliente</th><th>Tipo</th><th>Rol</th><th>Estado</th></tr>
        </thead>
        <tbody>
          {(proximas as any[]).map((it) => (
            <tr>
              <td class="mono text-muted" style="white-space:nowrap">{formatFecha(it.fecha_inicio)}</td>
              <td><a href={`/producciones/${it.prod_id}`} style="color:inherit;font-weight:500">{it.titulo}</a></td>
              <td>{it.cliente_id ? <a href={`/clientes/${it.cliente_id}`} style="color:inherit">{it.cliente}</a> : <span class="text-muted">{it.cliente ?? '—'}</span>}</td>
              <td>{it.tipo_produccion ? <span class="chip" style="font-size:10px">{it.tipo_produccion}</span> : <span class="text-muted">—</span>}</td>
              <td><span class="text-muted" style="font-size:12px">{it.rol ?? '—'}</span></td>
              <td><span class="chip" style={`font-size:10px;color:${colorEstado[it.estado] ?? ''}`}>{it.estado}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="text-muted" style="margin-bottom:14px">Sin producciones próximas agendadas.</p>
  )}

  <details style="margin-bottom:32px">
    <summary class="text-muted" style="cursor:pointer;font-size:11px;letter-spacing:.15em;text-transform:uppercase">Sincronizar con Google Calendar</summary>
    <div style="background:var(--bg-2);border:1px solid var(--border);padding:14px;margin-top:8px;border-radius:4px">
      <p class="text-muted" style="font-size:12px;margin-bottom:8px">
        Suscribe este enlace en Google Calendar (Otros calendarios → Desde URL) o Apple Calendar.
        Las producciones de {modelo.nombre} aparecerán y se actualizarán solas.
      </p>
      <input class="input mono" id="ics_url" readonly value={icsUrl} style="font-size:11px" onclick="this.select()" />
    </div>
  </details>

  {trabajos && trabajos.length > 0 && (
    <>
      <h2>Trabajos históricos <small class="text-muted" style="font-size:12px;letter-spacing:0;font-family:var(--font-body);text-transform:none">{trabajos.length}</small></h2>
      <div style="overflow-x:auto;margin-bottom:32px">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
          <thead>
            <tr style="border-bottom:1px solid var(--border);text-align:left">
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Fecha</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Tipo</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Cliente</th>
              <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2);text-align:right">Horas</th>
              {verPrecios && <th style="padding:10px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2);text-align:right">Pago</th>}
            </tr>
          </thead>
          <tbody>
            {trabajos.map((t: any) => (
              <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:10px">{t.fecha ?? '—'}</td>
                <td style="padding:10px">{t.tipo}</td>
                <td style="padding:10px">{t.cliente ?? '—'}</td>
                <td style="padding:10px;text-align:right">{t.horas ?? '—'}</td>
                {verPrecios && <td style="padding:10px;text-align:right;color:var(--gold)">{t.pago_mxn ? `$${Math.round(t.pago_mxn).toLocaleString('es-MX')}` : '—'}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {lineasPorNombre && lineasPorNombre.length > 0 && (
    <>
      <h2>Producciones donde aparece</h2>
      <div class="grid" style="margin-bottom:32px">
        {lineasPorNombre.map((l: any) => (
          <a href={`/producciones/${l.prod_id}`} style="display:block;color:inherit;text-decoration:none">
            <article class="card">
              <div class="card-title" style="font-size:14px">{l.prod_titulo}</div>
              <div class="card-meta">
                <span class="chip">{l.rol}</span>
                {l.prod_fecha && <span class="text-muted">{l.prod_fecha}</span>}
                <span style="color:var(--gold);margin-left:auto">${Math.round(l.pago_proveedor || 0).toLocaleString('es-MX')}</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </>
  )}

  {castingsProp && castingsProp.length > 0 && (
    <>
      <h2>Castings</h2>
      <div class="grid" style="margin-bottom:32px">
        {castingsProp.map((c: any) => (
          <a href={`/castings/${c.id}`} style="display:block;color:inherit;text-decoration:none">
            <article class="card" style={c.seleccionada ? 'border-color:var(--ok)' : ''}>
              <div class="card-title" style="font-size:14px">{c.cliente}</div>
              <div class="card-meta">
                <span class="chip">{c.etapa}</span>
                {c.seleccionada ? <span class="chip chip-ok">Seleccionada</span> : <span class="text-muted">Propuesta</span>}
                {c.fecha && <span class="text-muted">{c.fecha}</span>}
              </div>
            </article>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Datos generales</h2>
  {editable ? (
    <ModeloForm modelo={modelo as any} action={`/modelos/${id}`} method="PATCH" submitLabel="Guardar cambios" />
  ) : (
    <p class="text-muted" style="font-size:12px;margin-top:24px">Solo lectura. Necesitas rol editor o admin para modificar.</p>
  )}
</Layout>

<script>
  document.getElementById('btn_copy_ics')?.addEventListener('click', async () => {
    const inp = document.getElementById('ics_url') as HTMLInputElement | null;
    const btn = document.getElementById('btn_copy_ics');
    if (!inp || !btn) return;
    try {
      await navigator.clipboard.writeText(inp.value);
      const prev = btn.textContent;
      btn.textContent = '✓ Copiado';
      setTimeout(() => { btn.textContent = prev; }, 1800);
    } catch {
      inp.select();
    }
  });
</script>
