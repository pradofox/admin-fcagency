---
import Layout from '../../components/Layout.astro';
import ModeloCard from '../../components/modelos/ModeloCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../lib/session';
import { getDB } from '../../lib/db';

const user = requireUser(Astro);
const db = getDB(Astro);

const filtroEstado = Astro.url.searchParams.get('estado') ?? 'activo';
const filtros = ['activo', 'pausa', 'aspirante', 'archivado'];
const search = (Astro.url.searchParams.get('q') ?? '').trim();

// SELECT con calculo inline del % de perfil completo (mismos 18 campos
// que se evaluan en /modelos/[id]). Asi la card de cada modelo muestra
// su % sin necesidad de calcular en JS o hacer N queries extras.
const SELECT_BASE = `SELECT id, nombre, ciudad, instagram, estado, cumpleanos,
  (
    (CASE WHEN email      IS NOT NULL AND email      != '' THEN 1 ELSE 0 END) +
    (CASE WHEN whatsapp   IS NOT NULL AND whatsapp   != '' THEN 1 ELSE 0 END) +
    (CASE WHEN instagram  IS NOT NULL AND instagram  != '' THEN 1 ELSE 0 END) +
    (CASE WHEN cumpleanos IS NOT NULL AND cumpleanos != '' THEN 1 ELSE 0 END) +
    (CASE WHEN genero     IS NOT NULL AND genero     != '' THEN 1 ELSE 0 END) +
    (CASE WHEN ciudad     IS NOT NULL AND ciudad     != '' THEN 1 ELSE 0 END) +
    (CASE WHEN cabello    IS NOT NULL AND cabello    != '' THEN 1 ELSE 0 END) +
    (CASE WHEN ojos       IS NOT NULL AND ojos       != '' THEN 1 ELSE 0 END) +
    (CASE WHEN talentos   IS NOT NULL AND talentos   != '' THEN 1 ELSE 0 END) +
    (CASE WHEN drive_folder IS NOT NULL AND drive_folder != '' THEN 1 ELSE 0 END) +
    (CASE WHEN estatura_cm IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN busto_cm    IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN cintura_cm  IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN cadera_cm   IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN calzado_mx  IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN polas        = 1 THEN 1 ELSE 0 END) +
    (CASE WHEN book         = 1 THEN 1 ELSE 0 END) +
    (CASE WHEN videocasting = 1 THEN 1 ELSE 0 END)
  ) AS campos_completos
 FROM modelos`;

let results: any[] = [];
if (search) {
  const like = `%${search}%`;
  const r = await db
    .prepare(`${SELECT_BASE} WHERE (nombre LIKE ? OR instagram LIKE ? OR ciudad LIKE ?) ORDER BY nombre ASC LIMIT 200`)
    .bind(like, like, like)
    .all<any>();
  results = r.results ?? [];
} else {
  const r = await db
    .prepare(`${SELECT_BASE} WHERE estado = ? ORDER BY nombre ASC LIMIT 200`)
    .bind(filtroEstado)
    .all<any>();
  results = r.results ?? [];
}

const totalActivos = await db.prepare("SELECT COUNT(*) as c FROM modelos WHERE estado = 'activo'").first<{ c: number }>();
const totalAspirantes = await db.prepare("SELECT COUNT(*) as c FROM modelos WHERE estado = 'aspirante'").first<{ c: number }>();
const totalGeneral = await db.prepare("SELECT COUNT(*) as c FROM modelos").first<{ c: number }>();

// Material = polas + book + videocasting. "Completo" = los 3 marcados.
// Cuenta solo entre activas porque las archivadas/pausa no son operativas.
const materialStats = await db
  .prepare(
    `SELECT
       SUM(CASE WHEN polas = 1 AND book = 1 AND videocasting = 1 THEN 1 ELSE 0 END) AS completas,
       COUNT(*) AS total
     FROM modelos WHERE estado = 'activo'`
  )
  .first<{ completas: number; total: number }>();

const matCompletas = materialStats?.completas ?? 0;
const matTotal     = materialStats?.total ?? 0;
const matFaltantes = matTotal - matCompletas;
const pctMatCompletas = matTotal ? Math.round((matCompletas / matTotal) * 100) : 0;
const pctMatFaltantes = matTotal ? Math.round((matFaltantes / matTotal) * 100) : 0;

const totalGen = totalGeneral?.c ?? 0;
const activasN = totalActivos?.c ?? 0;
const pctActivas = totalGen ? Math.round((activasN / totalGen) * 100) : 0;

// ── Resumen de perfiles completos (solo activas) ──────────────────────────
// Cuenta para cada modelo activa cuántos de los 18 campos del perfil están
// rellenos. Mismos campos que se usan en /modelos/[id].astro para que el
// "% perfil completo" individual y el promedio aquí coincidan.
const perfilStats = await db
  .prepare(
    `SELECT
       COUNT(*) AS total,
       AVG(c) AS promedio,
       SUM(CASE WHEN c >= 14 THEN 1 ELSE 0 END) AS altas,
       SUM(CASE WHEN c BETWEEN 9 AND 13 THEN 1 ELSE 0 END) AS medias,
       SUM(CASE WHEN c < 9 THEN 1 ELSE 0 END) AS bajas
     FROM (
       SELECT (
         (CASE WHEN email      IS NOT NULL AND email      != '' THEN 1 ELSE 0 END) +
         (CASE WHEN whatsapp   IS NOT NULL AND whatsapp   != '' THEN 1 ELSE 0 END) +
         (CASE WHEN instagram  IS NOT NULL AND instagram  != '' THEN 1 ELSE 0 END) +
         (CASE WHEN cumpleanos IS NOT NULL AND cumpleanos != '' THEN 1 ELSE 0 END) +
         (CASE WHEN genero     IS NOT NULL AND genero     != '' THEN 1 ELSE 0 END) +
         (CASE WHEN ciudad     IS NOT NULL AND ciudad     != '' THEN 1 ELSE 0 END) +
         (CASE WHEN cabello    IS NOT NULL AND cabello    != '' THEN 1 ELSE 0 END) +
         (CASE WHEN ojos       IS NOT NULL AND ojos       != '' THEN 1 ELSE 0 END) +
         (CASE WHEN talentos   IS NOT NULL AND talentos   != '' THEN 1 ELSE 0 END) +
         (CASE WHEN drive_folder IS NOT NULL AND drive_folder != '' THEN 1 ELSE 0 END) +
         (CASE WHEN estatura_cm IS NOT NULL THEN 1 ELSE 0 END) +
         (CASE WHEN busto_cm    IS NOT NULL THEN 1 ELSE 0 END) +
         (CASE WHEN cintura_cm  IS NOT NULL THEN 1 ELSE 0 END) +
         (CASE WHEN cadera_cm   IS NOT NULL THEN 1 ELSE 0 END) +
         (CASE WHEN calzado_mx  IS NOT NULL THEN 1 ELSE 0 END) +
         (CASE WHEN polas        = 1 THEN 1 ELSE 0 END) +
         (CASE WHEN book         = 1 THEN 1 ELSE 0 END) +
         (CASE WHEN videocasting = 1 THEN 1 ELSE 0 END)
       ) AS c
       FROM modelos WHERE estado = 'activo'
     )`
  )
  .first<{ total: number; promedio: number; altas: number; medias: number; bajas: number }>();

const totalCamposPerfil = 18;
const pctPromedio = perfilStats?.promedio
  ? Math.round((perfilStats.promedio / totalCamposPerfil) * 100)
  : 0;
const totalP = perfilStats?.total ?? 0;
const altas = perfilStats?.altas ?? 0;
const medias = perfilStats?.medias ?? 0;
const bajas = perfilStats?.bajas ?? 0;
const pctAltas  = totalP ? (altas  / totalP) * 100 : 0;
const pctMedias = totalP ? (medias / totalP) * 100 : 0;
const pctBajas  = totalP ? (bajas  / totalP) * 100 : 0;
---

<Layout title="Modelos" pageTitle="Modelos">
  <div class="page-head">
    <h1>Modelos <small class="text-muted" style="font-size:13px;letter-spacing:0;font-family:var(--font-body);text-transform:none">{totalActivos?.c ?? 0} activas · {totalAspirantes?.c ?? 0} aspirantes</small></h1>
    <div style="display:flex;gap:10px">
      <a href="/modelos/agenda" class="btn btn-sm">Agenda</a>
      <a href="/modelos/material" class="btn btn-sm">Material</a>
      <a href="/api/modelos/export" class="btn btn-sm">Exportar CSV</a>
      {canEdit(user) && <a href="/modelos/nuevo" class="btn btn-primary">+ Nueva</a>}
    </div>
  </div>

  {/* ── Stats globales: activas / material faltante ── */}
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin-bottom:12px">
    <div style="background:var(--bg-2);border:1px solid var(--border);border-left:3px solid var(--text-ok,#4ade80);padding:12px 14px;border-radius:4px">
      <div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Modelos activas</div>
      <div style="display:flex;align-items:baseline;gap:8px;margin-top:4px">
        <span class="mono" style="font-size:22px;color:var(--text-ok,#4ade80)">{pctActivas}%</span>
        <span class="text-muted" style="font-size:12px">{activasN} de {totalGen} en el roster</span>
      </div>
    </div>
    <div style={`background:var(--bg-2);border:1px solid var(--border);border-left:3px solid ${pctMatFaltantes >= 50 ? 'var(--danger,#e25555)' : pctMatFaltantes >= 25 ? '#E5E5E5' : 'var(--text-ok,#4ade80)'};padding:12px 14px;border-radius:4px`}>
      <div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">Material faltante</div>
      <div style="display:flex;align-items:baseline;gap:8px;margin-top:4px">
        <span class="mono" style={`font-size:22px;color:${pctMatFaltantes >= 50 ? 'var(--danger,#e25555)' : pctMatFaltantes >= 25 ? '#E5E5E5' : 'var(--text-ok,#4ade80)'}`}>{pctMatFaltantes}%</span>
        <span class="text-muted" style="font-size:12px">{matFaltantes} de {matTotal} activas</span>
      </div>
      <div class="text-muted" style="font-size:10px;margin-top:2px">{matCompletas} ya tienen polas + book + videocasting</div>
    </div>
  </div>

  {totalP > 0 && (
    <div style="background:var(--bg-2);border:1px solid var(--border);padding:14px 16px;border-radius:4px;margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;gap:12px;flex-wrap:wrap">
        <div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-2)">
          Perfiles completos (de {totalP} activas)
        </div>
        <div class="mono" style="font-size:13px">
          <span style={`color:${pctPromedio >= 80 ? 'var(--text-ok,#4ade80)' : pctPromedio >= 50 ? '#E5E5E5' : 'var(--danger,#e25555)'}`}>{pctPromedio}%</span>
          <span class="text-muted" style="font-size:11px">&nbsp;promedio</span>
        </div>
      </div>
      <div style="height:10px;border-radius:3px;overflow:hidden;display:flex;background:var(--bg-3,#1a1a1a)">
        {altas  > 0 && <div title={`${altas} con perfil ≥80%`} style={`flex:0 0 ${pctAltas}%;background:var(--text-ok,#4ade80);opacity:.85`}></div>}
        {medias > 0 && <div title={`${medias} con perfil 50–79%`} style={`flex:0 0 ${pctMedias}%;background:#E5E5E5;opacity:.85`}></div>}
        {bajas  > 0 && <div title={`${bajas} con perfil <50%`} style={`flex:0 0 ${pctBajas}%;background:var(--danger,#e25555);opacity:.85`}></div>}
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:11px">
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:10px;height:10px;border-radius:2px;background:var(--text-ok,#4ade80);opacity:.85;display:inline-block"></span>
          <span class="text-muted">≥80% completo</span>
          <span class="mono">{altas}</span>
        </span>
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:10px;height:10px;border-radius:2px;background:#E5E5E5;opacity:.85;display:inline-block"></span>
          <span class="text-muted">50–79%</span>
          <span class="mono">{medias}</span>
        </span>
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:10px;height:10px;border-radius:2px;background:var(--danger,#e25555);opacity:.85;display:inline-block"></span>
          <span class="text-muted">&lt;50%</span>
          <span class="mono">{bajas}</span>
        </span>
      </div>
    </div>
  )}

  <form method="GET" action="/modelos" class="toolbar">
    <input
      class="input"
      type="search"
      name="q"
      value={search}
      placeholder="Buscar por nombre, instagram, ciudad…"
    />
  </form>

  {!search && (
    <div class="filters">
      {filtros.map((f) => (
        <a href={`/modelos?estado=${f}`} class={`filter-chip ${filtroEstado === f ? 'active' : ''}`}>{f}</a>
      ))}
    </div>
  )}

  {search && (
    <p class="text-muted" style="font-size:12px;margin-bottom:16px">
      Resultados de búsqueda para "{search}" — {results.length} encontradas. <a href="/modelos">Limpiar</a>
    </p>
  )}

  {results.length > 0 ? (
    <div class="grid">
      {results.map((m) => <ModeloCard modelo={m} />)}
    </div>
  ) : (
    <EmptyState
      title={search ? 'Sin resultados' : 'Sin modelos en este estado'}
      message={search ? `Nada coincide con "${search}".` : `No hay modelos con estado "${filtroEstado}".`}
    />
  )}
</Layout>
