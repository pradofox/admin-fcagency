---
import Layout from '../../components/Layout.astro';
import { requireUser } from '../../lib/session';
import { getDB } from '../../lib/db';
import { formatFecha } from '../../lib/fechas';

const user = requireUser(Astro);
const db = getDB(Astro);

// Vista: proximas (default) | historial | todas
const vista = Astro.url.searchParams.get('vista') ?? 'proximas';
const modeloFiltro = Astro.url.searchParams.get('modelo') ?? null;

let where = `lp.modelo_id IS NOT NULL AND lp.estado != 'cancelado' AND p.estado != 'cancelada' AND p.fecha_inicio IS NOT NULL`;
const binds: any[] = [];
if (vista === 'proximas')      where += ` AND p.fecha_inicio >= date('now')`;
else if (vista === 'historial') where += ` AND p.fecha_inicio < date('now')`;
if (modeloFiltro) { where += ` AND lp.modelo_id = ?`; binds.push(modeloFiltro); }

const orden = vista === 'historial' ? 'DESC' : 'ASC';

const { results: filas } = await db
  .prepare(
    `SELECT m.id as modelo_id, m.nombre as modelo, m.estado as modelo_estado,
            lp.rol,
            p.id as prod_id, p.titulo, p.fecha_inicio, p.estado, p.tipo_produccion,
            cl.nombre as cliente, p.cliente_id
     FROM lineas_produccion lp
     JOIN modelos m       ON m.id = lp.modelo_id
     JOIN producciones p  ON p.id = lp.produccion_id
     LEFT JOIN clientes cl ON cl.id = p.cliente_id
     WHERE ${where}
     ORDER BY p.fecha_inicio ${orden}, m.nombre ASC`
  )
  .bind(...binds)
  .all<any>();

// Agrupar por modelo
const porModelo = new Map<string, { id: string; nombre: string; estado: string; items: any[] }>();
for (const f of (filas ?? [])) {
  if (!porModelo.has(f.modelo_id)) {
    porModelo.set(f.modelo_id, { id: f.modelo_id, nombre: f.modelo, estado: f.modelo_estado, items: [] });
  }
  porModelo.get(f.modelo_id)!.items.push(f);
}
const grupos = Array.from(porModelo.values());

// Si filtramos por un modelo, traemos su nombre para el encabezado
const modeloActivo = modeloFiltro
  ? await db.prepare('SELECT id, nombre FROM modelos WHERE id = ?').bind(modeloFiltro).first<any>()
  : null;

const totalProds = (filas ?? []).length;

const colorEstado: Record<string, string> = {
  planeacion: '#E5E5E5', confirmada: 'var(--text-ok,#4ade80)', en_curso: '#6ab7ff',
  completada: 'var(--text-muted,#888)', cancelada: 'var(--danger,#e25555)'
};

const VISTAS = [
  { v: 'proximas',  label: 'Próximas' },
  { v: 'historial', label: 'Historial' },
  { v: 'todas',     label: 'Todas' },
];

function vistaHref(v: string) {
  const p = new URLSearchParams();
  if (v !== 'proximas') p.set('vista', v);
  if (modeloFiltro) p.set('modelo', modeloFiltro);
  const s = p.toString();
  return `/modelos/agenda${s ? '?' + s : ''}`;
}
---

<Layout title="Agenda de modelos" pageTitle="Modelos">
  <div class="page-head">
    <div>
      <h1 style="margin:0">Agenda de modelos</h1>
      {modeloActivo && (
        <div class="card-meta" style="margin-top:4px">
          <span class="text-muted">filtrando:</span>
          <span class="chip" style="color:var(--gold)">{modeloActivo.nombre}</span>
          <a href={vista === 'proximas' ? '/modelos/agenda' : `/modelos/agenda?vista=${vista}`} class="text-muted" style="font-size:11px">✕ quitar filtro</a>
        </div>
      )}
    </div>
    <div style="display:flex;gap:8px">
      <a href="/calendario" class="btn btn-sm">Calendario</a>
      <a href="/modelos" class="btn btn-sm">Volver</a>
    </div>
  </div>

  <div class="filters" style="margin-bottom:20px">
    {VISTAS.map((x) => (
      <a href={vistaHref(x.v)} class={`filter-chip ${vista === x.v ? 'active' : ''}`}>{x.label}</a>
    ))}
    <span class="text-muted" style="font-size:11px;margin-left:8px">{totalProds} producci{totalProds === 1 ? 'ón' : 'ones'} · {grupos.length} modelo{grupos.length === 1 ? '' : 's'}</span>
  </div>

  {grupos.length === 0 ? (
    <div class="card" style="text-align:center;padding:40px">
      <p class="text-muted">
        {vista === 'proximas'
          ? 'Ningún modelo tiene producciones próximas agendadas.'
          : 'Sin producciones para esta vista.'}
      </p>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:20px">
      {grupos.map((g) => (
        <div class="table-card">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border)">
            <div style="display:flex;gap:10px;align-items:center">
              <a href={`/modelos/${g.id}`} style="color:var(--gold);text-decoration:none;font-weight:600;font-size:15px">{g.nombre}</a>
              {g.estado && g.estado !== 'activo' && <span class="chip" style="font-size:10px">{g.estado}</span>}
              <span class="text-muted" style="font-size:11px">{g.items.length} producci{g.items.length === 1 ? 'ón' : 'ones'}</span>
            </div>
            <a href={`/calendario?modelo=${g.id}`} class="btn btn-sm">Ver en calendario</a>
          </div>
          <table>
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Producción</th>
                <th>Cliente</th>
                <th>Tipo</th>
                <th>Rol</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {g.items.map((it: any) => (
                <tr>
                  <td class="mono text-muted" style="white-space:nowrap">{formatFecha(it.fecha_inicio)}</td>
                  <td><a href={`/producciones/${it.prod_id}`} style="color:inherit;font-weight:500">{it.titulo}</a></td>
                  <td>{it.cliente_id ? <a href={`/clientes/${it.cliente_id}`} style="color:inherit">{it.cliente}</a> : <span class="text-muted">{it.cliente ?? '—'}</span>}</td>
                  <td>{it.tipo_produccion ? <span class="chip" style="font-size:10px">{it.tipo_produccion}</span> : <span class="text-muted">—</span>}</td>
                  <td><span class="text-muted" style="font-size:12px">{it.rol ?? '—'}</span></td>
                  <td><span class="chip" style={`font-size:10px;color:${colorEstado[it.estado] ?? ''}`}>{it.estado}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  )}
</Layout>
