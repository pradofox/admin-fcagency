---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Revisa tu correo — admin.fcagency.mx</title>
  </head>
  <body>
    <div class="auth-shell">
      <div class="auth-box">
        <div class="auth-brand">FC AGENCY</div>
        <div class="auth-sub">link enviado</div>
        <p style="text-align:center;font-size:14px;line-height:1.7;color:var(--text)">
          Si tu email tiene acceso, te llegará un link en unos segundos.
        </p>
        <p style="text-align:center;font-size:13px;color:var(--text-2);margin-top:16px">
          El link funciona por 15 minutos.
        </p>
        <div class="form-actions" style="border-top:0;padding-top:0;margin-top:32px;justify-content:center">
          <a href="/login" class="btn">Volver</a>
        </div>
      </div>
    </div>
  </body>
</html>
