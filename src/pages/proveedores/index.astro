---
import Layout from '../../components/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { requireUser, canEdit } from '../../lib/session';
import { getDB, now } from '../../lib/db';
import { newId } from '../../lib/ids';

const user     = requireUser(Astro);
const editable = canEdit(user);
const db       = getDB(Astro);

const ROLES = [
  'Fotografía', 'Video', 'Modelo', 'Maquillaje', 'Peinado', 'Styling',
  'Producción', 'Arte / Set', 'Locación', 'Catering', 'Transporte',
  'Audio', 'Iluminación', 'Operación', 'Montaje', 'Estudio', 'Day pass',
  'Espacio', 'Pantallas', 'Desmontaje', 'Otro'
];

let error: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form   = await Astro.request.formData();
  const nombre = (form.get('nombre') as string)?.trim();
  const precio = Number(form.get('precio_mxn') ?? 0) || 0;

  if (!nombre) {
    error = 'El nombre del concepto es obligatorio.';
  } else {
    const get = (k: string) => { const v = form.get(k); return v === null || v === '' ? null : String(v).trim(); };
    const horaAdRaw = form.get('precio_hora_adicional');
    const horaAd = horaAdRaw === null || horaAdRaw === '' ? null : Number(horaAdRaw) || 0;
    const maxDescRaw = form.get('max_descuento');
    const maxDesc = maxDescRaw === null || maxDescRaw === '' ? null : Number(maxDescRaw) || 0;
    const ts = now();
    const id = newId();
    await db
      .prepare(`INSERT INTO conceptos_servicio (id, nombre, rol, categoria, descripcion, precio_mxn, precio_hora_adicional, max_descuento, notas, activo, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?)`)
      .bind(id, nombre, get('rol'), get('categoria'), get('descripcion'), precio, horaAd, maxDesc, get('notas'), ts, ts)
      .run();
    return Astro.redirect(`/proveedores/${id}`);
  }
}

const rolFiltro = Astro.url.searchParams.get('rol') ?? '';
const busqueda  = Astro.url.searchParams.get('q')   ?? '';

const where: string[] = ['cs.activo = 1'];
const binds: any[] = [];
if (rolFiltro) { where.push('(cs.categoria = ? OR cs.rol = ?)'); binds.push(rolFiltro, rolFiltro); }
if (busqueda)  { where.push('cs.nombre LIKE ?'); binds.push(`%${busqueda}%`); }

const { results: conceptos } = await db
  .prepare(
    `SELECT cs.id, cs.nombre, cs.rol, cs.categoria, cs.descripcion, cs.precio_mxn, cs.max_descuento,
            COUNT(r.id)    as num_proveedores,
            COALESCE(SUM(r.monto_mxn), 0) as total_repartido
     FROM conceptos_servicio cs
     LEFT JOIN repartos_concepto r ON r.concepto_id = cs.id
     WHERE ${where.join(' AND ')}
     GROUP BY cs.id
     ORDER BY cs.categoria, cs.rol, cs.nombre`
  )
  .bind(...binds)
  .all<any>();

// Agrupar por categoría (o rol como fallback en conceptos viejos)
const grouped = new Map<string, any[]>();
for (const c of (conceptos ?? [])) {
  const key = c.categoria ?? c.rol ?? 'Sin categoría';
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(c);
}
// Categorías de la hoja MATRIZ primero, luego roles sueltos, luego el resto.
const CATEGORIAS_FC = [
  'Producción editorial P.', 'Producción editorial E.', 'MODEL CAMP',
  'RENTA DISTRICT STUDIO', 'PASARELAS', 'EXTRAS'
];
const rolesOrdenados = [
  ...CATEGORIAS_FC.filter((c) => grouped.has(c)),
  ...ROLES.filter((r) => grouped.has(r)),
  ...[...grouped.keys()].filter((k) => !CATEGORIAS_FC.includes(k) && !ROLES.includes(k))
];
const categoriasExistentes = [...new Set((conceptos ?? []).map((c: any) => c.categoria).filter(Boolean))];

const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-MX')}`;
---

<Layout title="Catálogo de Servicios" pageTitle="Catálogo de Servicios">
  <div class="page-head">
    <div>
      <h1>Catálogo de Servicios</h1>
      <small class="text-muted">Conceptos con precios y reparto interno a proveedores</small>
    </div>
  </div>

  {error && <p class="text-danger" style="margin-bottom:16px">{error}</p>}

  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:20px;margin-bottom:24px">
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Nuevo concepto</summary>
      <form method="POST" action="/proveedores" style="margin-top:16px">
        <div class="row">
          <div class="col" style="flex:2">
            <label class="label">Nombre del concepto *</label>
            <input class="input" name="nombre" required placeholder='Ej. "Sesión editorial 4 hrs"' />
          </div>
          <div class="col">
            <label class="label">Categoría</label>
            <input class="input" name="categoria" list="categorias_fc" placeholder="Ej. PASARELAS" />
            <datalist id="categorias_fc">
              {categoriasExistentes.map((c: any) => <option value={c}></option>)}
            </datalist>
          </div>
          <div class="col">
            <label class="label">Rol (opcional)</label>
            <select class="select" name="rol" id="sel_rol_nuevo" onchange="toggleHoraAd()">
              <option value="">— seleccionar —</option>
              {ROLES.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label" id="lbl_precio_nuevo">Cobro al cliente MXN *</label>
            <input class="input" type="number" name="precio_mxn" required min="0" step="1" placeholder="0" />
          </div>
          <div class="col">
            <label class="label">Tope de descuento %</label>
            <input class="input" type="number" name="max_descuento" min="0" max="100" step="1" placeholder="Ej. 15" />
          </div>
          <div class="col"></div>
        </div>
        {/* Hora adicional — solo aplica a roles por hora (Modelo) */}
        <div id="row_hora_ad" style="display:none;background:var(--bg-3,#1a1a1a);border:1px solid var(--border);padding:12px;border-radius:4px;margin-bottom:6px">
          <label class="label" style="margin-top:0">Precio por hora adicional MXN</label>
          <input class="input" type="number" name="precio_hora_adicional" min="0" step="1" placeholder="Ej. 800" style="max-width:200px" />
          <p class="text-muted" style="font-size:11px;margin-top:6px">
            La 1ª hora cuesta lo de <strong>Cobro al cliente</strong> arriba; cada hora extra suma este monto. En la cotización eliges cuántas horas y se calcula solo.
          </p>
        </div>
        <label class="label">Descripción</label>
        <input class="input" name="descripcion" placeholder="Detalle del concepto (opcional)" />
        <label class="label" style="margin-top:10px">Notas internas</label>
        <textarea class="textarea" name="notas" rows="2"></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:14px">Crear concepto</button>
      </form>
    </details>
  )}

  {/* Filtros */}
  <div style="display:flex;gap:8px;margin-bottom:12px;align-items:center;flex-wrap:wrap">
    <form method="GET" action="/proveedores" style="display:flex;gap:6px">
      <input class="input" name="q" value={busqueda} placeholder="Buscar..." style="max-width:200px" />
      {rolFiltro && <input type="hidden" name="rol" value={rolFiltro} />}
      <button type="submit" class="btn btn-sm">Buscar</button>
      {(busqueda || rolFiltro) && <a href="/proveedores" class="btn btn-sm">✕</a>}
    </form>
  </div>
  <div class="filters" style="margin-bottom:24px">
    <a href={`/proveedores${busqueda ? '?q='+busqueda : ''}`}
       class={`filter-chip ${!rolFiltro ? 'active' : ''}`}>Todos</a>
    {CATEGORIAS_FC.filter((c) => grouped.has(c) || rolFiltro === c).map((c) => (
      <a href={`/proveedores?rol=${encodeURIComponent(c)}${busqueda ? '&q='+busqueda : ''}`}
         class={`filter-chip ${rolFiltro === c ? 'active' : ''}`}>{c}</a>
    ))}
    {ROLES.map((r) => (
      <a href={`/proveedores?rol=${encodeURIComponent(r)}${busqueda ? '&q='+busqueda : ''}`}
         class={`filter-chip ${rolFiltro === r ? 'active' : ''}`}>{r}</a>
    ))}
  </div>

  {rolesOrdenados.length > 0 ? (
    <div>
      {rolesOrdenados.map((rol) => {
        const items = grouped.get(rol)!;
        return (
          <div style="margin-bottom:32px">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:8px">
              <h2 style="margin:0;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">{rol}</h2>
              <span class="text-muted" style="font-size:11px">{items.length} concepto{items.length !== 1 ? 's' : ''}</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px">
              {items.map((c: any) => {
                const margen   = c.precio_mxn - (c.total_repartido ?? 0);
                const pctMar   = c.precio_mxn > 0 ? Math.round(margen / c.precio_mxn * 100) : 0;
                return (
                  <a href={`/proveedores/${c.id}`} class="card"
                     style="display:block;color:inherit;text-decoration:none">
                    <div style="font-weight:600;margin-bottom:2px">{c.nombre}</div>
                    {c.descripcion && <div class="text-muted" style="font-size:11px;margin-bottom:6px">{c.descripcion}</div>}
                    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px">
                      <span class="mono" style="color:var(--gold);font-size:15px">{fmt(c.precio_mxn)}</span>
                      {c.num_proveedores > 0 && (
                        <span class="text-muted" style="font-size:11px">{c.num_proveedores} proveedor{c.num_proveedores !== 1 ? 'es' : ''}</span>
                      )}
                    </div>
                    {c.num_proveedores > 0 && (
                      <div style="margin-top:6px">
                        {/* Barra de reparto */}
                        <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden">
                          <div style={`height:100%;width:${100-pctMar}%;background:var(--danger,#e25555)`}></div>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:10px;margin-top:3px">
                          <span class="text-muted">proveedores {fmt(c.total_repartido)}</span>
                          <span style={`color:${pctMar >= 15 ? 'var(--text-ok,#4ade80)' : 'var(--danger)'}`}>
                            margen {pctMar}%
                          </span>
                        </div>
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <EmptyState title="Sin conceptos" message="Crea conceptos de servicio para usarlos en cotizaciones." />
  )}
</Layout>

<script is:inline>
// Roles que se cobran por hora → muestran el campo de hora adicional
const ROLES_POR_HORA = ['Modelo'];
function toggleHoraAd() {
  const sel = document.getElementById('sel_rol_nuevo');
  const row = document.getElementById('row_hora_ad');
  const lbl = document.getElementById('lbl_precio_nuevo');
  if (!sel || !row) return;
  const esPorHora = ROLES_POR_HORA.includes(sel.value);
  row.style.display = esPorHora ? 'block' : 'none';
  if (lbl) lbl.textContent = esPorHora ? 'Cobro 1ª hora MXN *' : 'Cobro al cliente MXN *';
}
</script>
