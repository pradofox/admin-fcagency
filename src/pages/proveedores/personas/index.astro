---
import Layout from '../../../components/Layout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { requireSection, canEdit } from '../../../lib/session';
import { getDB, now } from '../../../lib/db';
import { newId } from '../../../lib/ids';
import { logAudit } from '../../../lib/audit';

const user     = requireSection(Astro, 'proveedores');
const editable = canEdit(user);
const db       = getDB(Astro);

// Tipos comunes para el datalist y filtros (no hay CHECK constraint para
// que Lili pueda agregar tipos nuevos sin migracion).
const TIPOS = [
  'Fotógrafo', 'Video', 'Modelo', 'Maquillaje', 'Peinado', 'Styling',
  'Producción', 'Catering', 'Locación', 'Transporte', 'Audio',
  'Iluminación', 'Arte / Set', 'Otro'
];

let error: string | null = null;

if (Astro.request.method === 'POST' && editable) {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string | null;

  if (action === 'delete') {
    const delId = form.get('id') as string;
    if (delId) {
      const prev = await db.prepare('SELECT nombre FROM proveedores_directorio WHERE id = ?').bind(delId).first<{ nombre: string }>();
      await db.prepare('DELETE FROM proveedores_directorio WHERE id = ?').bind(delId).run();
      await logAudit(db, { user, accion: 'delete', entidad: 'reparto', entidad_id: delId, entidad_label: prev?.nombre ?? null });
    }
    return Astro.redirect('/proveedores/personas');
  }

  if (action === 'toggle_activo') {
    const tId = form.get('id') as string;
    const nuevo = form.get('nuevo') === '1' ? 1 : 0;
    await db.prepare('UPDATE proveedores_directorio SET activo = ?, updated_at = ? WHERE id = ?').bind(nuevo, now(), tId).run();
    return Astro.redirect('/proveedores/personas');
  }

  const nombre = (form.get('nombre') as string)?.trim();
  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    const get = (k: string) => { const v = form.get(k); return v === null || v === '' ? null : String(v).trim(); };
    const tarifa = form.get('tarifa_base');
    const tarifaNum = tarifa === null || tarifa === '' ? null : Number(tarifa) || null;
    const id = newId();
    const ts = now();
    await db
      .prepare(
        `INSERT INTO proveedores_directorio
           (id, nombre, tipo, email, whatsapp, instagram, empresa, rfc, tarifa_base, tarifa_unidad, ciudad, notas, activo, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?)`
      )
      .bind(id, nombre, get('tipo'), get('email'), get('whatsapp'), get('instagram'), get('empresa'), get('rfc'), tarifaNum, get('tarifa_unidad'), get('ciudad'), get('notas'), ts, ts)
      .run();
    await logAudit(db, { user, accion: 'create', entidad: 'reparto', entidad_id: id, entidad_label: nombre, payload: { tipo: get('tipo') } });
    return Astro.redirect(`/proveedores/personas/${id}`);
  }
}

const filtroTipo = Astro.url.searchParams.get('tipo') ?? '';
const search = (Astro.url.searchParams.get('q') ?? '').trim();
const filtroActivo = Astro.url.searchParams.get('activo') ?? 'activos';

const where: string[] = [];
const binds: any[] = [];
if (filtroActivo === 'activos')  where.push('activo = 1');
if (filtroActivo === 'inactivos') where.push('activo = 0');
if (filtroTipo) { where.push('tipo = ?'); binds.push(filtroTipo); }
if (search)     { where.push('(nombre LIKE ? OR empresa LIKE ? OR instagram LIKE ?)'); const lk = `%${search}%`; binds.push(lk, lk, lk); }

const sql = `SELECT id, nombre, tipo, email, whatsapp, instagram, empresa, tarifa_base, tarifa_unidad, ciudad, activo
             FROM proveedores_directorio
             ${where.length ? 'WHERE ' + where.join(' AND ') : ''}
             ORDER BY tipo, nombre`;
const stmt = binds.length ? db.prepare(sql).bind(...binds) : db.prepare(sql);
const { results: provs } = await stmt.all<any>();

// Tipos existentes para chips de filtro (incluye tipos custom que Lili haya agregado)
const tiposExistentesRow = (await db.prepare("SELECT DISTINCT tipo FROM proveedores_directorio WHERE tipo IS NOT NULL AND tipo != '' ORDER BY tipo").all<{ tipo: string }>()).results ?? [];
const tiposExistentes = tiposExistentesRow.map((r: any) => r.tipo);

const total = provs?.length ?? 0;

// Agrupar por tipo para vista mas escaneable
const grupos = new Map<string, any[]>();
for (const p of (provs ?? [])) {
  const k = p.tipo || 'Sin tipo';
  if (!grupos.has(k)) grupos.set(k, []);
  grupos.get(k)!.push(p);
}

const fmt = (n: number | null) => n ? `$${Math.round(n).toLocaleString('es-MX')}` : '';
---

<Layout title="Proveedores" pageTitle="Catálogo de Servicios">
  <div class="page-head">
    <div>
      <h1>Directorio de proveedores</h1>
      <small class="text-muted">Personas y empresas que prestan servicios. Clasificados por tipo para encontrarlos rápido al armar producciones.</small>
    </div>
    <div style="display:flex;gap:8px">
      <a href="/proveedores" class="btn btn-sm">← Conceptos del catálogo</a>
    </div>
  </div>

  {error && <p class="text-danger" style="margin-bottom:16px">{error}</p>}

  {/* Alta inline */}
  {editable && (
    <details style="background:var(--bg-2);border:1px solid var(--border);padding:18px;margin-bottom:24px">
      <summary style="cursor:pointer;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)">+ Dar de alta proveedor</summary>
      <form method="POST" action="/proveedores/personas" style="margin-top:14px">
        <div class="row">
          <div class="col" style="flex:2">
            <label class="label">Nombre *</label>
            <input class="input" name="nombre" required placeholder='Ej. "Kevin Martínez" o "Catering La Cazuela"' />
          </div>
          <div class="col">
            <label class="label">Tipo</label>
            <input class="input" name="tipo" list="tipos_prov" placeholder="Ej. Fotógrafo" />
            <datalist id="tipos_prov">
              {[...new Set([...TIPOS, ...tiposExistentes])].map((t) => <option value={t}></option>)}
            </datalist>
          </div>
          <div class="col">
            <label class="label">Empresa</label>
            <input class="input" name="empresa" placeholder="Opcional" />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Email</label>
            <input class="input" type="email" name="email" />
          </div>
          <div class="col">
            <label class="label">WhatsApp</label>
            <input class="input" name="whatsapp" />
          </div>
          <div class="col">
            <label class="label">Instagram</label>
            <input class="input" name="instagram" placeholder="usuario" />
          </div>
          <div class="col">
            <label class="label">Ciudad</label>
            <input class="input" name="ciudad" />
          </div>
        </div>
        <div class="row">
          <div class="col">
            <label class="label">Tarifa base MXN</label>
            <input class="input" type="number" name="tarifa_base" min="0" step="1" placeholder="Opcional" />
          </div>
          <div class="col">
            <label class="label">Unidad de tarifa</label>
            <select class="select" name="tarifa_unidad">
              <option value="">— elegir —</option>
              <option value="hora">por hora</option>
              <option value="dia">por día</option>
              <option value="servicio">por servicio</option>
            </select>
          </div>
          <div class="col">
            <label class="label">RFC</label>
            <input class="input" name="rfc" />
          </div>
          <div class="col"></div>
        </div>
        <label class="label">Notas internas</label>
        <textarea class="textarea" name="notas" rows="2" placeholder="Disponibilidad, recomendaciones, advertencias..."></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:12px">Dar de alta</button>
      </form>
    </details>
  )}

  {/* Filtros */}
  <form method="GET" action="/proveedores/personas" style="display:flex;gap:6px;margin-bottom:10px;align-items:center;flex-wrap:wrap">
    <input class="input" type="search" name="q" value={search} placeholder="Buscar por nombre, empresa o instagram…" style="max-width:320px" />
    {filtroTipo && <input type="hidden" name="tipo" value={filtroTipo} />}
    {filtroActivo !== 'activos' && <input type="hidden" name="activo" value={filtroActivo} />}
    <button type="submit" class="btn btn-sm">Buscar</button>
    {(search || filtroTipo || filtroActivo !== 'activos') && <a href="/proveedores/personas" class="btn btn-sm">✕</a>}
  </form>

  <div class="filters" style="margin-bottom:8px">
    <a href={`/proveedores/personas${search ? '?q='+search : ''}`} class={`filter-chip ${!filtroTipo ? 'active' : ''}`}>Todos</a>
    {[...new Set([...tiposExistentes, ...TIPOS])].filter((t) => t).map((t) => (
      <a href={`/proveedores/personas?tipo=${encodeURIComponent(t)}${search ? '&q='+search : ''}`}
         class={`filter-chip ${filtroTipo === t ? 'active' : ''}`}>{t}</a>
    ))}
  </div>
  <div class="filters" style="margin-bottom:20px">
    {['activos', 'inactivos', 'todos'].map((a) => (
      <a href={`/proveedores/personas?activo=${a}${filtroTipo ? '&tipo='+encodeURIComponent(filtroTipo) : ''}${search ? '&q='+search : ''}`}
         class={`filter-chip ${filtroActivo === a ? 'active' : ''}`}>{a}</a>
    ))}
  </div>

  <p class="text-muted" style="font-size:12px;margin-bottom:8px">{total} proveedor{total !== 1 ? 'es' : ''}</p>

  {total === 0 ? (
    <EmptyState title="Sin proveedores" message="Da de alta el primero arriba. Después podrás filtrarlos por tipo." />
  ) : (
    <div>
      {[...grupos.entries()].map(([tipo, items]) => (
        <div style="margin-bottom:28px">
          <h2 style="margin:0 0 8px;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);border-bottom:1px solid var(--border);padding-bottom:6px">
            {tipo} <small class="text-muted" style="font-size:11px;letter-spacing:0;text-transform:none">{items.length}</small>
          </h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:6px">
            {items.map((p: any) => (
              <a href={`/proveedores/personas/${p.id}`}
                 class="card" style={`display:block;color:inherit;text-decoration:none${!p.activo ? ';opacity:.5' : ''}`}>
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                  <div style="font-weight:600">{p.nombre}{p.empresa && <span class="text-muted" style="font-weight:400;font-size:11px"> · {p.empresa}</span>}</div>
                  {!p.activo && <span class="chip" style="font-size:9px">inactivo</span>}
                </div>
                <div class="card-meta" style="margin-top:4px">
                  {p.instagram && <span class="text-muted" style="font-size:11px">@{p.instagram.replace(/^@/, '')}</span>}
                  {p.whatsapp && <span class="text-muted" style="font-size:11px">{p.whatsapp}</span>}
                  {p.ciudad && <span class="text-muted" style="font-size:11px">{p.ciudad}</span>}
                  {p.tarifa_base && <span class="mono" style="color:var(--gold);font-size:11px">{fmt(p.tarifa_base)}{p.tarifa_unidad ? '/'+p.tarifa_unidad : ''}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
</Layout>
